@using TurismoConecta.web.Client.Services
@page "/municipios/{Id:int}"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject MunicipioApiService ApiService
@inject NegocioApiService NegocioService
@inject SitioTuristicoApiService SitioService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ApiConfig Api
@inject VisibilidadApiService Visibilidad

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="selva-container fm-pagina">
    <!-- PANTALLA DE ESPERA INMERSIVA CON PAISAJE BOYACENSE -->
    @if (cargando)
    {
        <div class="pantalla-espera-inmersiva">
            <img src="@paisajeEspera.Url" alt="Paisaje de Boyacá" class="espera-bg-img" />
            <div class="espera-scrim">
                <div class="espera-contenido">
                    <span class="espera-eyebrow">Boyacá, Colombia</span>
                    <h2 class="espera-lugar">@paisajeEspera.Lugar</h2>
                    <p class="espera-cita">"@paisajeEspera.Frase"</p>

                    <div class="espera-indicador">
                        <div class="spinner-anillo-selva"></div>
                        <span class="espera-texto-progreso">Descubriendo destino...</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ficha is null)
    {
        <div class="selva-error">
            <h2>Destino no encontrado</h2>
            <p>No pudimos cargar la información de este lugar.</p>
            <button class="btn-enlace" @onclick="Volver">@(VieneDeInicio ? "Volver al inicio" : "Regresar al catálogo")</button>
        </div>
    }
    else
    {
        <!-- ═══════════════ BARRA SUPERIOR ═══════════════ -->
        <header class="fm-barra">
            <div class="fm-contenedor fm-barra-interior">
                <nav class="fm-migas" aria-label="Ruta de navegación">
                    <button type="button" class="fm-volver" @onclick="Volver">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i>
                        @(VieneDeInicio ? "Inicio" : "Catálogo de pueblos")
                    </button>
                    <span class="fm-migas-sep" aria-hidden="true">/</span>
                    <span class="fm-migas-actual">@ficha.Nombre</span>
                </nav>

                <div class="fm-barra-acciones">
                    <a class="fm-boton fm-boton--claro" href="@($"/itinerarios/crear?municipios={ficha.IdMunicipio}")">
                        <i class="ph ph-path" aria-hidden="true"></i>
                        <span>Planear viaje aquí</span>
                    </a>

                    <AuthorizeView Roles="@Roles.GeneralOMunicipio">
                        <Authorized>
                            <button type="button" class="fm-boton fm-boton--claro" @onclick='() => Nav.NavigateTo($"/municipios/{Id}/editar")'>
                                <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                                <span>Editar</span>
                            </button>
                            <button type="button" class="fm-boton fm-boton--peligro" @onclick="ConfirmarEliminar" aria-label="Eliminar municipio">
                                <i class="ph ph-trash" aria-hidden="true"></i>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <!-- ═══════════════ PORTADA ═══════════════ -->
        <section class="fm-portada">
            <img src="@Api.ImagenMunicipio(ficha.Nombre, ficha.ImagenUrl)"
                 alt="@ficha.Nombre, Boyacá"
                 class="fm-portada-img"
                 onerror="this.onerror=null; this.src='@ApiConfig.ImagenPorDefecto';" />
            <div class="fm-portada-velo"></div>

            <div class="fm-contenedor fm-portada-texto">
                <span class="fm-portada-eyebrow"><i class="ph-fill ph-map-pin" aria-hidden="true"></i> Boyacá · Colombia</span>
                <div class="fm-portada-titulo-fila">
                    <h1 class="fm-portada-titulo">@ficha.Nombre</h1>
                    <div class="fm-portada-favorito"><BotonFavorito IdMunicipio="ficha.IdMunicipio" /></div>
                </div>

                @if (ficha.Etiquetas is { Count: > 0 })
                {
                    <ul class="fm-etiquetas" aria-label="Lo que ofrece">
                        @foreach (var tag in ficha.Etiquetas)
                        {
                            <li>@tag</li>
                        }
                    </ul>
                }
            </div>
        </section>

        <!-- ═══════════════ DATOS RÁPIDOS (también sirven de atajos) ═══════════════ -->
        <div class="fm-contenedor">
            <div class="fm-datos">
                <div class="fm-dato">
                    <i class="ph ph-thermometer-simple" aria-hidden="true"></i>
                    <div>
                        <strong>@(string.IsNullOrWhiteSpace(ficha.Clima) ? "—" : FormatearClimaDiscreto(ficha.Clima))</strong>
                        <span>Clima promedio</span>
                    </div>
                </div>
                <a class="fm-dato" href="@Ancla("que-ver")" @onclick="@(() => IrASeccion("que-ver"))" @onclick:preventDefault>
                    <i class="ph ph-binoculars" aria-hidden="true"></i>
                    <div>
                        <strong>@(cargandoSitios ? "…" : sitiosMunicipio.Count.ToString())</strong>
                        <span>Lugares imperdibles</span>
                    </div>
                </a>
                <a class="fm-dato" href="@Ancla("cuando-ir")" @onclick="@(() => IrASeccion("cuando-ir"))" @onclick:preventDefault>
                    <i class="ph ph-calendar-star" aria-hidden="true"></i>
                    <div>
                        @if (ProximaCelebracion is { } proxima)
                        {
                            <strong>@proxima.Proxima.ToString("d MMM", Es)</strong>
                            <span>Próxima: @proxima.Fecha.NombreFestividad</span>
                        }
                        else
                        {
                            <strong>@ficha.FechasRelevantes.Count</strong>
                            <span>Celebraciones</span>
                        }
                    </div>
                </a>
                <a class="fm-dato" href="@Ancla("donde-comer")" @onclick="@(() => IrASeccion("donde-comer"))" @onclick:preventDefault>
                    <i class="ph ph-storefront" aria-hidden="true"></i>
                    <div>
                        <strong>@(cargandoNegocios ? "…" : (negociosLocales?.Count ?? 0).ToString())</strong>
                        <span>Comercios verificados</span>
                    </div>
                </a>
            </div>
        </div>

        <!-- ═══════════════ NAVEGACIÓN POR SECCIONES (fija al bajar) ═══════════════ -->
        <nav class="fm-indice" aria-label="Secciones de la ficha">
            <div class="fm-contenedor fm-indice-interior">
                <a href="@Ancla("que-ver")" @onclick="@(() => IrASeccion("que-ver"))" @onclick:preventDefault><i class="ph ph-binoculars" aria-hidden="true"></i> Qué ver</a>
                <a href="@Ancla("cuando-ir")" @onclick="@(() => IrASeccion("cuando-ir"))" @onclick:preventDefault><i class="ph ph-calendar-star" aria-hidden="true"></i> Cuándo ir</a>
                <a href="@Ancla("donde-comer")" @onclick="@(() => IrASeccion("donde-comer"))" @onclick:preventDefault><i class="ph ph-fork-knife" aria-hidden="true"></i> Dónde comer y dormir</a>
                <a href="@Ancla("opiniones")" @onclick="@(() => IrASeccion("opiniones"))" @onclick:preventDefault><i class="ph ph-chats-circle" aria-hidden="true"></i> Opiniones</a>
                <a href="@Ancla("como-llegar")" @onclick="@(() => IrASeccion("como-llegar"))" @onclick:preventDefault><i class="ph ph-navigation-arrow" aria-hidden="true"></i> Cómo llegar</a>
                @if (!string.IsNullOrWhiteSpace(ficha.Historia))
                {
                    <a href="@Ancla("historia")" @onclick="@(() => IrASeccion("historia"))" @onclick:preventDefault><i class="ph ph-scroll" aria-hidden="true"></i> Historia</a>
                }
            </div>
        </nav>

        <main class="fm-cuerpo">

            <!-- ═══════════════ INTRODUCCIÓN + AVISOS ═══════════════ -->
            <section class="fm-intro">
                <div class="fm-contenedor fm-contenedor--angosto">
                    <AvisosMunicipio IdMunicipio="ficha.IdMunicipio" />
                    @if (!string.IsNullOrWhiteSpace(ficha.Descripcion))
                    {
                        <p class="fm-intro-texto">@ficha.Descripcion</p>
                    }
                </div>
            </section>

            <!-- ═══════════════ 1. QUÉ VER (lugares imperdibles) ═══════════════ -->
            <section class="fm-seccion fm-seccion--ver" id="que-ver">
                <div class="fm-contenedor">
                    <header class="fm-cabecera">
                        <span class="fm-cabecera-icono"><i class="ph ph-binoculars" aria-hidden="true"></i></span>
                        <div>
                            <span class="fm-cabecera-eyebrow">Qué ver</span>
                            <h2>Lugares imperdibles</h2>
                            <p>Los sitios que no te puedes perder en @ficha.Nombre.</p>
                        </div>
                    </header>

                    @if (cargandoSitios)
                    {
                        <div class="fm-cargando"><span class="fm-spinner"></span> Buscando los lugares imperdibles…</div>
                    }
                    else if (sitiosMunicipio.Count > 0)
                    {
                        <div class="fm-sitios @ClaseCantidad(sitiosMunicipio.Count)">
                            @foreach (var sitio in sitiosMunicipio)
                            {
                                <article class="fm-sitio @(sitio.Destacado ? "destacado" : "")" @key="sitio.IdSitioTuristico">
                                    <div class="fm-sitio-foto">
                                        <img src="@ImagenSitio(sitio.ImagenUrl)" alt="" loading="lazy"
                                             onerror="this.onerror=null; this.src='@ApiConfig.ImagenPorDefecto';" />
                                        @if (sitio.Destacado)
                                        {
                                            <span class="fm-sello"><i class="ph-fill ph-star" aria-hidden="true"></i> Destacado</span>
                                        }
                                    </div>
                                    <div class="fm-sitio-cuerpo">
                                        <div class="fm-sitio-meta">
                                            @if (!string.IsNullOrWhiteSpace(sitio.NombreCategoria))
                                            {
                                                <span><i class="@(sitio.IconoCategoria ?? "ph ph-tag")" aria-hidden="true"></i> @sitio.NombreCategoria</span>
                                            }
                                            @if (sitio.Altitud.HasValue)
                                            {
                                                <span><i class="ph ph-mountains" aria-hidden="true"></i> @sitio.Altitud.Value.ToString("N0", Es) m s. n. m.</span>
                                            }
                                        </div>
                                        <h3>@sitio.Nombre</h3>
                                        @if (!string.IsNullOrWhiteSpace(sitio.Descripcion))
                                        {
                                            <p>@sitio.Descripcion</p>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="fm-vacio"><i class="ph ph-binoculars" aria-hidden="true"></i> Aún no hay lugares turísticos registrados para @ficha.Nombre.</div>
                    }
                </div>
            </section>

            <!-- ═══════════════ 2. CUÁNDO IR (celebraciones en línea de tiempo) ═══════════════ -->
            <section class="fm-seccion fm-seccion--cuando" id="cuando-ir">
                <div class="fm-contenedor">
                    <header class="fm-cabecera">
                        <span class="fm-cabecera-icono"><i class="ph ph-calendar-star" aria-hidden="true"></i></span>
                        <div>
                            <span class="fm-cabecera-eyebrow">Cuándo ir</span>
                            <h2>Celebraciones y tradición</h2>
                            <p>Ferias, fiestas y festivales, ordenados por la próxima fecha.</p>
                        </div>
                    </header>

                    @if (Celebraciones.Count > 0)
                    {
                        <ol class="fm-agenda">
                            @foreach (var c in Celebraciones)
                            {
                                var f = c.Fecha;
                                var esProxima = c == ProximaCelebracion;   // record: compara por valor
                                <li class="fm-evento @(esProxima ? "proxima" : "")">
                                    <div class="fm-evento-fecha" aria-hidden="true">
                                        @if (c.Proxima == default)
                                        {
                                            <i class="ph ph-confetti"></i>
                                        }
                                        else
                                        {
                                            <span class="dia">@c.Proxima.Day</span>
                                            <span class="mes">@c.Proxima.ToString("MMM", Es).TrimEnd('.')</span>
                                        }
                                    </div>
                                    <div class="fm-evento-cuerpo">
                                        <div class="fm-evento-titulo">
                                            <h3>@f.NombreFestividad</h3>
                                            @if (!string.IsNullOrWhiteSpace(f.TipoFestividad))
                                            {
                                                <span class="fm-tipo fm-tipo--@ObtenerClaseBadge(f.TipoFestividad)">@f.TipoFestividad</span>
                                            }
                                        </div>
                                        <p class="fm-evento-cuando">
                                            <i class="ph ph-calendar-blank" aria-hidden="true"></i>
                                            @TextoFechas(c)
                                            @if (esProxima)
                                            {
                                                <span class="fm-falta">@TextoFalta(c.Proxima)</span>
                                            }
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(f.Descripcion))
                                        {
                                            <p class="fm-evento-desc">@f.Descripcion</p>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="fm-vacio"><i class="ph ph-calendar-blank" aria-hidden="true"></i> No hay celebraciones registradas para este municipio por ahora.</div>
                    }
                </div>
            </section>

            <!-- ═══════════════ 3. DÓNDE COMER Y DORMIR ═══════════════ -->
            <section class="fm-seccion fm-seccion--comer" id="donde-comer">
                <div class="fm-contenedor">
                    <header class="fm-cabecera fm-cabecera--con-extra">
                        <span class="fm-cabecera-icono"><i class="ph ph-fork-knife" aria-hidden="true"></i></span>
                        <div>
                            <span class="fm-cabecera-eyebrow">Dónde comer y dormir</span>
                            <h2>Establecimientos y experiencias</h2>
                            <p>Comercios locales aprobados por la alcaldía.</p>
                        </div>
                        <span class="fm-contador">@NegociosFiltrados.Count lugar@(NegociosFiltrados.Count != 1 ? "es" : "")</span>
                    </header>

                    <div class="fm-filtros" role="group" aria-label="Filtrar por categoría">
                        <button type="button" class="@(categoriaSeleccionada == 0 ? "activo" : "")" aria-pressed="@(categoriaSeleccionada == 0)"
                                @onclick="() => SeleccionarCategoria(0)">
                            <i class="ph ph-squares-four" aria-hidden="true"></i> Todos
                        </button>
                        @foreach (var cat in categoriasNegocio)
                        {
                            var idCat = cat.IdCategoria;
                            <button type="button" class="@(categoriaSeleccionada == idCat ? "activo" : "")" aria-pressed="@(categoriaSeleccionada == idCat)"
                                    @onclick="() => SeleccionarCategoria(idCat)">
                                <i class="@(string.IsNullOrWhiteSpace(cat.Icono) ? "ph ph-storefront" : cat.Icono)" aria-hidden="true"></i> @cat.Nombre
                            </button>
                        }
                    </div>

                    @if (cargandoNegocios)
                    {
                        <div class="fm-cargando"><span class="fm-spinner"></span> Consultando establecimientos en @ficha.Nombre…</div>
                    }
                    else if (NegociosFiltrados.Any())
                    {
                        <div class="fm-negocios @ClaseCantidad(NegociosFiltrados.Count)">
                            @foreach (var negocio in NegociosFiltrados)
                            {
                                var n = negocio;
                                <button type="button" class="fm-negocio" @onclick="() => AbrirModalNegocio(n)">
                                    <div class="fm-negocio-foto">
                                        <img src="@ObtenerFotoNegocio(n)" alt="" loading="lazy"
                                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800&auto=format&fit=crop';" />
                                    </div>
                                    <div class="fm-negocio-cuerpo">
                                        <div class="fm-negocio-meta">
                                            <span class="fm-negocio-cat">@n.NombreCategoria</span>
                                            @if (n.PromedioCalificacion is > 0)
                                            {
                                                <span class="fm-negocio-estrellas"><i class="ph-fill ph-star" aria-hidden="true"></i> @n.PromedioCalificacion.Value.ToString("0.0", Es)</span>
                                            }
                                        </div>
                                        <h3>@n.Nombre</h3>
                                        <p class="fm-negocio-dir">
                                            <i class="ph ph-map-pin" aria-hidden="true"></i>
                                            @(string.IsNullOrWhiteSpace(n.Direccion) ? "Centro de " + ficha.Nombre : n.Direccion)
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(n.Descripcion))
                                        {
                                            <p class="fm-negocio-desc">@TruncarTexto(n.Descripcion, 110)</p>
                                        }
                                        <span class="fm-negocio-ver">Ver detalles, fotos y contacto <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="fm-vacio"><i class="ph ph-storefront" aria-hidden="true"></i> No hay comercios registrados en esta categoría para @ficha.Nombre por ahora.</div>
                    }
                </div>
            </section>

            <!-- ═══════════════ 4. OPINIONES ═══════════════ -->
            <section class="fm-seccion fm-seccion--opiniones" id="opiniones">
                <div class="fm-contenedor fm-contenedor--angosto">
                    <header class="fm-cabecera">
                        <span class="fm-cabecera-icono"><i class="ph ph-chats-circle" aria-hidden="true"></i></span>
                        <div>
                            <span class="fm-cabecera-eyebrow">Qué dicen los viajeros</span>
                            <h2>Opiniones</h2>
                            <p>Experiencias reales de quienes ya visitaron @ficha.Nombre.</p>
                        </div>
                    </header>
                    <div class="fm-tarjeta">
                        <ListaResenas IdMunicipio="ficha.IdMunicipio" NombreLugar="@ficha.Nombre" />
                    </div>
                </div>
            </section>

            <!-- ═══════════════ 5. CÓMO LLEGAR ═══════════════ -->
            <section class="fm-seccion fm-seccion--llegar" id="como-llegar">
                <div class="fm-contenedor">
                    <header class="fm-cabecera">
                        <span class="fm-cabecera-icono"><i class="ph ph-navigation-arrow" aria-hidden="true"></i></span>
                        <div>
                            <span class="fm-cabecera-eyebrow">Cómo llegar</span>
                            <h2>Ubicación</h2>
                            <p>Abre la ruta en tu aplicación favorita o arma un itinerario.</p>
                        </div>
                    </header>

                    <div class="fm-llegar">
                        <div class="fm-mapa">
                            <iframe src="@ObtenerUrlIframeMaps(ficha.Nombre, ficha.Latitud, ficha.Longitud)"
                                    title="Mapa de @ficha.Nombre"
                                    loading="lazy"
                                    allowfullscreen
                                    referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                        <aside class="fm-llegar-panel">
                            <h3>@ficha.Nombre, Boyacá</h3>
                            @if (TieneCoordenadas)
                            {
                                <p class="fm-coordenadas">
                                    <i class="ph ph-crosshair" aria-hidden="true"></i>
                                    @ficha.Latitud!.Value.ToString("0.0000", Inv), @ficha.Longitud!.Value.ToString("0.0000", Inv)
                                </p>
                            }
                            <a class="fm-boton fm-boton--lleno" href="@ObtenerUrlGoogleMaps(ficha.Nombre, ficha.Latitud, ficha.Longitud)" target="_blank" rel="noopener noreferrer">
                                <i class="ph ph-map-trifold" aria-hidden="true"></i> Abrir en Google Maps
                            </a>
                            @if (TieneCoordenadas)
                            {
                                <a class="fm-boton fm-boton--claro" href="@UrlWaze" target="_blank" rel="noopener noreferrer">
                                    <i class="ph ph-car" aria-hidden="true"></i> Abrir en Waze
                                </a>
                            }
                            <a class="fm-boton fm-boton--claro" href="@($"/itinerarios/crear?municipios={ficha.IdMunicipio}")">
                                <i class="ph ph-path" aria-hidden="true"></i> Armar un itinerario
                            </a>
                        </aside>
                    </div>
                </div>
            </section>

            <!-- ═══════════════ 6. HISTORIA ═══════════════ -->
            @if (!string.IsNullOrWhiteSpace(ficha.Historia))
            {
                <section class="fm-seccion fm-seccion--historia" id="historia">
                    <div class="fm-contenedor fm-historia">
                        <header class="fm-cabecera">
                            <span class="fm-cabecera-icono"><i class="ph ph-scroll" aria-hidden="true"></i></span>
                            <div>
                                <span class="fm-cabecera-eyebrow">Su historia</span>
                                <h2>Historia y memoria</h2>
                            </div>
                        </header>
                        <p class="fm-historia-texto">@ficha.Historia</p>
                    </div>
                </section>
            }

            <!-- ═══════════════ SI TE GUSTÓ… ═══════════════ -->
            <section class="fm-seccion fm-seccion--similares">
                <div class="fm-contenedor">
                    <header class="fm-cabecera">
                        <span class="fm-cabecera-icono"><i class="ph ph-compass" aria-hidden="true"></i></span>
                        <div>
                            <span class="fm-cabecera-eyebrow">Sigue explorando</span>
                            <h2>Si te gustó @ficha.Nombre…</h2>
                        </div>
                    </header>
                    <MunicipiosSimilares IdMunicipio="ficha.IdMunicipio" Desde="@Desde" />
                </div>
            </section>
        </main>

        <footer class="fm-pie">
            <p>TurismoConecta · Guía de destinos de Boyacá</p>
        </footer>

        <!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN DE MUNICIPIO -->
        @if (mostrarConfirmacion)
        {
            <div class="selva-modal-backdrop">
                <div class="selva-modal-window">
                    <h3>Confirmar eliminación</h3>
                    <p>¿Deseas remover a <strong>@ficha.Nombre</strong> del catálogo?</p>
                    <div class="selva-modal-actions">
                        <button class="btn-modal-cancel" @onclick="() => mostrarConfirmacion = false">Cancelar</button>
                        <button class="btn-modal-delete" @onclick="Eliminar">Remover</button>
                    </div>
                </div>
            </div>
        }

        <!-- MODAL INMERSIVO DE DETALLE DEL ESTABLECIMIENTO -->
        @if (negocioModal != null)
        {
            <div class="modal-backdrop-negocio" @onclick="CerrarModalNegocio">
                <div class="modal-card-negocio" @onclick:stopPropagation="true">

                    @* ◆ ICONO: cerrar (antes ✕) *@
                    <button type="button" class="modal-btn-cerrar-negocio" @onclick="CerrarModalNegocio" title="Cerrar" aria-label="Cerrar">
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>

                    <!-- GALERÍA / CARRUSEL DE FOTOS -->
                    <div class="modal-negocio-galeria">
                        @{
                            var fotosGaleria = ObtenerGaleriaCompleta(negocioModal);
                        }
                        <div class="modal-foto-principal-wrap">
                            <img src="@fotosGaleria[imagenModalActiva]"
                                 alt="@negocioModal.Nombre"
                                 class="modal-foto-principal"
                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=1200&auto=format&fit=crop';" />
                            <div class="modal-foto-scrim">
                                <div class="modal-negocio-fav">
                                    <BotonFavorito IdNegocio="negocioModal.IdNegocio" />
                                </div>
                                <span class="modal-negocio-cat-tag">@negocioModal.NombreCategoria</span>
                                <h2 class="modal-negocio-titulo">@negocioModal.Nombre</h2>
                            </div>
                        </div>

                        @if (fotosGaleria.Count > 1)
                        {
                            <div class="modal-tira-miniaturas">
                                @for (int i = 0; i < fotosGaleria.Count; i++)
                                {
                                    var idx = i;
                                    <img src="@fotosGaleria[idx]"
                                         alt="Miniatura @(idx + 1)"
                                         class="miniatura-item @(imagenModalActiva == idx ? "activa" : "")"
                                         @onclick="() => imagenModalActiva = idx" />
                                }
                            </div>
                        }
                    </div>

                    <!-- CUERPO DE DETALLES -->
                    <div class="modal-negocio-cuerpo">

                        <!-- AVISOS DEL ESTABLECIMIENTO (cierres, cambios de horario) -->
                        <AvisosMunicipio IdMunicipio="ficha.IdMunicipio" IdNegocio="negocioModal.IdNegocio" Compacta="true" />

                        @if (!string.IsNullOrWhiteSpace(negocioModal.Descripcion))
                        {
                            <div class="modal-negocio-seccion">
                                <span class="modal-subtitulo-label">Sobre este establecimiento</span>
                                <p class="modal-texto-desc">@negocioModal.Descripcion</p>
                            </div>
                        }

                        <!-- METADATOS: HORARIOS Y UBICACIÓN -->
                        @* ◆ ICONOS: 📍 🕒 📞 → Phosphor *@
                        <div class="modal-datos-grid">
                            <div class="modal-dato-card">
                                <span class="dato-icono" aria-hidden="true"><i class="ph-fill ph-map-pin"></i></span>
                                <div>
                                    <strong>Dirección</strong>
                                    <p>@(string.IsNullOrWhiteSpace(negocioModal.Direccion) ? "Centro de " + ficha.Nombre : negocioModal.Direccion)</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(negocioModal.Horario))
                            {
                                <div class="modal-dato-card">
                                    <span class="dato-icono" aria-hidden="true"><i class="ph ph-clock"></i></span>
                                    <div>
                                        <strong>Horario de atención</strong>
                                        <p>@negocioModal.Horario</p>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(negocioModal.Telefono))
                            {
                                <div class="modal-dato-card">
                                    <span class="dato-icono" aria-hidden="true"><i class="ph ph-phone"></i></span>
                                    <div>
                                        <strong>Teléfono / Móvil</strong>
                                        <p>@negocioModal.Telefono</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- INTEGRACIÓN EXCLUSIVA DE HOTELERÍA: BOOKING Y VINCULACIÓN -->
                        @* ◆ CAMBIO: antes "IdCategoria == 1", que en tu BD es Gastronomía *@
                        @if (EsHospedaje(negocioModal))
                        {
                            <div class="caja-booking-integracion">
                                <div class="booking-header">
                                    <span class="booking-logo-text">Booking<span>.com</span></span>
                                    <span class="booking-badge-disponibilidad">Verificación Online</span>
                                </div>
                                <p class="booking-desc">
                                    Consulta tarifas y disponibilidad garantizada para este hospedaje en Boyacá.
                                </p>
                                <div class="booking-acciones-row">
                                    <a href="@ObtenerUrlBooking(negocioModal, ficha.Nombre)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-booking-oficial">
                                        Reservar en Booking.com <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                                    </a>

                                    <button type="button"
                                            class="btn-vincular-itinerario @(hospedajeGuardado ? "guardado" : "")"
                                            @onclick="GuardarHospedajeEnItinerario">
                                        @if (hospedajeGuardado)
                                        {
                                            <i class="ph ph-check" aria-hidden="true"></i>
                                            <span>Hospedaje vinculado a tu ruta</span>
                                        }
                                        else
                                        {
                                            <i class="ph ph-push-pin" aria-hidden="true"></i>
                                            <span>Agregar a mi itinerario</span>
                                        }
                                    </button>
                                </div>
                                @if (hospedajeGuardado)
                                {
                                    <div class="alerta-itinerario-exito">
                                        <i class="ph-fill ph-sparkle" aria-hidden="true"></i>
                                        Guardamos este hotel en tus notas de viaje para planificar tu itinerario por @ficha.Nombre.
                                    </div>
                                }
                            </div>
                        }

                        <!-- OPINIONES DEL ESTABLECIMIENTO (HU-28 / HU-29) -->
                        <div class="modal-negocio-seccion">
                            <span class="modal-subtitulo-label">Opiniones de visitantes</span>
                            <ListaResenas IdNegocio="negocioModal.IdNegocio" NombreLugar="@negocioModal.Nombre" Compacta="true" />
                        </div>

                        <!-- BOTONES DE ACCIÓN RÁPIDA: WHATSAPP Y LLAMADA -->
                        @* ◆ ICONOS: 💬 📞 🗺️ → Phosphor *@
                        <div class="modal-botones-contacto">
                            @if (!string.IsNullOrWhiteSpace(negocioModal.WhatsApp))
                            {
                                <a href="@ObtenerUrlWhatsApp(negocioModal, ficha.Nombre)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn-contacto-ws"
                                   @onclick="() => RegistrarClic(TiposEventoVisibilidad.ClicWhatsApp)">
                                    <i class="ph ph-whatsapp-logo" aria-hidden="true"></i> Contactar por WhatsApp
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(negocioModal.Telefono))
                            {
                                <a href="tel:@negocioModal.Telefono" class="btn-contacto-tel"
                                   @onclick="() => RegistrarClic(TiposEventoVisibilidad.ClicTelefono)">
                                    <i class="ph ph-phone" aria-hidden="true"></i> Llamar directamente
                                </a>
                            }

                            <a href="@ObtenerUrlGoogleMapsNegocio(negocioModal, ficha.Nombre)"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-contacto-mapa"
                               @onclick="() => RegistrarClic(TiposEventoVisibilidad.ClicComoLlegar)">
                                <i class="ph ph-map-trifold" aria-hidden="true"></i> Ver en Google Maps
