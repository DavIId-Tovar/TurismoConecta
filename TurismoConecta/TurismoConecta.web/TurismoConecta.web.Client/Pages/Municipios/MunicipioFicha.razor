@using TurismoConecta.web.Client.Services
@page "/municipios/{Id:int}"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject MunicipioApiService ApiService
@inject NegocioApiService NegocioService
@inject SitioTuristicoApiService SitioService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ApiConfig Api

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="selva-container">
    <!-- PANTALLA DE ESPERA INMERSIVA CON PAISAJE BOYACENSE -->
    @if (cargando)
    {
        <div class="pantalla-espera-inmersiva">
            <img src="@paisajeEspera.Url" alt="Paisaje de Boyacá" class="espera-bg-img" />
            <div class="espera-scrim">
                <div class="espera-contenido">
                    <span class="espera-eyebrow">Boyacá, Colombia</span>
                    <h2 class="espera-lugar">@paisajeEspera.Lugar</h2>
                    <p class="espera-cita">"@paisajeEspera.Frase"</p>

                    <div class="espera-indicador">
                        <div class="spinner-anillo-selva"></div>
                        <span class="espera-texto-progreso">Descubriendo destino...</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ficha is null)
    {
        <div class="selva-error">
            <h2>Destino no encontrado</h2>
            <p>No pudimos cargar la información de este lugar.</p>
            <button class="btn-enlace" @onclick="Volver">@(VieneDeInicio ? "Volver al inicio" : "Regresar al catálogo")</button>
        </div>
    }
    else
    {
        <!-- BARRA DE NAVEGACIÓN DISCRETA -->
        <header class="selva-nav">
            <nav class="nav-migas" aria-label="Ruta de navegación">
                @* ◆ ICONO: flecha de volver (antes ←) *@
                <button class="nav-back-link" @onclick="Volver">
                    <i class="ph ph-arrow-left nav-back-arrow" aria-hidden="true"></i>
                    @(VieneDeInicio ? "Inicio" : "Catálogo de Pueblos")
                </button>

                <span class="nav-migas-separador" aria-hidden="true">·</span>

                @if (VieneDeInicio)
                {
                    <a href="/municipios" class="nav-migas-enlace">
                        <i class="ph ph-map-trifold" aria-hidden="true"></i> Catálogo de Pueblos
                    </a>
                }
                else
                {
                    <a href="/" class="nav-migas-enlace">
                        <i class="ph ph-house" aria-hidden="true"></i> Inicio
                    </a>
                }
            </nav>

            <div class="nav-actions">
                @* ◆ ICONO: guardar en itinerario (antes ✓ y +) *@
                <button class="btn-itinerario-minimal @(enItinerario ? "guardado" : "")" @onclick="ToggleItinerario">
                    @if (enItinerario)
                    {
                        <i class="ph ph-check" aria-hidden="true"></i>
                        <span>En tu itinerario</span>
                    }
                    else
                    {
                        <i class="ph ph-plus" aria-hidden="true"></i>
                        <span>Guardar en itinerario</span>
                    }
                </button>

                <AuthorizeView Roles="@Roles.GeneralOMunicipio">
                    <Authorized>
                        @* ◆ ICONO: editar / eliminar *@
                        <button class="btn-admin-minimal" @onclick='() => Nav.NavigateTo($"/municipios/{Id}/editar")'>
                            <i class="ph ph-pencil-simple" aria-hidden="true"></i> Editar
                        </button>
                        <button class="btn-admin-minimal btn-danger-subtle" @onclick="ConfirmarEliminar">
                            <i class="ph ph-trash" aria-hidden="true"></i> Eliminar
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- HERO EDITORIAL CON FOTOGRAFÍA CURADA -->
        <section class="selva-hero">
            <div class="hero-imagen-wrapper">
                
                <img src="@Api.ImagenMunicipio(ficha.Nombre, ficha.ImagenUrl)"
                     alt="@ficha.Nombre, Boyacá"
                     class="hero-imagen"
                     onerror="this.onerror=null; this.src='@ApiConfig.ImagenPorDefecto';" />
                <div class="hero-sombra-suave"></div>
            </div>

            <div class="hero-contenido-centrado">
                <span class="hero-categoria-badge">Boyacá Profunda</span>
                <h1 class="hero-titulo">@ficha.Nombre</h1>
                <div class="hero-acciones">
                    <BotonFavorito IdMunicipio="ficha.IdMunicipio" />
                </div>

                <!-- METADATOS DISCRETOS: CLIMA Y UBICACIÓN -->
                <div class="hero-meta-discreta">
                    @if (!string.IsNullOrWhiteSpace(ficha.Clima))
                    {
                        @* ◆ ICONO: clima (antes ⛅) *@
                        <span class="meta-item-clima">
                            <span class="icono-clima" aria-hidden="true"><i class="ph ph-cloud-sun"></i></span>
                            @FormatearClimaDiscreto(ficha.Clima)
                        </span>
                        <span class="meta-separador">•</span>
                    }
                    <span class="meta-item-pais">Colombia</span>
                </div>

                @if (ficha.Etiquetas != null && ficha.Etiquetas.Any())
                {
                    <div class="hero-etiquetas-pills">
                        @foreach (var tag in ficha.Etiquetas)
                        {
                            @* ◆ ICONO: etiqueta (antes ✦) *@
                            <span class="pill-experiencia">
                                <span class="pill-icono" aria-hidden="true"><i class="ph-fill ph-sparkle"></i></span>
                                @tag
                            </span>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- CUERPO PRINCIPAL DEL ARTÍCULO -->
        <main class="selva-articulo">
            <!-- SECCIÓN 1: INTRODUCCIÓN EDITORIAL -->
            @if (!string.IsNullOrWhiteSpace(ficha.Descripcion))
            {
                <section class="bloque-introduccion">
                    <p class="parrafo-destacado">@ficha.Descripcion</p>
                </section>

                <div class="divisor-seccion"></div>
            }

            <!-- SECCIÓN 2: LUGARES IMPERDIBLES (desde la BD) -->
            @* ◆ CAMBIO: antes era una lista escrita a mano (ObtenerAtractivosPorDefecto) *@
            <section class="bloque-contenido">
                <div class="bloque-cabecera">
                    <span class="bloque-indice">02</span>
                    <h2 class="bloque-titulo">Lugares Imperdibles</h2>
                </div>

                @if (cargandoSitios)
                {
                    <div class="negocios-loading">
                        <div class="spinner-mini-selva"></div>
                        <p class="nota-ligera">Buscando los lugares imperdibles de @ficha.Nombre...</p>
                    </div>
                }
                else if (sitiosMunicipio.Count > 0)
                {
                    <div class="sitios-ficha-grid">
                        @foreach (var sitio in sitiosMunicipio)
                        {
                            <article class="sitio-ficha-card" @key="sitio.IdSitioTuristico">
                                <div class="sitio-ficha-imagen">
                                    <img src="@ImagenSitio(sitio.ImagenUrl)" alt="@sitio.Nombre" loading="lazy" />
                                    @if (!string.IsNullOrWhiteSpace(sitio.NombreCategoria))
                                    {
                                        <span class="sitio-ficha-categoria">
                                            <i class="@(sitio.IconoCategoria ?? "ph ph-tag")" aria-hidden="true"></i>
                                            @sitio.NombreCategoria
                                        </span>
                                    }
                                </div>
                                <div class="sitio-ficha-cuerpo">
                                    <h3>@sitio.Nombre</h3>
                                    @if (sitio.Altitud.HasValue)
                                    {
                                        <p class="sitio-ficha-dato">
                                            <i class="ph ph-mountains" aria-hidden="true"></i>
                                            @sitio.Altitud.Value.ToString("N0") msnm
                                        </p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(sitio.Descripcion))
                                    {
                                        <p class="sitio-ficha-desc">@sitio.Descripcion</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="estado-vacio-limpio">
                        <p>Aún no hay lugares turísticos registrados para @ficha.Nombre.</p>
                    </div>
                }
            </section>

            <div class="divisor-seccion"></div>

            <!-- SECCIÓN 3: FESTIVIDADES Y TRADICIONES -->
            <section class="bloque-contenido">
                <div class="bloque-cabecera">
                    <span class="bloque-indice">03</span>
                    <h2 class="bloque-titulo">Celebraciones y Tradición</h2>
                </div>

                @if (ficha.FechasRelevantes != null && ficha.FechasRelevantes.Any())
                {
                    <div class="festividades-rotacion-grid">
                        @foreach (var fest in ficha.FechasRelevantes)
                        {
                            <article class="fest-card-rotacion fest-categoria-@ObtenerClaseBadge(fest.TipoFestividad ?? "")">
                                <div class="fest-card-header">
                                    <h3 class="fest-titulo">@fest.NombreFestividad</h3>
                                    @if (!string.IsNullOrWhiteSpace(fest.TipoFestividad))
                                    {
                                        <span class="fest-pill-categoria @ObtenerClaseBadge(fest.TipoFestividad)">
                                            @fest.TipoFestividad
                                        </span>
                                    }
                                </div>

                                <div class="fest-fecha-row">
                                    @* ◆ ICONO: calendario (antes 📅) *@
                                    <span class="fest-fecha-icono" aria-hidden="true"><i class="ph ph-calendar-blank"></i></span>
                                    <span class="fest-fecha-texto">
                                        @if (fest.FechaInicio != default && fest.FechaFin != default && fest.FechaInicio != fest.FechaFin)
                                        {
                                            @($"{fest.FechaInicio:dd MMM} al {fest.FechaFin:dd MMM yyyy}")
                                        }
                                        else if (fest.FechaInicio != default)
                                        {
                                            @($"{fest.FechaInicio:dd MMMM yyyy}")
                                        }
                                        else
                                        {
                                            @("Celebración tradicional")
                                        }
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(fest.Descripcion))
                                {
                                    <p class="fest-descripcion">@fest.Descripcion</p>
                                }
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="estado-vacio-limpio">
                        <p>No hay festividades registradas para este municipio actualmente.</p>
                    </div>
                }
            </section>

            <div class="divisor-seccion"></div>

            <!-- SECCIÓN 4: COMER, BEBER, HOSPEDAJE Y EXPERIENCIAS -->
            <section class="bloque-contenido">
                <div class="bloque-cabecera-flex">
                    <div class="bloque-titulo-agrupado">
                        <span class="bloque-indice">04</span>
                        <h2 class="bloque-titulo">Establecimientos y Experiencias</h2>
                    </div>
                    <span class="contador-establecimientos">
                        @(NegociosFiltrados.Count) lugar@(NegociosFiltrados.Count != 1 ? "es" : "")
                    </span>
                </div>

                @* ◆ CAMBIO: categorías desde la BD (antes ids 1-4 escritos a mano y equivocados) *@
                <div class="pildoras-categorias-row">
                    <button type="button"
                            class="btn-pildora-silueta @(categoriaSeleccionada == 0 ? "activa" : "")"
                            @onclick="() => SeleccionarCategoria(0)">
                        <i class="ph ph-compass silueta-icono" aria-hidden="true"></i>
                        <span>Todos</span>
                    </button>

                    @foreach (var cat in categoriasNegocio)
                    {
                        var idCat = cat.IdCategoria;
                        <button type="button"
                                class="btn-pildora-silueta @(categoriaSeleccionada == idCat ? "activa" : "")"
                                @onclick="() => SeleccionarCategoria(idCat)">
                            <i class="@(string.IsNullOrWhiteSpace(cat.Icono) ? "ph ph-storefront" : cat.Icono) silueta-icono" aria-hidden="true"></i>
                            <span>@cat.Nombre</span>
                        </button>
                    }
                </div>

                @if (cargandoNegocios)
                {
                    <div class="negocios-loading">
                        <div class="spinner-mini-selva"></div>
                        <p class="nota-ligera">Consultando establecimientos recomendados en @ficha.Nombre...</p>
                    </div>
                }
                else if (NegociosFiltrados.Any())
                {
                    <div class="negocios-grid-editorial">
                        @foreach (var negocio in NegociosFiltrados)
                        {
                            var n = negocio;
                            <article class="negocio-card-editorial" @onclick="() => AbrirModalNegocio(n)">
                                <div class="negocio-portada-wrap">
                                    <img src="@ObtenerFotoNegocio(n)"
                                         alt="@n.Nombre"
                                         class="negocio-portada-img"
                                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800&auto=format&fit=crop';" />
                                    <span class="negocio-badge-cat">@n.NombreCategoria</span>
                                </div>
                                <div class="negocio-cuerpo-card">
                                    <div class="negocio-header-row">
                                        <h4 class="negocio-nombre">@n.Nombre</h4>
                                        @if (n.PromedioCalificacion.HasValue && n.PromedioCalificacion.Value > 0)
                                        {
                                            @* ◆ ICONO: estrella (antes ★) *@
                                            <span class="negocio-estrellas">
                                                <i class="ph-fill ph-star" aria-hidden="true"></i> @n.PromedioCalificacion.Value.ToString("0.0")
                                            </span>
                                        }
                                    </div>
                                    @* ◆ ICONO: ubicación (antes 📍) *@
                                    <p class="negocio-direccion">
                                        <i class="ph-fill ph-map-pin" aria-hidden="true"></i>
                                        @(string.IsNullOrWhiteSpace(n.Direccion) ? "Centro histórico, " + ficha.Nombre : n.Direccion)
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(n.Descripcion))
                                    {
                                        <p class="negocio-extracto">@TruncarTexto(n.Descripcion, 110)</p>
                                    }
                                    <div class="negocio-footer-card">
                                        @* ◆ ICONO: flecha (antes ↗) *@
                                        <span class="enlace-ver-mas">
                                            Ver detalles y fotos <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                                        </span>
                                        @if (EsHospedaje(n))
                                        {
                                            <span class="badge-booking-pill">Booking</span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="estado-vacio-limpio">
                        <p>No hay comercios registrados en esta categoría para @ficha.Nombre actualmente.</p>
                    </div>
                }
            </section>

            <div class="divisor-seccion"></div>

            <!-- SECCIÓN 5: OPINIONES DE VIAJEROS (HU-28) -->
            <section class="bloque-contenido">
                <div class="bloque-cabecera">
                    <span class="bloque-indice">05</span>
                    <h2 class="bloque-titulo">Opiniones de Viajeros</h2>
                </div>

                <ListaResenas IdMunicipio="ficha.IdMunicipio" NombreLugar="@ficha.Nombre" />
            </section>

            <div class="divisor-seccion"></div>

            <!-- SECCIÓN 6: UBICACIÓN GEOGRÁFICA -->
            <section class="bloque-contenido">
                <div class="bloque-cabecera-flex">
                    <div class="bloque-titulo-agrupado">
                        <span class="bloque-indice">06</span>
                        <h2 class="bloque-titulo">Ubicación Geográfica</h2>
                    </div>
                    @* ◆ ICONO: abrir fuera (antes ↗) *@
                    <a href="@ObtenerUrlGoogleMaps(ficha.Nombre, ficha.Latitud, ficha.Longitud)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="enlace-mapa-discreto">
                        Abrir en Google Maps <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="mapa-frame-container">
                    <iframe class="mapa-frame"
                            src="@ObtenerUrlIframeMaps(ficha.Nombre, ficha.Latitud, ficha.Longitud)"
                            loading="lazy"
                            allowfullscreen
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(ficha.Historia))
            {
                <div class="divisor-seccion"></div>

                <!-- SECCIÓN 7: HISTORIA Y MEMORIA -->
                <section class="bloque-contenido">
                    <div class="bloque-cabecera">
                        <span class="bloque-indice">07</span>
                        <h2 class="bloque-titulo">Historia y Memoria</h2>
                    </div>
              
                                <p class="parrafo-editorial">@ficha.Historia</p>
                </section>
            }

            <div class="divisor-seccion"></div>

            <!-- SECCIÓN FINAL: SI TE GUSTÓ ESTE MUNICIPIO (Recomendaciones) -->
            <section class="bloque-contenido">
                <div class="bloque-cabecera">
                    <span class="bloque-indice"><i class="ph ph-compass" aria-hidden="true"></i></span>
                    <h2 class="bloque-titulo">Si te gustó @ficha.Nombre…</h2>
                </div>

                <MunicipiosSimilares IdMunicipio="ficha.IdMunicipio" Desde="@Desde" />
            </section>
        </main>

        

        <!-- FOOTER DISCRETO -->
        <footer class="selva-footer">
            <p>TurismoConecta Boyacá — Guía de Destinos</p>
        </footer>

        <!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN DE MUNICIPIO -->
        @if (mostrarConfirmacion)
        {
            <div class="selva-modal-backdrop">
                <div class="selva-modal-window">
                    <h3>Confirmar eliminación</h3>
                    <p>¿Deseas remover a <strong>@ficha.Nombre</strong> del catálogo?</p>
                    <div class="selva-modal-actions">
                        <button class="btn-modal-cancel" @onclick="() => mostrarConfirmacion = false">Cancelar</button>
                        <button class="btn-modal-delete" @onclick="Eliminar">Remover</button>
                    </div>
                </div>
            </div>
        }

        <!-- MODAL INMERSIVO DE DETALLE DEL ESTABLECIMIENTO -->
        @if (negocioModal != null)
        {
            <div class="modal-backdrop-negocio" @onclick="CerrarModalNegocio">
                <div class="modal-card-negocio" @onclick:stopPropagation="true">

                    @* ◆ ICONO: cerrar (antes ✕) *@
                    <button type="button" class="modal-btn-cerrar-negocio" @onclick="CerrarModalNegocio" title="Cerrar" aria-label="Cerrar">
                        <i class="ph ph-x" aria-hidden="true"></i>
                    </button>

                    <!-- GALERÍA / CARRUSEL DE FOTOS -->
                    <div class="modal-negocio-galeria">
                        @{
                            var fotosGaleria = ObtenerGaleriaCompleta(negocioModal);
                        }
                        <div class="modal-foto-principal-wrap">
                            <img src="@fotosGaleria[imagenModalActiva]"
                                 alt="@negocioModal.Nombre"
                                 class="modal-foto-principal"
                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=1200&auto=format&fit=crop';" />
                            <div class="modal-foto-scrim">
                                <div class="modal-negocio-fav">
                                    <BotonFavorito IdNegocio="negocioModal.IdNegocio" />
                                </div>
                                <span class="modal-negocio-cat-tag">@negocioModal.NombreCategoria</span>
                                <h2 class="modal-negocio-titulo">@negocioModal.Nombre</h2>
                            </div>
                        </div>

                        @if (fotosGaleria.Count > 1)
                        {
                            <div class="modal-tira-miniaturas">
                                @for (int i = 0; i < fotosGaleria.Count; i++)
                                {
                                    var idx = i;
                                    <img src="@fotosGaleria[idx]"
                                         alt="Miniatura @(idx + 1)"
                                         class="miniatura-item @(imagenModalActiva == idx ? "activa" : "")"
                                         @onclick="() => imagenModalActiva = idx" />
                                }
                            </div>
                        }
                    </div>

                    <!-- CUERPO DE DETALLES -->
                    <div class="modal-negocio-cuerpo">

                        @if (!string.IsNullOrWhiteSpace(negocioModal.Descripcion))
                        {
                            <div class="modal-negocio-seccion">
                                <span class="modal-subtitulo-label">Sobre este establecimiento</span>
                                <p class="modal-texto-desc">@negocioModal.Descripcion</p>
                            </div>
                        }

                        <!-- METADATOS: HORARIOS Y UBICACIÓN -->
                        @* ◆ ICONOS: 📍 🕒 📞 → Phosphor *@
                        <div class="modal-datos-grid">
                            <div class="modal-dato-card">
                                <span class="dato-icono" aria-hidden="true"><i class="ph-fill ph-map-pin"></i></span>
                                <div>
                                    <strong>Dirección</strong>
                                    <p>@(string.IsNullOrWhiteSpace(negocioModal.Direccion) ? "Centro de " + ficha.Nombre : negocioModal.Direccion)</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(negocioModal.Horario))
                            {
                                <div class="modal-dato-card">
                                    <span class="dato-icono" aria-hidden="true"><i class="ph ph-clock"></i></span>
                                    <div>
                                        <strong>Horario de atención</strong>
                                        <p>@negocioModal.Horario</p>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(negocioModal.Telefono))
                            {
                                <div class="modal-dato-card">
                                    <span class="dato-icono" aria-hidden="true"><i class="ph ph-phone"></i></span>
                                    <div>
                                        <strong>Teléfono / Móvil</strong>
                                        <p>@negocioModal.Telefono</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- INTEGRACIÓN EXCLUSIVA DE HOTELERÍA: BOOKING Y VINCULACIÓN -->
                        @* ◆ CAMBIO: antes "IdCategoria == 1", que en tu BD es Gastronomía *@
                        @if (EsHospedaje(negocioModal))
                        {
                            <div class="caja-booking-integracion">
                                <div class="booking-header">
                                    <span class="booking-logo-text">Booking<span>.com</span></span>
                                    <span class="booking-badge-disponibilidad">Verificación Online</span>
                                </div>
                                <p class="booking-desc">
                                    Consulta tarifas y disponibilidad garantizada para este hospedaje en Boyacá.
                                </p>
                                <div class="booking-acciones-row">
                                    <a href="@ObtenerUrlBooking(negocioModal, ficha.Nombre)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-booking-oficial">
                                        Reservar en Booking.com <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                                    </a>

                                    <button type="button"
                                            class="btn-vincular-itinerario @(hospedajeGuardado ? "guardado" : "")"
                                            @onclick="GuardarHospedajeEnItinerario">
                                        @if (hospedajeGuardado)
                                        {
                                            <i class="ph ph-check" aria-hidden="true"></i>
                                            <span>Hospedaje vinculado a tu ruta</span>
                                        }
                                        else
                                        {
                                            <i class="ph ph-push-pin" aria-hidden="true"></i>
                                            <span>Agregar a mi itinerario</span>
                                        }
                                    </button>
                                </div>
                                @if (hospedajeGuardado)
                                {
                                    <div class="alerta-itinerario-exito">
                                        <i class="ph-fill ph-sparkle" aria-hidden="true"></i>
                                        Guardamos este hotel en tus notas de viaje para planificar tu itinerario por @ficha.Nombre.
                                    </div>
                                }
                            </div>
                        }

                        <!-- OPINIONES DEL ESTABLECIMIENTO (HU-28 / HU-29) -->
                        <div class="modal-negocio-seccion">
                            <span class="modal-subtitulo-label">Opiniones de visitantes</span>
                            <ListaResenas IdNegocio="negocioModal.IdNegocio" NombreLugar="@negocioModal.Nombre" Compacta="true" />
                        </div>

                        <!-- BOTONES DE ACCIÓN RÁPIDA: WHATSAPP Y LLAMADA -->
                        @* ◆ ICONOS: 💬 📞 🗺️ → Phosphor *@
                        <div class="modal-botones-contacto">
                            @if (!string.IsNullOrWhiteSpace(negocioModal.WhatsApp))
                            {
                                <a href="@ObtenerUrlWhatsApp(negocioModal, ficha.Nombre)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn-contacto-ws">
                                    <i class="ph ph-whatsapp-logo" aria-hidden="true"></i> Contactar por WhatsApp
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(negocioModal.Telefono))
                            {
                                <a href="tel:@negocioModal.Telefono" class="btn-contacto-tel">
                                    <i class="ph ph-phone" aria-hidden="true"></i> Llamar directamente
                                </a>
                            }

                            <a href="@ObtenerUrlGoogleMapsNegocio(negocioModal, ficha.Nombre)"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-contacto-mapa">
                                <i class="ph ph-map-trifold" aria-hidden="true"></i> Ver en Google Maps
                            </a>
                        </div>

                        <div class="modal-footer-cierre">
                            <button type="button" class="btn-volver-ficha" @onclick="CerrarModalNegocio">
                                <i class="ph ph-arrow-left" aria-hidden="true"></i> Volver a explorar @ficha.Nombre
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    // ════════════════════════════════════════════════
    // 1. PARÁMETROS DE LA URL
    // ════════════════════════════════════════════════
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "desde")]
    public string? Desde { get; set; }

    private bool VieneDeInicio => string.Equals(Desde, "inicio", StringComparison.OrdinalIgnoreCase);

    // ════════════════════════════════════════════════
    // 2. ESTADO
    // ════════════════════════════════════════════════
    private MunicipioFichaDto? ficha;
    private List<NegocioResumenDto>? negociosLocales;
    private bool cargando = true;
    private bool cargandoNegocios = true;
    private bool mostrarConfirmacion = false;
    private bool enItinerario = false;

    // ◆ NUEVO: id ya cargado (para no recargar si no cambió)
    private int idCargado;

    // ◆ NUEVO: sitios turísticos reales del municipio
    private List<SitioTuristicoDto> sitiosMunicipio = new();
    private bool cargandoSitios = true;

    // ◆ NUEVO: categorías de negocio desde la BD
    private List<CategoriaDto> categoriasNegocio = new();

    // Filtro de categorías y modal de negocio
    private int categoriaSeleccionada = 0; // 0 = Todos
    private NegocioResumenDto? negocioModal = null;
    private int imagenModalActiva = 0;
    private bool hospedajeGuardado = false;

    private List<NegocioResumenDto> NegociosFiltrados =>
        categoriaSeleccionada == 0
            ? (negociosLocales ?? new())
            : (negociosLocales?.Where(n => n.IdCategoria == categoriaSeleccionada).ToList() ?? new());

    private void SeleccionarCategoria(int idCat) => categoriaSeleccionada = idCat;

    // ════════════════════════════════════════════════
    // 3. CARGA DE DATOS
    // ════════════════════════════════════════════════

    // ◆ CAMBIO: antes OnInitializedAsync sin try/finally (podía quedar "cargando" para siempre)
    protected override async Task OnParametersSetAsync()
    {
        if (Id == idCargado) return;
        idCargado = Id;

        cargando = true;
        cargandoNegocios = true;
        cargandoSitios = true;
        ficha = null;
        negociosLocales = null;
        sitiosMunicipio = new();
        categoriaSeleccionada = 0;
        negocioModal = null;
        mostrarConfirmacion = false;

        try
        {
            ficha = await ApiService.ObtenerFichaAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando la ficha {Id}: {ex}");
            ficha = null;
        }
        finally
        {
            cargando = false;
        }

        if (ficha is null)
        {
            cargandoNegocios = false;
            cargandoSitios = false;
            return;
        }

        // Muestra la ficha de inmediato; negocios, sitios y categorías llegan después
        StateHasChanged();

        await Task.WhenAll(
            CargarNegociosAsync(),
            CargarSitiosAsync(),
            CargarCategoriasNegocioAsync());
    }

    private async Task CargarNegociosAsync()
    {
        try
        {
            negociosLocales = await ApiService.ObtenerNegociosPorMunicipioAsync(Id) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando negocios de {Id}: {ex}");
            negociosLocales = new();
        }
        finally
        {
            cargandoNegocios = false;
        }
    }

    private async Task CargarSitiosAsync()
    {
        try
        {
            var todos = await SitioService.ListarAsync();
            sitiosMunicipio = todos
                .Where(s => s.IdMunicipio == Id)
                .OrderByDescending(s => s.Destacado)
                .ThenBy(s => s.Nombre)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando sitios de {Id}: {ex}");
            sitiosMunicipio = new();
        }
        finally
        {
            cargandoSitios = false;
        }
    }

    private async Task CargarCategoriasNegocioAsync()
    {
        if (categoriasNegocio.Count > 0) return;   // ya se cargaron antes

        try
        {
            categoriasNegocio = await NegocioService.ListarCategoriasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando categorías: {ex}");
            categoriasNegocio = new();
        }
    }

    // ════════════════════════════════════════════════
    // 4. AYUDANTES DE CATEGORÍA E IMÁGENES
    // ════════════════════════════════════════════════

    // ◆ NUEVO: detecta hospedaje por NOMBRE de categoría, no por un id escrito a mano
    private static bool EsHospedaje(NegocioResumenDto n) =>
        !string.IsNullOrWhiteSpace(n.NombreCategoria) &&
        n.NombreCategoria.Contains("hosped", StringComparison.OrdinalIgnoreCase);

    // ◆ NUEVO: imagen del sitio turístico (ruta de la API o genérica)
    private string ImagenSitio(string? url) =>
        string.IsNullOrWhiteSpace(url) ? ApiConfig.ImagenPorDefecto : Api.Url(url);

    // ◆ CAMBIO: la foto de respaldo se elige por nombre de categoría (antes por id equivocado)
    private string ObtenerFotoNegocio(NegocioResumenDto n)
    {
        if (n.Galeria != null && n.Galeria.Any(g => !string.IsNullOrWhiteSpace(g)))
            return n.Galeria.First(g => !string.IsNullOrWhiteSpace(g));

        var categoria = n.NombreCategoria ?? "";

        if (categoria.Contains("hosped", StringComparison.OrdinalIgnoreCase))
            return "https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800&auto=format&fit=crop"; // Hotel
        if (categoria.Contains("gastro", StringComparison.OrdinalIgnoreCase))
            return "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=800&auto=format&fit=crop"; // Restaurante
        if (categoria.Contains("artesan", StringComparison.OrdinalIgnoreCase))
            return "https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=800&auto=format&fit=crop"; // Artesanías

        return "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?q=80&w=800&auto=format&fit=crop";
    }

    private List<string> ObtenerGaleriaCompleta(NegocioResumenDto n)
    {
        var lista = n.Galeria?.Where(g => !string.IsNullOrWhiteSpace(g)).ToList() ?? new();
        if (!lista.Any()) lista.Add(ObtenerFotoNegocio(n));
        return lista;
    }

    // ════════════════════════════════════════════════
    // 5. MODAL DE NEGOCIO
    // ════════════════════════════════════════════════
    private void AbrirModalNegocio(NegocioResumenDto negocio)
    {
        negocioModal = negocio;
        imagenModalActiva = 0;
        hospedajeGuardado = false;
    }

    private void CerrarModalNegocio() => negocioModal = null;

    private void GuardarHospedajeEnItinerario() => hospedajeGuardado = true;

    // ════════════════════════════════════════════════
    // 6. ENLACES EXTERNOS
    // ════════════════════════════════════════════════
    private string ObtenerUrlBooking(NegocioResumenDto n, string nombreMunicipio)
    {
        if (!string.IsNullOrWhiteSpace(n.BookingUrl))
            return n.BookingUrl;

        var busqueda = Uri.EscapeDataString($"{n.Nombre} {nombreMunicipio} Boyacá");
        return $"https://www.booking.com/searchresults.html?ss={busqueda}";
    }

    private string ObtenerUrlWhatsApp(NegocioResumenDto n, string nombreMunicipio)
    {
        var num = n.WhatsApp ?? n.Telefono?.Replace(" ", "").Replace("+", "") ?? "";
        var texto = Uri.EscapeDataString($"¡Hola! Vi {n.Nombre} en TurismoConecta ({nombreMunicipio}) y me gustaría recibir más información.");
        return $"https://api.whatsapp.com/send?phone={num}&text={texto}";
    }

    private string ObtenerUrlGoogleMapsNegocio(NegocioResumenDto n, string nombreMunicipio)
    {
        if (n.Latitud.HasValue && n.Longitud.HasValue && n.Latitud != 0 && n.Longitud != 0)
        {
            return $"https://www.google.com/maps/search/?api=1&query={n.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{n.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }
        var query = Uri.EscapeDataString($"{n.Nombre}, {n.Direccion ?? ""}, {nombreMunicipio}, Boyacá, Colombia");
        return $"https://www.google.com/maps/search/?api=1&query={query}";
    }

    private string ObtenerUrlGoogleMaps(string nombre, decimal? lat, decimal? lon)
    {
        if (lat.HasValue && lon.HasValue && lat != 0 && lon != 0)
        {
            return $"https://www.google.com/maps/search/?api=1&query={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }
        return $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(nombre + ", Boyacá, Colombia")}";
    }

    private string ObtenerUrlIframeMaps(string nombre, decimal? lat, decimal? lon)
    {
        if (lat.HasValue && lon.HasValue && lat != 0 && lon != 0)
        {
            return $"https://maps.google.com/maps?q={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&hl=es&z=14&output=embed";
        }
        return $"https://maps.google.com/maps?q={Uri.EscapeDataString(nombre + ", Boyacá, Colombia")}&hl=es&z=13&output=embed";
    }

    // ════════════════════════════════════════════════
    // 7. TEXTO Y FORMATO
    // ════════════════════════════════════════════════
    private string TruncarTexto(string texto, int max)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Length <= max) return texto;
        return texto[..max] + "...";
    }

    private string FormatearClimaDiscreto(string clima)
    {
        if (string.IsNullOrWhiteSpace(clima)) return "Clima templado";
        var match = System.Text.RegularExpressions.Regex.Match(clima, @"\d+(\s*°\s*C|\s*°C|\s*°)");
        if (match.Success)
        {
            string g = match.Value.Replace(" ", "");
            if (!g.Contains("°C")) g += "C";
            return g;
        }
        return clima.Length > 20 ? clima[..18] + "..." : clima;
    }

    private string ObtenerClaseBadge(string tipo)
    {
        return tipo.ToLowerInvariant() switch
        {
            "patronal" => "patronal",
            "cultural" => "cultural",
            "gastronómica" or "gastronomica" => "gastronomica",
            "artesanal" => "artesanal",
            "deportiva" => "deportiva",
            "religiosa" => "religiosa",
            _ => "general"
        };
    }

    // ════════════════════════════════════════════════
    // 8. PANTALLA DE ESPERA
    // ════════════════════════════════════════════════
    private record PaisajeBoyaca(string Lugar, string Frase, string Url);

    private static readonly PaisajeBoyaca[] PaisajesBoyaca = new[]
    {
        new PaisajeBoyaca("Páramo de Ocetá", "Uno de los páramos más hermosos del mundo, cubierto de frailejones y silencio.", "https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1600&auto=format&fit=crop"),
        new PaisajeBoyaca("Laguna de Tota", "Espejo de agua andino a más de 3.000 metros de altura sobre la cordillera.", "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=1600&auto=format&fit=crop"),
        new PaisajeBoyaca("Pueblos de Piedra y Barro", "Calles empedradas, balcones de madera y tejas de barro centenarias.", "https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=1600&auto=format&fit=crop"),
        new PaisajeBoyaca("Valle del Sugamuxi", "Tierras fértiles donde habitaron los sabios del imperio Muisca.", "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?q=80&w=1600&auto=format&fit=crop")
    };

    private PaisajeBoyaca paisajeEspera = PaisajesBoyaca[Random.Shared.Next(PaisajesBoyaca.Length)];

    // ════════════════════════════════════════════════
    // 9. ACCIONES DE LA BARRA
    // ════════════════════════════════════════════════
    private void Volver() => Nav.NavigateTo(VieneDeInicio ? "/#donde-ir" : "/municipios");

    private void ToggleItinerario() => enItinerario = !enItinerario;

    private void ConfirmarEliminar() => mostrarConfirmacion = true;

    private Task Eliminar()
    {
        mostrarConfirmacion = false;
        return Task.CompletedTask;
    }
}
