                        <div class="modal-footer-cierre">
                            <button type="button" class="btn-volver-ficha" @onclick="CerrarModalNegocio">
                                <i class="ph ph-arrow-left" aria-hidden="true"></i> Volver a explorar @ficha.Nombre
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    // ════════════════════════════════════════════════
    // 1. PARÁMETROS DE LA URL
    // ════════════════════════════════════════════════
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "desde")]
    public string? Desde { get; set; }

    private bool VieneDeInicio => string.Equals(Desde, "inicio", StringComparison.OrdinalIgnoreCase);

    // ════════════════════════════════════════════════
    // 2. ESTADO
    // ════════════════════════════════════════════════
    private MunicipioFichaDto? ficha;
    private List<NegocioResumenDto>? negociosLocales;
    private bool cargando = true;
    private bool cargandoNegocios = true;
    private bool mostrarConfirmacion = false;

    private static readonly System.Globalization.CultureInfo Es = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    // ◆ NUEVO: id ya cargado (para no recargar si no cambió)
    private int idCargado;

    // ◆ NUEVO: sitios turísticos reales del municipio
    private List<SitioTuristicoDto> sitiosMunicipio = new();
    private bool cargandoSitios = true;

    // ◆ NUEVO: categorías de negocio desde la BD
    private List<CategoriaDto> categoriasNegocio = new();

    // Filtro de categorías y modal de negocio
    private int categoriaSeleccionada = 0; // 0 = Todos
    private NegocioResumenDto? negocioModal = null;
    private int imagenModalActiva = 0;
    private bool hospedajeGuardado = false;

    private List<NegocioResumenDto> NegociosFiltrados =>
        categoriaSeleccionada == 0
            ? (negociosLocales ?? new())
            : (negociosLocales?.Where(n => n.IdCategoria == categoriaSeleccionada).ToList() ?? new());

    private void SeleccionarCategoria(int idCat) => categoriaSeleccionada = idCat;

    // ════════════════════════════════════════════════
    // 3. CARGA DE DATOS
    // ════════════════════════════════════════════════

    // ◆ CAMBIO: antes OnInitializedAsync sin try/finally (podía quedar "cargando" para siempre)
    protected override async Task OnParametersSetAsync()
    {
        if (Id == idCargado) return;
        idCargado = Id;

        cargando = true;
        cargandoNegocios = true;
        cargandoSitios = true;
        ficha = null;
        negociosLocales = null;
        sitiosMunicipio = new();
        categoriaSeleccionada = 0;
        negocioModal = null;
        mostrarConfirmacion = false;

        try
        {
            ficha = await ApiService.ObtenerFichaAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando la ficha {Id}: {ex}");
            ficha = null;
        }
        finally
        {
            cargando = false;
        }

        if (ficha is null)
        {
            cargandoNegocios = false;
            cargandoSitios = false;
            return;
        }

        // Muestra la ficha de inmediato; negocios, sitios y categorías llegan después
        StateHasChanged();

        // Estadísticas: cuenta la vista sin esperar la respuesta (nunca frena la página)
        _ = Visibilidad.VistaMunicipioAsync(ficha.IdMunicipio);

        await Task.WhenAll(
            CargarNegociosAsync(),
            CargarSitiosAsync(),
            CargarCategoriasNegocioAsync());
    }

    private async Task CargarNegociosAsync()
    {
        try
        {
            negociosLocales = await ApiService.ObtenerNegociosPorMunicipioAsync(Id) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando negocios de {Id}: {ex}");
            negociosLocales = new();
        }
        finally
        {
            cargandoNegocios = false;
        }
    }

    private async Task CargarSitiosAsync()
    {
        try
        {
            var todos = await SitioService.ListarAsync();
            sitiosMunicipio = todos
                .Where(s => s.IdMunicipio == Id)
                .OrderByDescending(s => s.Destacado)
                .ThenBy(s => s.Nombre)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando sitios de {Id}: {ex}");
            sitiosMunicipio = new();
        }
        finally
        {
            cargandoSitios = false;
        }
    }

    private async Task CargarCategoriasNegocioAsync()
    {
        if (categoriasNegocio.Count > 0) return;   // ya se cargaron antes

        try
        {
            categoriasNegocio = await NegocioService.ListarCategoriasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MunicipioFicha] Error cargando categorías: {ex}");
            categoriasNegocio = new();
        }
    }

    // ════════════════════════════════════════════════
    // 4. AYUDANTES DE CATEGORÍA E IMÁGENES
    // ════════════════════════════════════════════════

    // ◆ NUEVO: detecta hospedaje por NOMBRE de categoría, no por un id escrito a mano
    private static bool EsHospedaje(NegocioResumenDto n) =>
        !string.IsNullOrWhiteSpace(n.NombreCategoria) &&
        n.NombreCategoria.Contains("hosped", StringComparison.OrdinalIgnoreCase);

    // ◆ NUEVO: imagen del sitio turístico (ruta de la API o genérica)
    private string ImagenSitio(string? url) =>
        string.IsNullOrWhiteSpace(url) ? ApiConfig.ImagenPorDefecto : Api.Url(url);

    // ◆ CAMBIO: la foto de respaldo se elige por nombre de categoría (antes por id equivocado)
    private string ObtenerFotoNegocio(NegocioResumenDto n)
    {
        if (n.Galeria != null && n.Galeria.Any(g => !string.IsNullOrWhiteSpace(g)))
            return n.Galeria.First(g => !string.IsNullOrWhiteSpace(g));

        var categoria = n.NombreCategoria ?? "";

        if (categoria.Contains("hosped", StringComparison.OrdinalIgnoreCase))
            return "https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800&auto=format&fit=crop"; // Hotel
        if (categoria.Contains("gastro", StringComparison.OrdinalIgnoreCase))
            return "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=800&auto=format&fit=crop"; // Restaurante
        if (categoria.Contains("artesan", StringComparison.OrdinalIgnoreCase))
            return "https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=800&auto=format&fit=crop"; // Artesanías

        return "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?q=80&w=800&auto=format&fit=crop";
    }

    private List<string> ObtenerGaleriaCompleta(NegocioResumenDto n)
    {
        var lista = n.Galeria?.Where(g => !string.IsNullOrWhiteSpace(g)).ToList() ?? new();
        if (!lista.Any()) lista.Add(ObtenerFotoNegocio(n));
        return lista;
    }

    // ════════════════════════════════════════════════
    // 5. MODAL DE NEGOCIO
    // ════════════════════════════════════════════════
    private void AbrirModalNegocio(NegocioResumenDto negocio)
    {
        negocioModal = negocio;
        imagenModalActiva = 0;
        hospedajeGuardado = false;
        _ = Visibilidad.VistaNegocioAsync(negocio.IdNegocio);
    }

    private void CerrarModalNegocio() => negocioModal = null;

    // Estadísticas del comercio: el enlace se abre normal; el registro va en segundo plano
    private void RegistrarClic(string tipo)
    {
        if (negocioModal is not null) _ = Visibilidad.ClicNegocioAsync(tipo, negocioModal.IdNegocio);
    }

    private void GuardarHospedajeEnItinerario() => hospedajeGuardado = true;

    // ════════════════════════════════════════════════
    // 6. ENLACES EXTERNOS
    // ════════════════════════════════════════════════
    private string ObtenerUrlBooking(NegocioResumenDto n, string nombreMunicipio)
    {
        if (!string.IsNullOrWhiteSpace(n.BookingUrl))
            return n.BookingUrl;

        var busqueda = Uri.EscapeDataString($"{n.Nombre} {nombreMunicipio} Boyacá");
        return $"https://www.booking.com/searchresults.html?ss={busqueda}";
    }

    private string ObtenerUrlWhatsApp(NegocioResumenDto n, string nombreMunicipio)
    {
        var num = n.WhatsApp ?? n.Telefono?.Replace(" ", "").Replace("+", "") ?? "";
        var texto = Uri.EscapeDataString($"¡Hola! Vi {n.Nombre} en TurismoConecta ({nombreMunicipio}) y me gustaría recibir más información.");
        return $"https://api.whatsapp.com/send?phone={num}&text={texto}";
    }

    private string ObtenerUrlGoogleMapsNegocio(NegocioResumenDto n, string nombreMunicipio)
    {
        if (n.Latitud.HasValue && n.Longitud.HasValue && n.Latitud != 0 && n.Longitud != 0)
        {
            return $"https://www.google.com/maps/search/?api=1&query={n.Latitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{n.Longitud.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }
        var query = Uri.EscapeDataString($"{n.Nombre}, {n.Direccion ?? ""}, {nombreMunicipio}, Boyacá, Colombia");
        return $"https://www.google.com/maps/search/?api=1&query={query}";
    }

    private string ObtenerUrlGoogleMaps(string nombre, decimal? lat, decimal? lon)
    {
        if (lat.HasValue && lon.HasValue && lat != 0 && lon != 0)
        {
            return $"https://www.google.com/maps/search/?api=1&query={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }
        return $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(nombre + ", Boyacá, Colombia")}";
    }

    private string ObtenerUrlIframeMaps(string nombre, decimal? lat, decimal? lon)
    {
        if (lat.HasValue && lon.HasValue && lat != 0 && lon != 0)
        {
            return $"https://maps.google.com/maps?q={lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&hl=es&z=14&output=embed";
        }
        return $"https://maps.google.com/maps?q={Uri.EscapeDataString(nombre + ", Boyacá, Colombia")}&hl=es&z=13&output=embed";
    }

    // ════════════════════════════════════════════════
    // 7. TEXTO Y FORMATO
    // ════════════════════════════════════════════════
    private string TruncarTexto(string texto, int max)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Length <= max) return texto;
        return texto[..max] + "...";
    }

    private string FormatearClimaDiscreto(string clima)
    {
        if (string.IsNullOrWhiteSpace(clima)) return "Clima templado";
        var match = System.Text.RegularExpressions.Regex.Match(clima, @"\d+(\s*°\s*C|\s*°C|\s*°)");
        if (match.Success)
        {
            string g = match.Value.Replace(" ", "");
            if (!g.Contains("°C")) g += "C";
            return g;
        }
        return clima.Length > 20 ? clima[..18] + "..." : clima;
    }

    private string ObtenerClaseBadge(string tipo)
    {
        return tipo.ToLowerInvariant() switch
        {
            "patronal" => "patronal",
            "cultural" => "cultural",
            "gastronómica" or "gastronomica" => "gastronomica",
            "artesanal" => "artesanal",
            "deportiva" => "deportiva",
            "religiosa" => "religiosa",
            _ => "general"
        };
    }

    // ════════════════════════════════════════════════
    // 7b. CELEBRACIONES: próxima fecha de cada una
    // ════════════════════════════════════════════════

    /// <summary>Una celebración con su próxima fecha (las recurrentes se pasan al año en curso o al siguiente).</summary>
    private sealed record Celebracion(FechaRelevanteDto Fecha, DateOnly Proxima, DateOnly ProximaFin);

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    private List<Celebracion> Celebraciones =>
        (ficha?.FechasRelevantes ?? new())
            .Select(CalcularProxima)
            // Primero las que vienen (o están en curso), luego las ya pasadas y al final las que no tienen fecha
            .OrderBy(c => c.Proxima == default ? 2 : c.ProximaFin < Hoy ? 1 : 0)
            .ThenBy(c => c.Proxima)
            .ToList();

    private Celebracion? ProximaCelebracion =>
        Celebraciones.FirstOrDefault(c => c.Proxima != default && c.ProximaFin >= Hoy);

    private static Celebracion CalcularProxima(FechaRelevanteDto f)
    {
        if (f.FechaInicio == default) return new Celebracion(f, default, default);

        var duracion = f.FechaFin != default && f.FechaFin > f.FechaInicio ? f.FechaFin.DayNumber - f.FechaInicio.DayNumber : 0;
        if (!f.EsRecurrente) return new Celebracion(f, f.FechaInicio, f.FechaInicio.AddDays(duracion));

        var inicio = EnAnio(f.FechaInicio, Hoy.Year);
        if (inicio.AddDays(duracion) < Hoy) inicio = EnAnio(f.FechaInicio, Hoy.Year + 1);
        return new Celebracion(f, inicio, inicio.AddDays(duracion));
    }

    // 29 de febrero en un año no bisiesto → 28 de febrero
    private static DateOnly EnAnio(DateOnly fecha, int anio) =>
        new(anio, fecha.Month, Math.Min(fecha.Day, DateTime.DaysInMonth(anio, fecha.Month)));

    private string TextoFechas(Celebracion c)
    {
        if (c.Proxima == default) return "Celebración tradicional (fecha por confirmar)";

        var prefijo = c.ProximaFin < Hoy ? "Fue " : "";
        if (c.ProximaFin == c.Proxima)
            return prefijo + c.Proxima.ToString("dddd d 'de' MMMM 'de' yyyy", Es);
        if (c.Proxima.Month == c.ProximaFin.Month)
            return $"{prefijo}Del {c.Proxima.Day} al {c.ProximaFin.ToString("d 'de' MMMM 'de' yyyy", Es)}";
        return $"{prefijo}Del {c.Proxima.ToString("d 'de' MMMM", Es)} al {c.ProximaFin.ToString("d 'de' MMMM 'de' yyyy", Es)}";
    }

    private string TextoFalta(DateOnly proxima)
    {
        var dias = proxima.DayNumber - Hoy.DayNumber;
        return dias switch
        {
            < 0 => "En curso",
            0 => "¡Es hoy!",
            1 => "Mañana",
            _ => $"Faltan {dias} días"
        };
    }

    // ════════════════════════════════════════════════
    // 7c. UBICACIÓN Y ANCLAS
    // ════════════════════════════════════════════════
    /// <summary>La cuadrícula se adapta: 1 = tarjeta ancha horizontal, 2 = dos columnas, 3 o más = cuadrícula.</summary>
    private static string ClaseCantidad(int cantidad) => cantidad switch { 1 => "uno", 2 => "dos", _ => "varios" };

    private bool TieneCoordenadas =>
        ficha?.Latitud is decimal lat && ficha.Longitud is decimal lon && lat != 0 && lon != 0;

    private string UrlWaze =>
        $"https://waze.com/ul?ll={ficha!.Latitud!.Value.ToString(Inv)},{ficha.Longitud!.Value.ToString(Inv)}&navigate=yes";

    /// <summary>
    /// Enlace a una sección de esta misma página. Con &lt;base href="/"&gt; un "#id" suelto
    /// llevaría al inicio, así que se arma con la dirección actual.
    /// </summary>
    private ValueTask IrASeccion(string id) => JS.InvokeVoidAsync("navegacion.irASeccion", id);

    private string Ancla(string id)
    {
        var uri = Nav.Uri;
        var hash = uri.IndexOf('#');
        return (hash >= 0 ? uri[..hash] : uri) + "#" + id;
    }

    // ════════════════════════════════════════════════
    // 8. PANTALLA DE ESPERA
    // ════════════════════════════════════════════════
    private record PaisajeBoyaca(string Lugar, string Frase, string Url);

