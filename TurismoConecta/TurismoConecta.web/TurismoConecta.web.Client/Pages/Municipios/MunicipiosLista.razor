@page "/municipios"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject MunicipioApiService ApiService
@inject EtiquetaApiService EtiquetaService
@inject NavigationManager Nav
@inject ApiConfig Api

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="pagina-municipios">

    @* ============ HERO ============ *@
    <section class="hero">
        <div class="hero-fondo" aria-hidden="true"></div>
        <div class="hero-contenido">
            
            <nav class="hero-nav" aria-label="Navegación principal">
                <a href="/" class="hero-volver">
                    <i class="ph ph-arrow-left" aria-hidden="true"></i> Volver al inicio
                </a>
            </nav>

            <p class="hero-eyebrow">Boyacá, Colombia</p>
            <h1 class="hero-titulo">Explora los pueblos mágicos de Boyacá</h1>
            <p class="hero-bajada">
                Calles de piedra, plazas blancas y montañas de páramo: encuentra el municipio
                que combina con tu próximo viaje y súmalo a tu itinerario en un clic.
            </p>

            <div class="buscador">
                <svg class="icono-buscar" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                    <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <input class="buscador-input" @bind="textoBusqueda" @bind:event="oninput" @onkeyup="OnTeclaBusqueda"
                       placeholder="Busca por nombre: Villa de Leyva, Monguí..." />
                @if (!string.IsNullOrWhiteSpace(textoBusqueda))
                {
                    <button class="buscador-limpiar" @onclick="LimpiarBusqueda" aria-label="Limpiar búsqueda">✕</button>
                }
            </div>
        </div>
        <svg class="hero-horizonte" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,80 L120,40 L260,65 L400,20 L560,55 L720,15 L900,60 L1060,30 L1220,58 L1440,25 L1440,90 L0,90 Z" />
        </svg>
    </section>

    @* ============ FILTROS POR ETIQUETA (todas las etiquetas activas, no solo las de la página) ============ *@
    @if (etiquetas.Any())
    {
        <section class="filtros" aria-label="Filtrar por experiencia">
            <div class="filtros-lista">
                @foreach (var etiqueta in etiquetas)
                {
                    <button class="chip @(filtrosActivos.Contains(etiqueta.IdEtiqueta) ? "chip-activo" : "")"
                            @onclick="() => ToggleFiltro(etiqueta.IdEtiqueta)">
                        @etiqueta.Nombre
                    </button>
                }
            </div>
            @if (filtrosActivos.Any())
            {
                <button class="filtros-limpiar" @onclick="LimpiarFiltros">Limpiar filtros</button>
            }
        </section>
    }

    @* ============ CARRUSEL: LOS MEJOR CALIFICADOS (reseñas reales) ============ *@
    @if (destacados.Any() && !HayFiltros)
    {
        <section class="destacados" @onmouseenter="() => carruselPausado = true" @onmouseleave="() => carruselPausado = false">
            <h2 class="destacados-titulo">Los mejor calificados por viajeros</h2>
            <div class="destacados-carrusel">
                @{
                    var actual = destacados[indiceCarrusel % destacados.Count];
                }
                <div class="destacado-card" @key="actual.IdMunicipio">
                    <div class="destacado-img" style="background-image:url('@Api.ImagenMunicipio(actual.Nombre, actual.ImagenUrl)')"></div>
                    <div class="destacado-info">
                        <span class="sello-recomendado">
                            <EstrellasCalificacion Valor="@(actual.PromedioCalificacion ?? 0)" />
                            @actual.PromedioCalificacion?.ToString("0.0") · @actual.TotalResenas reseña@(actual.TotalResenas == 1 ? "" : "s")
                        </span>
                        <h3>@actual.Nombre</h3>
                        <p>@Resumen(actual)</p>
                        <button class="btn-primario" @onclick="() => VerFicha(actual.IdMunicipio)">Explorar pueblo</button>
                    </div>
                </div>
                <div class="destacados-puntos">
                    @for (int i = 0; i < destacados.Count; i++)
                    {
                        var idx = i;
                        <button class="punto @(idx == indiceCarrusel ? "punto-activo" : "")"
                                @onclick="() => IrADestacado(idx)" aria-label="Ver destacado @(idx + 1)"></button>
                    }
                </div>
            </div>
        </section>
    }

    @* ============ CONTENIDO PRINCIPAL ============ *@
    <section class="catalogo">

        <div class="catalogo-barra">
            <p class="catalogo-conteo">
                @(cargando ? "Buscando municipios..." : $"{total} municipio{(total == 1 ? "" : "s")}")
            </p>
            <label class="catalogo-orden">
                <span>Ordenar por</span>
                <select value="@orden" @onchange="CambiarOrden">
                    <option value="nombre">Nombre (A–Z)</option>
                    <option value="calificacion">Mejor calificados</option>
                    <option value="resenas">Más reseñados</option>
                </select>
            </label>
        </div>

        @if (cargando)
        {
            <div class="grid-municipios">
                @for (int i = 0; i < 9; i++)
                {
                    <div class="card-esqueleto">
                        <div class="esqueleto-img shimmer"></div>
                        <div class="esqueleto-linea shimmer" style="width:70%"></div>
                        <div class="esqueleto-linea shimmer" style="width:45%"></div>
                    </div>
                }
            </div>
        }
        else if (huboError)
        {
            <div class="estado estado-error">
                <p class="estado-titulo">No se pudo cargar la información</p>
                <p class="estado-texto">Revisa tu conexión e inténtalo de nuevo.</p>
                <button class="btn-primario" @onclick="() => CargarPagina(paginaActual)">Reintentar</button>
            </div>
        }
        else if (!municipios.Any())
        {
            <div class="estado estado-vacio">
                <svg viewBox="0 0 64 64" class="estado-icono" aria-hidden="true">
                    <circle cx="27" cy="27" r="16" fill="none" stroke="currentColor" stroke-width="3" />
                    <line x1="39" y1="39" x2="54" y2="54" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
                <p class="estado-titulo">No encontramos municipios con esos criterios</p>
                <p class="estado-texto">Intenta limpiar los filtros o buscar con otro nombre.</p>
                <button class="btn-secundario" @onclick="LimpiarTodo">Limpiar búsqueda y filtros</button>
            </div>
        }
        else
        {
            <div class="grid-municipios">
                @foreach (var m in municipios)
                {
                    <article class="card-municipio" @key="m.IdMunicipio">
                        <div class="card-img-container">
                            <img src="@Api.ImagenMunicipio(m.Nombre, m.ImagenUrl)" alt="@m.Nombre"
                                 onerror="this.onerror=null; this.src='@ApiConfig.ImagenPorDefecto';" />

                            <div class="card-badges">
                                @foreach (var etiqueta in m.Etiquetas.Take(2))
                                {
                                    <span class="badge">@etiqueta</span>
                                }
                            </div>

                            @if (EsRecomendado(m))
                            {
                                <span class="badge-recomendado">Recomendado</span>
                            }

                            <button class="btn-agregar @(seleccionados.Contains(m.IdMunicipio) ? "btn-agregar-activo" : "")"
                                    title="@(seleccionados.Contains(m.IdMunicipio) ? "Quitar del itinerario" : "Añadir al itinerario")"
                                    @onclick="() => ToggleSeleccion(m.IdMunicipio)">
                                @(seleccionados.Contains(m.IdMunicipio) ? "✓" : "+")
                            </button>
                        </div>

                        <div class="card-content">
                            <div class="card-ubicacion">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11Z" stroke="currentColor" stroke-width="1.6" />
                                    <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6" />
                                </svg>
                                <span>Boyacá</span>
                            </div>
                            <h3 class="card-titulo">@m.Nombre</h3>

                            <div class="card-calificacion">
                                @if (m.TotalResenas > 0)
                                {
                                    <EstrellasCalificacion Valor="@(m.PromedioCalificacion ?? 0)" />
                                    <span class="calif-numero">@m.PromedioCalificacion?.ToString("0.0")</span>
                                    <span class="calif-total">(@m.TotalResenas)</span>
                                }
                                else
                                {
                                    <span class="calif-sin">Sin reseñas aún</span>
                                }
                            </div>

                            <p class="card-resumen">@Resumen(m)</p>
                        </div>

                        <div class="card-footer">
                            <button class="btn-primario btn-full" @onclick="() => VerFicha(m.IdMunicipio)">Explorar pueblo</button>
                        </div>
                    </article>
                }
            </div>

            @if (totalPaginas > 1)
            {
                <div class="paginacion">
                    <button class="btn-page" disabled="@(paginaActual <= 1)" @onclick="() => CargarPagina(paginaActual - 1)">← Anterior</button>
                    <span class="page-info">Página @paginaActual de @totalPaginas</span>
                    <button class="btn-page" disabled="@(paginaActual >= totalPaginas)" @onclick="() => CargarPagina(paginaActual + 1)">Siguiente →</button>
                </div>
            }
        }
    </section>

    @if (seleccionados.Any())
    {
        <div class="floating-action">
            <div class="floating-texto">
                <span class="floating-badge">@seleccionados.Count</span>
                <span>municipio@(seleccionados.Count == 1 ? "" : "s") en tu itinerario</span>
            </div>
            <button class="btn-itinerario" @onclick="IrACrearItinerario">
                Crear itinerario <span class="btn-itinerario-flecha">→</span>
            </button>
        </div>
    }
</div>

@code {
    // "Recomendado" ya no es inventado: lo deciden las reseñas visibles de los viajeros
    private const double PromedioRecomendado = 4.5;
    private const int MinimoResenasRecomendado = 3;
    private const int TamanoPagina = 12;

    private List<MunicipioExplorarDto> municipios = new();
    private List<MunicipioExplorarDto> destacados = new();
    private List<EtiquetaDto> etiquetas = new();

    private string textoBusqueda = "";
    private string orden = "nombre";
    private HashSet<int> filtrosActivos = new();
    private HashSet<int> seleccionados = new();

    private bool cargando = true;
    private bool huboError;
    private int paginaActual = 1;
    private int totalPaginas = 1;
    private int total;

    private int indiceCarrusel;
    private bool carruselPausado;
    private System.Timers.Timer? _carruselTimer;
    private System.Timers.Timer? _debounceTimer;
    private CancellationTokenSource? _ctsCarga;

    private bool HayFiltros => filtrosActivos.Any() || !string.IsNullOrWhiteSpace(textoBusqueda);

    protected override async Task OnInitializedAsync()
    {
        // Las tres cargas no dependen entre sí: se piden a la vez
        var tareaEtiquetas = EtiquetaService.ListarAsync();
        var tareaDestacados = ApiService.ExplorarAsync(null, null, "calificacion", 1, 5);
        var tareaCatalogo = CargarPagina(1);

        await Task.WhenAll(tareaEtiquetas, tareaDestacados, tareaCatalogo);

        etiquetas = (await tareaEtiquetas).Where(e => e.Activo).OrderBy(e => e.Nombre).ToList();
        destacados = (await tareaDestacados)?.Items.Where(m => m.TotalResenas > 0).ToList() ?? new();
        ReiniciarCarrusel();
    }

    // Toda búsqueda, filtro, orden o cambio de página pasa por aquí: el servidor filtra y pagina
    private async Task CargarPagina(int pagina)
    {
        // Si llega otra búsqueda mientras esta sigue en camino, se cancela la anterior
        _ctsCarga?.Cancel();
        _ctsCarga = new CancellationTokenSource();
        var token = _ctsCarga.Token;

        cargando = true;
        huboError = false;

        var resultado = await ApiService.ExplorarAsync(textoBusqueda, filtrosActivos, orden, pagina, TamanoPagina, token);
        if (token.IsCancellationRequested) return;   // ya hay una búsqueda más nueva: esta respuesta no sirve

        if (resultado is null)
        {
            huboError = true;
            municipios = new();
        }
        else
        {
            municipios = resultado.Items;
            total = resultado.Total;
            paginaActual = resultado.Pagina;
            totalPaginas = Math.Max(1, resultado.TotalPaginas);
        }
        cargando = false;
    }

    // ---- Búsqueda por texto (espera 400 ms después de la última tecla) ----
    private void OnTeclaBusqueda(KeyboardEventArgs e)
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Timers.Timer(400) { AutoReset = false };
        _debounceTimer.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            cargando = true;
            StateHasChanged();
            await CargarPagina(1);
            StateHasChanged();
        });
        _debounceTimer.Start();
    }

    private async Task LimpiarBusqueda()
    {
        textoBusqueda = "";
        await CargarPagina(1);
    }

    // ---- Filtros y orden: siempre vuelven a la página 1 ----
    private async Task ToggleFiltro(int idEtiqueta)
    {
        if (!filtrosActivos.Remove(idEtiqueta))
            filtrosActivos.Add(idEtiqueta);
        await CargarPagina(1);
    }

    private async Task LimpiarFiltros()
    {
        filtrosActivos.Clear();
        await CargarPagina(1);
    }

    private async Task LimpiarTodo()
    {
        filtrosActivos.Clear();
        textoBusqueda = "";
        await CargarPagina(1);
    }

    private async Task CambiarOrden(ChangeEventArgs e)
    {
        orden = e.Value?.ToString() ?? "nombre";
        await CargarPagina(1);
    }

    // ---- Presentación de cada tarjeta ----
    private static bool EsRecomendado(MunicipioExplorarDto m) =>
        m.TotalResenas >= MinimoResenasRecomendado && (m.PromedioCalificacion ?? 0) >= PromedioRecomendado;

    // Usa la descripción real del municipio; si no tiene, arma una frase con sus etiquetas
    private static string Resumen(MunicipioExplorarDto m)
    {
        var texto = !string.IsNullOrWhiteSpace(m.Descripcion)
            ? m.Descripcion.Trim()
            : m.Etiquetas.Any()
                ? $"Un pueblo para vivir {string.Join(" y ", m.Etiquetas.Take(2)).ToLowerInvariant()}, a tu ritmo."
                : "Un rincón de Boyacá con historia, montañas y gente cálida esperando ser descubierto.";

        return texto.Length > 110 ? texto[..107] + "..." : texto;
    }

    // ---- Carrusel de destacados ----
    private void ReiniciarCarrusel()
    {
        _carruselTimer?.Stop();
        _carruselTimer?.Dispose();
        _carruselTimer = null;
        indiceCarrusel = 0;

        if (destacados.Count <= 1) return;

        _carruselTimer = new System.Timers.Timer(4500) { AutoReset = true };
        _carruselTimer.Elapsed += async (_, _) =>
        {
            if (carruselPausado) return;
            indiceCarrusel = (indiceCarrusel + 1) % destacados.Count;
            await InvokeAsync(StateHasChanged);
        };
        _carruselTimer.Start();
    }

    private void IrADestacado(int indice) => indiceCarrusel = indice;

    // ---- Itinerario y navegación ----
    private void ToggleSeleccion(int id)
    {
        if (!seleccionados.Remove(id))
            seleccionados.Add(id);
    }

    private void VerFicha(int id) => Nav.NavigateTo($"/municipios/{id}");

    private void IrACrearItinerario()
    {
        var ids = string.Join(",", seleccionados);
        Nav.NavigateTo($"/itinerarios/crear?municipios={ids}");
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _ctsCarga?.Cancel();
        _ctsCarga?.Dispose();
        _carruselTimer?.Stop();
        _carruselTimer?.Dispose();
    }
}
