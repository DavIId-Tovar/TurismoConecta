@page "/admin/dashboard"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Services
@using TurismoConecta.web.Client.Models
@inject UsuarioApiService UsuarioService
@inject MunicipioApiService MunicipioService
@inject NegocioApiService NegocioService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable
@inject ApiConfig Api

<PageTitle>Centro de Control Maestro | TurismoConecta</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="Pages/Admin/DashboardAdmin.razor.css" />
</HeadContent>

<AuthorizeView Roles="@Roles.AdminGeneral">
    <Authorized Context="authContext">
        <div class="dashboard-admin-page">

            <!-- BARRA SUPERIOR EDITORIAL -->
            <header class="dash-topbar">
                <div class="dash-topbar-inner">
                    <a href="/admin/dashboard" class="dash-brand logo-marco-dorado" title="TurismoConecta">
                        <img src="images/turismo-conecta-logo.png" alt="TurismoConecta" class="dash-logo-img" />
                        <span class="brand-text">TurismoConecta</span>
                    </a>

                    <nav class="dash-nav-links">
                        <a href="/admin/dashboard" class="dash-nav-link activo">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            <span>Panel Maestro</span>
                        </a>
                        <a href="/admin/usuarios" class="dash-nav-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Usuarios & Roles</span>
                        </a>
                        <a href="/municipios" class="dash-nav-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/></svg>
                            <span>Pueblos Mágicos</span>
                        </a>
                        <a href="/establecimientos/pendientes" class="dash-nav-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            <span>Bandeja Aprobación</span>
                            @if (totalPendientes > 0)
                            {
                                <span class="badge-contador-mini">@totalPendientes</span>
                            }
                        </a>
                        <a href="/itinerarios" class="dash-nav-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                            <span>Itinerarios</span>
                        </a>
                    </nav>

                    <div class="dash-topbar-right">
                        <div class="badge-admin-info">
                            <img src="@ObtenerUrlFotoAdmin()" alt="Foto" class="admin-avatar-topbar"
                                 onerror="this.onerror=null;this.style.display='none';" />
                            <span class="admin-label-prefijo">Administrador:</span>
                            <span class="admin-nombre-valor">@ObtenerNombreAdministrador(authContext.User)</span>
                            <span class="admin-rol-tag">@ObtenerRolAdministrador(authContext.User)</span>
                        </div>
                        <button type="button" class="btn-cerrar-sesion" @onclick="CerrarSesion" title="Cerrar Sesión">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Salir</span>
                        </button>
                    </div>
                </div>
            </header>

            <!-- HERO EDITORIAL CON HORIZONTE DE MONTAÑA -->
            <section class="dash-hero">
                <div class="hero-inner">
                    <div class="hero-texto">
                        <span class="hero-eyebrow">Control Maestro &bull; Boyacá, Colombia</span>
                        <h1 class="hero-titulo">Centro de Control Global</h1>
                        <p class="hero-bajada">
                            Supervisa en tiempo real el ecosistema turístico: gestión de autoridades municipales, comercios locales, rutas y patrimonio de Boyacá.
                        </p>
                    </div>

                    <div class="hero-botones">
                        <button class="btn-hero-primario" @onclick='() => Nav.NavigateTo("/municipios/crear")'>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span>Nuevo Pueblo</span>
                        </button>
                        <button class="btn-hero-secundario" @onclick='() => Nav.NavigateTo("/admin/usuarios")'>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Gestionar Usuarios</span>
                        </button>
                    </div>
                </div>

                <svg class="hero-horizonte" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M0,50 L120,25 L260,45 L400,10 L560,38 L720,8 L900,42 L1060,18 L1220,40 L1440,15 L1440,70 L0,70 Z" fill="#FBF9F5" />
                </svg>
            </section>

            <main class="dash-main-container">

                @if (cargando)
                {
                    <div class="cargando-inmersivo">
                        <div class="spinner-anillo-selva"></div>
                        <p class="texto-cargando">Sincronizando métricas y registros de Boyacá...</p>
                    </div>
                }
                else
                {
                    <!-- MÉTRICAS CLAVE (KPIS EDITORIALES) -->
                    <section class="kpis-editorial-grid">
                        <div class="kpi-box" @onclick='() => Nav.NavigateTo("/admin/usuarios")'>
                            <div class="kpi-header">
                                <span class="kpi-num-badge">01</span>
                                <div class="kpi-ico-wrap">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-cuerpo">
                                <span class="kpi-valor">@totalUsuarios</span>
                                <h3 class="kpi-titulo">Directorio de Usuarios</h3>
                                <p class="kpi-sub">Cuentas activas en la plataforma</p>
                            </div>
                            <div class="kpi-footer-link">
                                <span>Administrar permisos &rarr;</span>
                            </div>
                        </div>

                        <div class="kpi-box" @onclick='() => Nav.NavigateTo("/municipios")'>
                            <div class="kpi-header">
                                <span class="kpi-num-badge">02</span>
                                <div class="kpi-ico-wrap">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                                        <line x1="8" y1="2" x2="8" y2="18"/>
                                        <line x1="16" y1="6" x2="16" y2="22"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-cuerpo">
                                <span class="kpi-valor">@totalMunicipios</span>
                                <h3 class="kpi-titulo">Pueblos & Destinos</h3>
                                <p class="kpi-sub">Municipios registrados con ficha</p>
                            </div>
                            <div class="kpi-footer-link">
                                <span>Explorar catálogo &rarr;</span>
                            </div>
                        </div>

                        <div class="kpi-box" @onclick='() => Nav.NavigateTo("/establecimientos/pendientes")'>
                            <div class="kpi-header">
                                <span class="kpi-num-badge">03</span>
                                <div class="kpi-ico-wrap @(totalPendientes > 0 ? "alerta" : "")">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-cuerpo">
                                <span class="kpi-valor @(totalPendientes > 0 ? "destacado-alerta" : "")">@totalPendientes</span>
                                <h3 class="kpi-titulo">Pendientes de Revisión</h3>
                                <p class="kpi-sub">Comercios a la espera de validación</p>
                            </div>
                            <div class="kpi-footer-link">
                                <span>Ver bandeja de verificación &rarr;</span>
                            </div>
                        </div>

                        <div class="kpi-box" @onclick='() => Nav.NavigateTo("/itinerarios")'>
                            <div class="kpi-header">
                                <span class="kpi-num-badge">04</span>
                                <div class="kpi-ico-wrap">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-cuerpo">
                                <span class="kpi-valor">@totalItinerarios</span>
                                <h3 class="kpi-titulo">Rutas & Itinerarios</h3>
                                <p class="kpi-sub">Rutas creadas por viajeros</p>
                            </div>
                            <div class="kpi-footer-link">
                                <span>Ver itinerarios generados &rarr;</span>
                            </div>
                        </div>
                    </section>
                                       

                    <!-- MOTOR DE RECOMENDACIONES (ML.NET) -->
                    <EstadoMotorRecomendaciones />

                    <!-- SECCIÓN PRINCIPAL DE DOS COLUMNAS -->

                    <!-- SECCIÓN PRINCIPAL DE DOS COLUMNAS -->
                    <div class="dash-grid-principal">

                        <!-- COLUMNA IZQUIERDA: DISTRIBUCIÓN Y SOLICITUDES -->
                        <div class="columna-izquierda">

                            <!-- DISTRIBUCIÓN DE ROLES -->
                            <div class="card-editorial-panel">
                                <div class="panel-header-editorial">
                                    <div class="section-badge-title">
                                        <span class="badge-number">01</span>
                                        <div>
                                            <h3>Distribución por Roles</h3>
                                            <span class="section-subtitle">Composición de accesos en el sistema</span>
                                        </div>
                                    </div>
                                    <button class="btn-texto-editorial" @onclick='() => Nav.NavigateTo("/admin/usuarios")'>
                                        Gestionar &rarr;
                                    </button>
                                </div>

                                <div class="roles-lista-editorial">
                                    @foreach (var rolData in distribucionRoles)
                                    {
                                        var pct = totalUsuarios > 0 ? (rolData.Count * 100 / totalUsuarios) : 0;
                                        <div class="rol-fila-item">
                                            <div class="rol-fila-header">
                                                <div class="rol-tag-nombre">
                                                    <span class="chip-rol-mini @rolData.Nombre.ToLower()">@rolData.Nombre</span>
                                                    <span class="rol-desc-sutil">@ObtenerDescripcionRol(rolData.Nombre)</span>
                                                </div>
                                                <div class="rol-cifras">
                                                    <strong>@rolData.Count</strong> <span class="texto-sutil">(@pct%)</span>
                                                </div>
                                            </div>
                                            <div class="barra-progreso-editorial">
                                                <div class="barra-fill @rolData.Nombre.ToLower()" style="width: @pct%"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- SOLICITUDES PENDIENTES DE REVISIÓN -->
                            <div class="card-editorial-panel mt-28">
                                <div class="panel-header-editorial">
                                    <div class="section-badge-title">
                                        <span class="badge-number">02</span>
                                        <div>
                                            <h3>Bandeja de Comercios</h3>
                                            <span class="section-subtitle">Solicitudes recientes de prestadores turísticos</span>
                                        </div>
                                    </div>
                                    <button class="btn-texto-editorial" @onclick='() => Nav.NavigateTo("/establecimientos/pendientes")'>
                                        Ver Bandeja Completa &rarr;
                                    </button>
                                </div>

                                @if (!ultimosPendientes.Any())
                                {
                                    <div class="empty-panel-clean">
                                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="empty-ico">
                                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                            <polyline points="22 4 12 14.01 9 11.01"/>
                                        </svg>
                                        <p class="empty-titulo">No hay solicitudes pendientes</p>
                                        <p class="empty-sub">Todos los establecimientos comerciales registrados han sido verificados.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="tabla-editorial-wrap">
                                        <table class="tabla-editorial">
                                            <thead>
                                                <tr>
                                                    <th>Establecimiento</th>
                                                    <th>Categoría</th>
                                                    <th>Propietario</th>
                                                    <th>Fecha</th>
                                                    <th style="text-align: right;">Acción</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in ultimosPendientes.Take(4))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="negocio-item-celda">
                                                                <span class="negocio-nombre">@p.Nombre</span>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <span class="badge-categoria-clean">@p.NombreCategoria</span>
                                                        </td>
                                                        <td class="texto-sutil">
                                                            @(string.IsNullOrWhiteSpace(p.NombrePropietario) ? "Prestador" : p.NombrePropietario)
                                                        </td>
                                                        <td class="texto-sutil">
                                                            @(p.FechaRegistro?.ToString("dd/MM/yyyy") ?? "-")
                                                        </td>
                                                        <td style="text-align: right;">
                                                            <button class="btn-revisar-mini" @onclick='() => Nav.NavigateTo("/establecimientos/pendientes")'>
                                                                Revisar
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- COLUMNA DERECHA: ACCESOS RÁPIDOS Y PUEBLOS -->
                        <div class="columna-derecha">

                            <!-- ACCESOS RÁPIDOS PRINCIPALES -->
                            <div class="card-editorial-panel">
                                <div class="panel-header-editorial">
                                    <div class="section-badge-title">
                                        <span class="badge-number">03</span>
                                        <div>
                                            <h3>Operaciones Maestras</h3>
                                            <span class="section-subtitle">Accesos directos de administración</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="accesos-grid-editorial">
                                    <div class="acceso-card-editorial" @onclick='() => Nav.NavigateTo("/admin/usuarios")'>
                                        <div class="acceso-ico-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                                <circle cx="9" cy="7" r="4"/>
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                            </svg>
                                        </div>
                                        <div class="acceso-info">
                                            <h4>Usuarios & Roles</h4>
                                            <p>Asigna permisos y municipios a gestores locales</p>
                                        </div>
                                    </div>

                                    <div class="acceso-card-editorial" @onclick='() => Nav.NavigateTo("/municipios/crear")'>
                                        <div class="acceso-ico-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="12" y1="5" x2="12" y2="19"/>
                                                <line x1="5" y1="12" x2="19" y2="12"/>
                                            </svg>
                                        </div>
                                        <div class="acceso-info">
                                            <h4>Crear Municipio</h4>
                                            <p>Publica un nuevo pueblo con portadas y tradiciones</p>
                                        </div>
                                    </div>

                                    <div class="acceso-card-editorial" @onclick='() => Nav.NavigateTo("/establecimientos/pendientes")'>
                                        <div class="acceso-ico-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M9 11l3 3L22 4"/>
                                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                                            </svg>
                                        </div>
                                        <div class="acceso-info">
                                            <h4>Aprobación Global</h4>
                                            <p>Valida comercios y hospedajes en Boyacá</p>
                                        </div>
                                    </div>

                                    <div class="acceso-card-editorial" @onclick='() => Nav.NavigateTo("/itinerarios")'>
                                        <div class="acceso-ico-box">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                                            </svg>
                                        </div>
                                        <div class="acceso-info">
                                            <h4>Itinerarios de Viaje</h4>
                                            <p>Explora y gestiona rutas turísticas generadas</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- VISTA PREVIA RÁPIDA DE PUEBLOS MÁGICOS -->
                            @if (municipiosMuestra.Any())
                            {
                                <div class="card-editorial-panel mt-28">
                                    <div class="panel-header-editorial">
                                        <div class="section-badge-title">
                                            <span class="badge-number">04</span>
                                            <div>
                                                <h3>Destinos Destacados</h3>
                                                <span class="section-subtitle">Pueblos registrados en Boyacá</span>
                                            </div>
                                        </div>
                                        <button class="btn-texto-editorial" @onclick='() => Nav.NavigateTo("/municipios")'>
                                            Ver Todos (@totalMunicipios) &rarr;
                                        </button>
                                    </div>

                                    <div class="municipios-mini-lista">
                                        @foreach (var m in municipiosMuestra.Take(3))
                                        {
                                            <div class="muni-mini-card" @onclick='() => Nav.NavigateTo($"/municipios/{m.IdMunicipio}")'>
                                                <img src="@(string.IsNullOrWhiteSpace(m.ImagenUrl) ? "https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=300&auto=format&fit=crop" : m.ImagenUrl)"
                                                     alt="@m.Nombre" class="muni-mini-img" />
                                                <div class="muni-mini-info">
                                                    <span class="muni-mini-nombre">@m.Nombre</span>
                                                    <div class="muni-mini-tags">
                                                        @foreach (var tag in (m.Etiquetas ?? new List<string>()).Take(2))
                                                        {
                                                            <span class="mini-tag">@tag</span>
                                                        }
                                                    </div>
                                                </div>
                                                <button class="btn-muni-editar" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"/municipios/{m.IdMunicipio}/editar")' title="Editar ficha de @m.Nombre">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                        </div>

                    </div>
                }

            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <AccesoRestringido>
            Se requieren privilegios de <strong>Superadministrador</strong> para acceder al Centro de Control.
        </AccesoRestringido>
    </NotAuthorized>
</AuthorizeView>

<!-- TOAST FLOTANTE DINÁMICO -->
@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="floating-toast-clean @(esError ? "toast-error" : "toast-success")">
        <div class="toast-indicator"></div>
        <div class="toast-content">
            <div class="toast-header-flex">
                <span class="toast-title">@(esError ? "Aviso del Sistema" : tituloAlerta ?? "Operación Exitosa")</span>
                <button type="button" class="btn-cerrar-toast" @onclick="CerrarAlerta">✕</button>
            </div>
            <p class="toast-desc">@mensajeAlerta</p>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private int totalUsuarios;
    private int totalMunicipios;
    private int totalPendientes;
    private int totalItinerarios = 12; // Valor estimado o cargado
    private List<NegocioPendienteAprobacionDto> ultimosPendientes = new();
    private List<MunicipioListadoDto> municipiosMuestra = new();
    private List<(string Nombre, int Count)> distribucionRoles = new();
    private PerfilResponse? perfilAdmin;

    // Toast flotante
    private string? mensajeAlerta;
    private string? tituloAlerta;
    private bool esError = false;
    private CancellationTokenSource? _toastCts;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            var taskPerfil = UsuarioService.ObtenerPerfilAsync();
            var taskUsuarios = UsuarioService.ListarUsuariosAsync();
            var taskRoles = UsuarioService.ListarRolesAsync();
            var taskMunicipios = MunicipioService.ListarAsync(1, 20);
            var taskPendientes = NegocioService.ListarPendientesAsync();

            await Task.WhenAll(taskPerfil, taskUsuarios, taskRoles, taskMunicipios, taskPendientes);

            perfilAdmin = taskPerfil.Result;
            var usuarios = taskUsuarios.Result;
            var roles = taskRoles.Result;
            var municipios = taskMunicipios.Result;
            var pendientes = taskPendientes.Result;

            totalUsuarios = usuarios.Count;
            totalMunicipios = municipios?.Total ?? 0;
            totalPendientes = pendientes.Count;
            ultimosPendientes = pendientes;
            municipiosMuestra = municipios?.Items ?? new List<MunicipioListadoDto>();

            distribucionRoles = roles
                .Select(r => (r.Nombre, Count: usuarios.Count(u => u.Rol == r.Nombre)))
                .ToList();
        }
        catch (Exception ex)
        {
            MostrarToast("Error al cargar datos del panel maestro: " + ex.Message, error: true, titulo: "Error de Conexión");
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerDescripcionRol(string nombreRol)
    {
        return nombreRol switch
        {
            Roles.AdminGeneral => "Superadministrador global",
            Roles.AdminMunicipio=> "Gestor municipal asignado",
            Roles.AdminEstablecimiento => "Prestador y comercio local",
            Roles.Usuario=> "Viajero y explorador",
            _ => "Usuario de la plataforma"
        };
    }

    private void MostrarToast(string mensaje, bool error = false, string? titulo = null)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();

        mensajeAlerta = mensaje;
        esError = error;
        tituloAlerta = titulo;
        StateHasChanged();

        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        mensajeAlerta = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private void CerrarAlerta()
    {
        _toastCts?.Cancel();
        mensajeAlerta = null;
    }

    private string ObtenerNombreAdministrador(System.Security.Claims.ClaimsPrincipal user)
    {
        var nombre = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(nombre)) return nombre;

        var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                 ?? user.FindFirst("email")?.Value;
        if (!string.IsNullOrWhiteSpace(email)) return email;

        return "Administrador";
    }

    private string ObtenerRolAdministrador(System.Security.Claims.ClaimsPrincipal user)
    {
        var rol = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
               ?? user.FindFirst("role")?.Value;
        return string.IsNullOrWhiteSpace(rol) ? "Superadmin" : rol;
    }

    private string ObtenerUrlFotoAdmin()
    {
        var fotoUrl = perfilAdmin?.FotoUrl;
        var nombre = perfilAdmin != null ? $"{perfilAdmin.Nombre} {perfilAdmin.Apellido}" : "Admin";
        if (string.IsNullOrWhiteSpace(fotoUrl))
            return $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(nombre)}&background=213b31&color=fff&size=80";
        return Api.Url(fotoUrl);
    }

    private async Task CerrarSesion()
    {
        if (AuthStateProvider is JwtAuthStateProvider jwt)
            await jwt.CerrarSesionAsync();

        // replace: la página privada desaparece del historial → "Atrás" ya no vuelve a ella
        Nav.NavigateTo("/login", forceLoad: true, replace: true);
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
