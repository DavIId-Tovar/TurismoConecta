@page "/comercio/dashboard"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@using TurismoConecta.web.Client.Services
@using TurismoConecta.web.Client.Models
@inject NegocioApiService NegocioService
@inject NotificacionTiempoRealService Notif
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Panel Comerciante | TurismoConecta</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="Pages/Comercio/DashboardComercio.razor.css" />
</HeadContent>

<AuthorizeView Roles="@Roles.GeneralOEstablecimiento">
    <Authorized Context="authContext">
        <div class="dashboard-comercio-page">

            <!-- TOPBAR -->
            <header class="comercio-topbar">
                <div class="comercio-topbar-inner">
                    <a href="/" class="logo-marco-dorado" title="TurismoConecta">
                        <img src="images/turismo-conecta-logo.png" alt="Turismo Conecta" class="topbar-logo-img" />
                    </a>
                    <nav class="comercio-nav-links">
                        <a href="/mis-establecimientos" class="comercio-nav-link">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            <span>Mis Establecimientos</span>
                        </a>
                        <a href="/establecimientos/crear" class="comercio-nav-link">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span>Nuevo Registro</span>
                        </a>
                        <a href="/itinerarios" class="comercio-nav-link">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                            <span>Itinerarios</span>
                        </a>
                    </nav>
                    <div class="comercio-topbar-right">
                        <CampanaNotificaciones />
                        <span class="badge-comercio">Comerciante</span>
                        <a href="/perfil" class="comercio-avatar-link">
                            @authContext.User.Identity?.Name?.Split(' ').FirstOrDefault() ?? "Mi Cuenta"
                        </a>
                        <button type="button" class="btn-cerrar-sesion" @onclick="CerrarSesion" title="Cerrar Sesión">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Salir</span>
                        </button>
                    </div>
                </div>
            </header>

            <main class="comercio-main">

                <!-- BIENVENIDA PERSONALIZADA -->
                <div class="comercio-bienvenida">
                    <div class="bienvenida-texto">
                        <span class="eyebrow">Panel del Comerciante</span>
                        <h1 class="titulo-editorial">
                            Bienvenido, <em>@authContext.User.Identity?.Name?.Split(' ').FirstOrDefault()</em>
                        </h1>
                        <p class="bajada">
                            Administra tus negocios y llega a miles de turistas que exploran los pueblos de Boyacá.
                        </p>
                    </div>
                    <div class="bienvenida-actions">
                        <button class="btn-crear-comercio" @onclick='() => Nav.NavigateTo("/establecimientos/crear")'>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: -2px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            Registrar Nuevo Establecimiento
                        </button>
                        <button class="btn-ver-todos-comercio" @onclick='() => Nav.NavigateTo("/mis-establecimientos")'>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: -2px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Ver Mis Negocios
                        </button>
                    </div>
                </div>

                @if (cargando)
                {
                    <div class="cargando-comercio">
                        <div class="spinner-comercio"></div>
                        <p>Cargando tus establecimientos...</p>
                    </div>
                }
                else
                {
                    <!-- KPIs COMERCIO -->
                    <div class="comercio-kpi-grid">
                        <div class="comercio-kpi total-kpi">
                            <div class="comercio-kpi-ico">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            </div>
                            <div class="comercio-kpi-num">@misNegocios.Count</div>
                            <div class="comercio-kpi-lbl">Total Registrados</div>
                        </div>
                        <div class="comercio-kpi activos-kpi">
                            <div class="comercio-kpi-ico">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            </div>
                            <div class="comercio-kpi-num">@misNegocios.Count(n => n.Estado == EstadosNegocio.Aprobado)</div>
                            <div class="comercio-kpi-lbl">Activos y Visibles</div>
                        </div>
                        <div class="comercio-kpi revision-kpi">
                            <div class="comercio-kpi-ico">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <div class="comercio-kpi-num">@misNegocios.Count(n => n.Estado == EstadosNegocio.Pendiente)</div>
                            <div class="comercio-kpi-lbl">En Revisión</div>
                        </div>
                        <div class="comercio-kpi rechazo-kpi">
                            <div class="comercio-kpi-ico">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            </div>
                            <div class="comercio-kpi-num">@misNegocios.Count(n => n.Estado == EstadosNegocio.Rechazado)</div>
                            <div class="comercio-kpi-lbl">Rechazados</div>
                        </div>
                    </div>

                    <!-- PANEL PRINCIPAL -->
                    <div class="comercio-panel-doble">

                        <!-- Lista de negocios -->
                        <div class="comercio-card comercio-card-grande">
                            <div class="comercio-card-header">
                                <h2 class="comercio-card-titulo">Mis Establecimientos</h2>
                                <button class="btn-link-comercio" @onclick='() => Nav.NavigateTo("/mis-establecimientos")'>
                                    Ver todos →
                                </button>
                            </div>

                            @if (!misNegocios.Any())
                            {
                                <div class="comercio-vacio">
                                    <div class="comercio-vacio-ico">
                                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    </div>
                                    <h3>Aún no tienes establecimientos</h3>
                                    <p>Registra tu primer negocio y llega a miles de turistas.</p>
                                    <button class="btn-crear-comercio" @onclick='() => Nav.NavigateTo("/establecimientos/crear")'>
                                        Registrar mi primer negocio
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="comercio-negocios-lista">
                                    @foreach (var n in misNegocios.Take(4))
                                    {
                                        <div class="comercio-negocio-row" @onclick='() => Nav.NavigateTo($"/establecimientos/editar/{n.IdNegocio}")'>
                                            <img src="@(string.IsNullOrWhiteSpace(n.Portada) ? "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=200" : n.Portada)"
                                                 alt="@n.Nombre" class="comercio-negocio-thumb" />
                                            <div class="comercio-negocio-info">
                                                <div class="comercio-negocio-nombre">@n.Nombre</div>
                                                <div class="comercio-negocio-meta">
                                                    <span>@n.NombreCategoria</span>
                                                    @if (!string.IsNullOrWhiteSpace(n.Direccion))
                                                    {
                                                        <span>· @n.Direccion</span>
                                                    }
                                                </div>
                                            </div>
                                            <span class="estado-chip @n.Estado.ToLower()">@n.Estado</span>
                                            <span class="comercio-arrow">→</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Sidebar: Accesos rápidos y consejos -->
                        <div class="comercio-sidebar">
                            <div class="comercio-card">
                                <h2 class="comercio-card-titulo">Acciones Rápidas</h2>
                                <div class="comercio-acciones">
                                    <button class="comercio-accion" @onclick='() => Nav.NavigateTo("/establecimientos/crear")'>
                                        <span class="accion-ico">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                        </span>
                                        <span>Registrar establecimiento</span>
                                    </button>
                                    <button class="comercio-accion" @onclick='() => Nav.NavigateTo("/mis-establecimientos")'>
                                        <span class="accion-ico">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                        </span>
                                        <span>Ver todos mis negocios</span>
                                    </button>
                                    <button class="comercio-accion" @onclick='() => Nav.NavigateTo("/perfil")'>
                                        <span class="accion-ico">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                        </span>
                                        <span>Editar mi perfil</span>
                                    </button>
                                    <button class="comercio-accion" @onclick='() => Nav.NavigateTo("/")'>
                                        <span class="accion-ico">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                        </span>
                                        <span>Ver portal público</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Consejos de visibilidad -->
                            <div class="comercio-card comercio-consejos">
                                <h2 class="comercio-card-titulo">Consejos de Visibilidad</h2>
                                <ul class="consejos-lista">
                                    <li>Agrega fotos de alta calidad a tu galería</li>
                                    <li>Completa el horario de atención</li>
                                    <li>Incluye teléfono y redes sociales</li>
                                    <li>Describe bien tus servicios y experiencias</li>
                                    <li>Actualiza la información regularmente</li>
                                </ul>
                            </div>

                            @if (misNegocios.Any(n => n.Estado == EstadosNegocio.Pendiente))
                            {
                                <div class="comercio-card aviso-pendiente">
                                    <div class="aviso-ico">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    </div>
                                    <div class="aviso-texto">
                                        <strong>@misNegocios.Count(n => n.Estado == EstadosNegocio.Pendiente) establecimiento(s) en revisión</strong>
                                        <p>La alcaldía municipal está verificando tu información. Te notificaremos cuando sea aprobado.</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- RESEÑAS DE MIS ESTABLECIMIENTOS (HU-29) -->
                    <div class="comercio-card comercio-card-resenas">
                        <h2 class="comercio-card-titulo">Reseñas de mis establecimientos</h2>
                        <PanelResenasComercio />
                    </div>
                }
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="sin-acceso-comercio">
            <h2>Acceso Restringido</h2>
            <p>Necesitas una cuenta de <strong>Comerciante</strong> para acceder.</p>
            <button @onclick='() => Nav.NavigateTo("/login")'>Iniciar Sesión</button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool cargando = true;
    private List<NegocioItemDto> misNegocios = new();

    protected override async Task OnInitializedAsync()
    {
        // ◆ Escuchar avisos en tiempo real
        Notif.NotificacionRecibida += AlRecibirNotificacion;

        await CargarMisNegociosAsync();
    }

    // ◆ La carga en un método aparte, para repetirla cuando llegue un aviso.
    //   mostrarCargando = false → recarga sin spinner (la página no "parpadea").
    private async Task CargarMisNegociosAsync(bool mostrarCargando = true)
    {
        if (mostrarCargando) cargando = true;
        try
        {
            misNegocios = await NegocioService.ListarMisNegociosAsync();
        }
        catch { }
        finally
        {
            cargando = false;
        }
    }

    // ◆ Si el admin municipal aprobó o rechazó, recargamos los KPIs y los chips de estado
    private void AlRecibirNotificacion(NotificacionDto notificacion)
    {
        if (notificacion.Codigo != CodigosNotificacion.NegocioAprobado &&
            notificacion.Codigo != CodigosNotificacion.NegocioRechazado) return;

        _ = InvokeAsync(async () =>
        {
            await CargarMisNegociosAsync(mostrarCargando: false);
            StateHasChanged();
        });
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("borrarToken");
        if (AuthStateProvider is JwtAuthStateProvider jwt)
        {
            jwt.NotificarCambioAutenticacion();
        }
        Nav.NavigateTo("/login", forceLoad: true);
    }

    // ◆ Obligatorio por @implements IDisposable
    public void Dispose()
    {
        Notif.NotificacionRecibida -= AlRecibirNotificacion;
    }
}
