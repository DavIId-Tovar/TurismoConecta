@page "/itinerarios/crear"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Services
@inject ItinerarioApiService ItiApi
@inject MunicipioApiService MuniApi
@inject RecomendacionApiService RecoService
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="itinerario-page">

    
    @if (cargandoInicial || guardando)
    {
        <div class="pantalla-espera-inmersiva">
            <img src="@paisajeEspera.Url" alt="Boyacá" class="espera-bg-img" />
            <div class="espera-scrim">
                <div class="espera-contenido">
                    <span class="espera-eyebrow">Planificador de Viaje</span>
                    <h2 class="espera-lugar">@paisajeEspera.Lugar</h2>
                    <p class="espera-cita">"@paisajeEspera.Frase"</p>
                    <div class="espera-indicador">
                        <div class="spinner-anillo-selva"></div>
                        <span class="espera-texto-progreso">
                            @(guardando ? "Creando tu itinerario por Boyacá..." : "Cargando tus pueblos elegidos...")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* MODAL DE DETALLE DEL MUNICIPIO *@
    @if (municipioModal != null)
    {
        <div class="modal-backdrop" @onclick="CerrarModal">
            <div class="modal-card-municipio" @onclick:stopPropagation="true">
                <div class="modal-banner-wrap">
                    <img src="@ObtenerFotoPrincipal(municipioModal)"
                         alt="@municipioModal.Nombre"
                         class="modal-banner-foto"
                         onerror="this.onerror=null; this.src='@ObtenerFotoFallback(municipioModal)';" />
                    <div class="modal-banner-scrim">
                        <span class="modal-banner-tag">Destino Boyacense</span>
                        <h2 class="modal-banner-nombre">@municipioModal.Nombre</h2>
                        @if (!string.IsNullOrWhiteSpace(municipioModal.Clima))
                        {
                            <p class="modal-banner-clima">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;">
                                    <circle cx="12" cy="12" r="5"/>
                                    <line x1="12" y1="1" x2="12" y2="3"/>
                                    <line x1="12" y1="21" x2="12" y2="23"/>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                                    <line x1="1" y1="12" x2="3" y2="12"/>
                                    <line x1="21" y1="12" x2="23" y2="12"/>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                                </svg>
                                @municipioModal.Clima
                            </p>
                        }
                    </div>
                    <button type="button" class="modal-btn-cerrar" @onclick="CerrarModal" title="Cerrar">✕</button>
                </div>

                <div class="modal-cuerpo">
                    @if (municipioModal.Etiquetas != null && municipioModal.Etiquetas.Any())
                    {
                        <div class="modal-etiquetas-pills">
                            @foreach (var tag in municipioModal.Etiquetas)
                            {
                                <span class="pill-experiencia">✦ @tag</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(municipioModal.Descripcion))
                    {
                        <div class="modal-seccion">
                            <span class="modal-seccion-label">Sobre este pueblo</span>
                            <p class="modal-seccion-texto">@municipioModal.Descripcion</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(municipioModal.Historia))
                    {
                        <div class="modal-seccion">
                            <span class="modal-seccion-label">Historia y Tradición</span>
                            <p class="modal-seccion-texto modal-historia">@municipioModal.Historia</p>
                        </div>
                    }

                    @if (municipioModal.FechasRelevantes != null && municipioModal.FechasRelevantes.Any())
                    {
                        <div class="modal-seccion">
                            <span class="modal-seccion-label">Festividades Destacadas</span>
                            <div class="modal-festividades-grid">
                                @foreach (var fest in municipioModal.FechasRelevantes)
                                {
                                    <div class="modal-fest-card">
                                        <strong>@fest.NombreFestividad</strong>
                                        <span>@(string.IsNullOrWhiteSpace(fest.TipoFestividad) ? "Cultural" : fest.TipoFestividad)</span>
                                        @if (fest.FechaInicio != default)
                                        {
                                            <span class="fest-fecha">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;">
                                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                                    <line x1="16" y1="2" x2="16" y2="6"/>
                                                    <line x1="8" y1="2" x2="8" y2="6"/>
                                                    <line x1="3" y1="10" x2="21" y2="10"/>
                                                </svg>
                                                @fest.FechaInicio.ToString("MMMM yyyy")
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="modal-footer-acciones">
                        <a href="/municipios/@municipioModal.IdMunicipio" target="_blank" class="enlace-ficha-completa">
                            Ver ficha turística completa ↗
                        </a>
                        <button type="button" class="btn-guardar-iti" @onclick="CerrarModal">
                            ← Volver al itinerario
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* MODAL DE BÚSQUEDA PARA AGREGAR MUNICIPIOS *@
    @if (modalAgregarAbierto)
    {
        <div class="modal-backdrop" @onclick="CerrarModalAgregar">
            <div class="modal-agregar-municipio" @onclick:stopPropagation="true">
                <div class="modal-agregar-header">
                    <h3>Agregar pueblos a tu ruta</h3>
                    <button type="button" class="modal-btn-cerrar" @onclick="CerrarModalAgregar">✕</button>
                </div>

                <div class="modal-agregar-busqueda">
                    <input type="text"
                           class="input-buscar-modal"
                           placeholder="Busca un pueblo boyacense: Monguí, Nobsa, Arcabuco..."
                           value="@textoBusquedaAgregar"
                           @oninput="async (e) => { textoBusquedaAgregar = e.Value?.ToString() ?? string.Empty; await BuscarMunicipiosParaAgregar(); }" />
                </div>

                @if (cargandoBusqueda)
                {
                    <div class="modal-agregar-estado">
                        <div class="spinner-mini"></div>
                        <span>Buscando...</span>
                    </div>
                }
                else if (resultadosBusqueda.Any())
                {
                    <div class="modal-agregar-resultados">
                        @foreach (var m in resultadosBusqueda)
                        {
                            var yaEnRuta = municipiosSeleccionados.Any(s => s.IdMunicipio == m.IdMunicipio);
                            <div class="resultado-item @(yaEnRuta ? "resultado-item-ya" : "")"
                                 @onclick="() => AgregarMunicipioDesdeModal(m.IdMunicipio)">
                                <img src="@ObtenerFotoListado(m)"
                                     alt="@m.Nombre"
                                     class="resultado-miniatura"
                                     onerror="this.onerror=null; this.src='@FotoFallback';" />
                                <div class="resultado-info">
                                    <span class="resultado-nombre">@m.Nombre</span>
                                    @if (m.Etiquetas != null && m.Etiquetas.Any())
                                    {
                                        <span class="resultado-tags">@string.Join(" · ", m.Etiquetas.Take(2))</span>
                                    }
                                    @* Lo marcó "No me interesa": se puede agregar igual, o volver a recomendarlo *@
                                    @if (idsOcultados.Contains(m.IdMunicipio))
                                    {
                                        <span class="resultado-oculto">
                                            <i class="ph ph-eye-slash" aria-hidden="true"></i>
                                            Lo ocultaste de tus recomendaciones
                                            <button type="button" class="resultado-reincorporar"
                                                    disabled="@(idReincorporando == m.IdMunicipio)"
                                                    @onclick="() => ReincorporarAsync(m.IdMunicipio)"
                                                    @onclick:stopPropagation="true">
                                                @(idReincorporando == m.IdMunicipio ? "…" : "Volver a recomendar")
                                            </button>
                                        </span>
                                    }
                                </div>
                                @if (yaEnRuta)
                                {
                                    <span class="resultado-badge-ya">✓ En tu ruta</span>
                                }
                                else
                                {
                                    <span class="resultado-badge-add">+ Añadir</span>
                                }
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(textoBusquedaAgregar))
                {
                    <div class="modal-agregar-estado">
                        <span>No encontramos resultados para "<strong>@textoBusquedaAgregar</strong>"</span>
                    </div>
                }
                else
                {
                    <div class="modal-agregar-sugerencias">
                        <p>Escribe el nombre de un municipio para añadirlo a tu ruta.</p>
                        <div class="sugerencias-chips">
                            @foreach (var sugerido in new[] { "Monguí", "Villa de Leyva", "Nobsa", "Arcabuco", "Tibaná" })
                            {
                                var s = sugerido;
                                <button type="button" class="chip-sugerencia"
                                        @onclick="async () => { textoBusquedaAgregar = s; await BuscarMunicipiosParaAgregar(); }">
                                    @sugerido
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* CONTENIDO PRINCIPAL *@
    <header class="itinerario-nav">
        <button type="button" class="nav-back-link" @onclick="Volver">
            <span class="nav-back-arrow">←</span> Volver al Panel
        </button>
        <a href="/" class="logo-marco-dorado" title="TurismoConecta">
            <img src="images/turismo-conecta-logo.png" alt="TurismoConecta" class="topbar-logo-img" />
        </a>
        <span class="nav-badge-estado">Tu Hoja de Ruta</span>
    </header>

    <div class="itinerario-container">
        <header class="itinerario-header">
            <span class="itinerario-eyebrow">Aventura en Boyacá</span>
            <h1 class="itinerario-titulo">Diseña tu Itinerario</h1>
            <p class="itinerario-subtitulo">
                Personaliza fechas y paradas. Haz clic en un pueblo para ver toda su información.
            </p>
        </header>

        @if (!usuarioAutenticado && !cargandoInicial)
        {
            <div class="alerta-auth-aviso">
                <span class="alerta-auth-icono">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <div class="alerta-auth-contenido">
                    <span class="alerta-auth-titulo">Debes iniciar sesión para crear tu itinerario</span>
                    <p class="alerta-auth-desc">
                        Organiza tus fechas y paradas ahora. Para guardar la ruta en tu cuenta, inicia sesión o regístrate.
                    </p>
                </div>
                <div class="alerta-auth-botones">
                    <a href="/login" class="btn-auth-iti-login">Iniciar Sesión →</a>
                    <a href="/register" class="btn-auth-iti-registro">Registrarse</a>
                </div>
            </div>
        }

        <EditForm Model="modelo" OnValidSubmit="GuardarItinerario">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alerta-error-itinerario">
                    <span class="alerta-error-icono">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </span>
                    <div class="alerta-error-cuerpo">
                        <p class="alerta-error-texto">@mensajeError</p>
                        @if (mensajeError.Contains("iniciar sesión", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="alerta-error-acciones">
                                <a href="/login" class="btn-alerta-login">Iniciar Sesión →</a>
                                <a href="/register" class="btn-alerta-registro-sutil">¿No tienes cuenta? Regístrate</a>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="itinerario-layout-grid">

                <!-- COLUMNA IZQUIERDA: DATOS GENERALES -->
                <div class="card-itinerario">
                    <div class="card-header-badge">
                        <span class="badge-num">01</span>
                        <h3>Datos Generales del Viaje</h3>
                    </div>

                    <div class="form-group-iti">
                        <label>Nombre del Itinerario *</label>
                        <InputText @bind-Value="modelo.Nombre" class="input-iti"
                                   placeholder="Ej. Ruta del Páramo y Aguas Termales" />
                        <ValidationMessage For="@(() => modelo.Nombre)" class="error-msg" />
                    </div>

                    <div class="form-grid-dos">
                        <div class="form-group-iti">
                            <label>Fecha de Inicio</label>
                            <InputDate @bind-Value="modelo.FechaInicio" class="input-iti" />
                        </div>
                        <div class="form-group-iti">
                            <label>Fecha de Regreso</label>
                            <InputDate @bind-Value="modelo.FechaFin" class="input-iti" />
                        </div>
                    </div>

                    @if (modelo.FechaInicio.HasValue && modelo.FechaFin.HasValue && modelo.FechaFin >= modelo.FechaInicio)
                    {
                        var dias = (modelo.FechaFin.Value.DayNumber - modelo.FechaInicio.Value.DayNumber) + 1;
                        <div class="info-duracion-pill">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 4px;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            Duración estimada: <strong>@dias @(dias == 1 ? "día" : "días") de viaje</strong>
                        </div>
                    }

                    <div class="form-group-iti">
                        <label>Notas y Recomendaciones</label>
                        <InputTextArea @bind-Value="modelo.Observaciones" class="textarea-iti" rows="5"
                                       placeholder="Hospedajes sugeridos, gastronomía, actividades especiales..." />
                    </div>
                </div>

                <!-- COLUMNA DERECHA: PARADAS -->
                <div class="card-itinerario">
                    <div class="card-header-badge">
                        <span class="badge-num">02</span>
                        <div class="card-title-group">
                            <h3>Pueblos en tu Ruta</h3>
                            <span class="card-subtitle">
                                @municipiosSeleccionados.Count parada@(municipiosSeleccionados.Count != 1 ? "s" : "") • Clic para explorar
                            </span>
                        </div>
                    </div>

                    @* ============ SORPRÉNDEME: arma la ruta con las recomendaciones ============ *@
                    <div class="sorpresa-barra" aria-live="polite">
                        @if (confirmandoSorpresa)
                        {
                            <div class="sorpresa-confirmar">
                                <span>Esto reemplaza tus @municipiosSeleccionados.Count parada(s) actuales. ¿Continuar?</span>
                                <div class="sorpresa-botones">
                                    <button type="button" class="sorpresa-btn" @onclick="() => GenerarSorpresaAsync(variantePendiente)">Sí, sorpréndeme</button>
                                    <button type="button" class="sorpresa-btn-texto" @onclick="() => confirmandoSorpresa = false">Cancelar</button>
                                </div>
                            </div>
                        }
                        else if (propuesta is not null && RutaEsLaPropuesta)
                        {
                            <div class="sorpresa-resumen">
                                <span class="sorpresa-titulo"><i class="ph-fill ph-sparkle" aria-hidden="true"></i> Ruta sorpresa</span>
                                <span class="sorpresa-datos">
                                    @propuesta.Paradas.Count parada@(propuesta.Paradas.Count != 1 ? "s" : "")
                                    @if (propuesta.KmTotal > 0)
                                    {
                                        <span> · ~@propuesta.KmTotal km · @Duracion(propuesta.MinutosTotal) de carretera</span>
                                    }
                                </span>
                                @if (propuesta.OpcionesDeInicio > 1)
                                {
                                    <button type="button" class="sorpresa-btn-texto" disabled="@generandoSorpresa"
                                            @onclick="() => GenerarSorpresaAsync(varianteSorpresa + 1)">
                                        <i class="ph ph-shuffle" aria-hidden="true"></i>
                                        @(generandoSorpresa ? "Buscando…" : "Otra sorpresa")
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(propuesta.Aviso))
                            {
                                <p class="sorpresa-aviso"><i class="ph ph-info" aria-hidden="true"></i> @propuesta.Aviso</p>
                            }
                        }
                        else
                        {
                            <button type="button" class="sorpresa-btn sorpresa-btn-principal" disabled="@generandoSorpresa"
                                    @onclick="() => PedirSorpresaAsync(0)">
                                <i class="ph-fill ph-sparkle" aria-hidden="true"></i>
                                @(generandoSorpresa ? "Armando tu ruta…" : "Sorpréndeme")
                            </button>
                            <span class="sorpresa-ayuda">
                                @(municipiosSeleccionados.Any()
                                    ? "Arma otra ruta con tus recomendaciones."
                                    : $"¿No sabes por dónde empezar? Armamos una ruta de {DiasDelViaje} día(s) con lo que te gusta.")
                            </span>
                        }

                        @if (errorSorpresa is not null)
                        {
                            <p class="sorpresa-aviso error"><i class="ph ph-warning-circle" aria-hidden="true"></i> @errorSorpresa</p>
                        }
                    </div>

                    @if (municipiosSeleccionados.Any())
                    {
                        <div class="lista-paradas-cards">
                            @for (int i = 0; i < municipiosSeleccionados.Count; i++)
                            {
                                var idx = i;
                                var muni = municipiosSeleccionados[idx];

                                <div class="parada-card-item" @key="muni.IdMunicipio" @onclick="() => AbrirModal(muni)">
                                    <div class="parada-orden">@(idx + 1)</div>

                                    <img src="@ObtenerFotoPrincipal(muni)"
                                         alt="@muni.Nombre"
                                         class="parada-miniatura"
                                         onerror="this.onerror=null; this.src='@ObtenerFotoFallback(muni)';" />

                                    <div class="parada-detalles">
                                        <div class="parada-titulo-row">
                                            <h4 class="parada-nombre">@muni.Nombre</h4>
                                            <span class="badge-expandir">▼ Ver info</span>
                                        </div>
                                        <span class="parada-clima" title="@(string.IsNullOrWhiteSpace(muni.Clima) ? "Clima de montaña" : muni.Clima)">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;">
                                                <circle cx="12" cy="12" r="5"/>
                                                <line x1="12" y1="1" x2="12" y2="3"/>
                                                <line x1="12" y1="21" x2="12" y2="23"/>
                                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                                                <line x1="1" y1="12" x2="3" y2="12"/>
                                                <line x1="21" y1="12" x2="23" y2="12"/>
                                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                                            </svg>
                                            @(string.IsNullOrWhiteSpace(muni.Clima) ? "Clima de montaña" : muni.Clima)
                                        </span>
                                        @* Por qué la eligió "Sorpréndeme" *@
                                        @if (razonesSorpresa.TryGetValue(muni.IdMunicipio, out var razonSorpresa))
                                        {
                                            <span class="parada-razon" title="@razonSorpresa">
                                                <i class="ph-fill ph-sparkle" aria-hidden="true"></i> @razonSorpresa
                                            </span>
                                        }
                                    </div>

                                    <div class="parada-acciones" @onclick:stopPropagation="true">
                                        @if (idx > 0)
                                        {
                                            <button type="button" class="btn-accion-icono" title="Subir"
                                                    @onclick="() => MoverParada(idx, -1)">↑</button>
                                        }
                                        @if (idx < municipiosSeleccionados.Count - 1)
                                        {
                                            <button type="button" class="btn-accion-icono" title="Bajar"
                                                    @onclick="() => MoverParada(idx, 1)">↓</button>
                                        }
                                        <button type="button" class="btn-accion-icono btn-quitar" title="Eliminar"
                                                @onclick="() => QuitarMunicipio(idx)">✕</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="vacio-paradas-box">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px;"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                            <p>No tienes municipios en tu ruta aún.</p>
                        </div>
                    }

                    @* Recomendaciones: municipios cercanos a la última parada *@
                    <SugerenciasCercanas IdOrigen="@municipiosSeleccionados.LastOrDefault()?.IdMunicipio"
                                         NombreOrigen="@(municipiosSeleccionados.LastOrDefault()?.Nombre ?? "")"
                                         Excluir="@municipiosSeleccionados.Select(m => m.IdMunicipio)"
                                         OnAgregar="AgregarMunicipioDesdeModal"
                                         Version="versionOcultados" />

                    <button type="button" class="btn-agregar-municipio" @onclick="AbrirModalAgregar">
                        <span class="btn-agregar-icono">＋</span>
                        Agregar más pueblos a la ruta
                    </button>
                </div>
            </div>

            <div class="itinerario-footer-actions">
                <button type="button" class="btn-cancelar-iti"
                        @onclick='() => Nav.NavigateTo("/municipios")'>
                    Cancelar
                </button>
                <button type="submit" class="btn-guardar-iti"
                        disabled="@(guardando || !municipiosSeleccionados.Any())">
                    @(guardando ? "Guardando ruta..." : "Crear y Guardar Itinerario →")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Municipios { get; set; }

    // ?sorpresa=1 (desde Inicio): la ruta se arma sola al abrir la página
    [SupplyParameterFromQuery]
    public int? Sorpresa { get; set; }

    private ItinerarioCreateRequest modelo = new();
    private List<MunicipioFichaDto> municipiosSeleccionados = new();

    // Modales
    private MunicipioFichaDto? municipioModal = null;
    private bool modalAgregarAbierto = false;
    private string textoBusquedaAgregar = "";
    private List<MunicipioListadoDto> resultadosBusqueda = new();
    private bool cargandoBusqueda = false;
    private System.Timers.Timer? _debounce;

    private bool cargandoInicial = true;
    private bool guardando = false;
    private bool usuarioAutenticado = true;
    private string? mensajeError;

    // Municipios que el usuario marcó "No me interesa": en el buscador salen marcados, no escondidos
    private HashSet<int> idsOcultados = new();
    private int? idReincorporando;
    private int versionOcultados;   // al cambiar, "Queda cerca" se recalcula

    // "Sorpréndeme"
    private const string ClaveGustosLocales = "tc_gustos";   // los mismos que guarda <ParaTi /> sin sesión
    private PropuestaItinerarioDto? propuesta;
    private Dictionary<int, string> razonesSorpresa = new();
    private int varianteSorpresa;
    private int variantePendiente;
    private bool generandoSorpresa;
    private bool confirmandoSorpresa;
    private string? errorSorpresa;
    private string? nombreSorpresa;   // si el usuario no lo cambió, "Otra sorpresa" lo reemplaza

    // Una parada por día: los días salen de las fechas del formulario (3 si no son válidas)
    private int DiasDelViaje =>
        modelo.FechaInicio is DateOnly inicio && modelo.FechaFin is DateOnly fin && fin >= inicio
            ? Math.Clamp(fin.DayNumber - inicio.DayNumber + 1, 1, 7)
            : 3;

    // El resumen (km, tiempo) solo vale mientras la ruta siga igual a la propuesta
    private bool RutaEsLaPropuesta => propuesta is not null
        && municipiosSeleccionados.Select(m => m.IdMunicipio).SequenceEqual(propuesta.Paradas.Select(p => p.IdMunicipio));

    // Fotos Wikipedia — respaldo cuando la API no tiene imagen
    private Dictionary<int, string> fotosWikipedia = new();
    private record WikiThumbnail(string Source, int Width, int Height);
    private record WikiSummary(WikiThumbnail? Thumbnail);

    // Imagen genérica de Boyacá — último recurso
    private const string FotoFallback =
        "https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=900&auto=format&fit=crop";

    // ──────────────────────────────────────────────────────────────
    // LÓGICA DE FOTOS
    // Prioridad: 1) API/BD  →  2) Wikipedia  →  3) Fallback genérico
    // ──────────────────────────────────────────────────────────────

    /// <summary>Devuelve la foto que se muestra inicialmente en el img src.</summary>
    private string ObtenerFotoPrincipal(MunicipioFichaDto muni)
    {
        // 1. Imagen cargada desde la API
        if (!string.IsNullOrWhiteSpace(muni.ImagenUrl))
            return muni.ImagenUrl;

        // 2. Wikipedia (ya cargada en segundo plano)
        if (fotosWikipedia.TryGetValue(muni.IdMunicipio, out var wiki))
            return wiki;

        // 3. Fallback genérico
        return FotoFallback;
    }

    /// <summary>
    /// Devuelve la foto de respaldo para el atributo onerror del img.
    /// Si la imagen de la API falla, intenta Wikipedia; si no, usa el genérico.
    /// </summary>
    private string ObtenerFotoFallback(MunicipioFichaDto muni)
    {
        if (fotosWikipedia.TryGetValue(muni.IdMunicipio, out var wiki))
            return wiki;

        return FotoFallback;
    }

    /// <summary>Foto para resultados de búsqueda (MunicipioListadoDto).</summary>
    private string ObtenerFotoListado(MunicipioListadoDto m)
    {
        if (!string.IsNullOrWhiteSpace(m.ImagenUrl))
            return m.ImagenUrl;

        return FotoFallback;
    }

    // ──────────────────────────────────────────────────────────────
    // WIKIPEDIA — carga fotos reales como respaldo
    // ──────────────────────────────────────────────────────────────

    private async Task CargarFotosWikipedia()
    {
        // Solo cargamos Wikipedia para los municipios que NO tienen imagen en la API
        var sinImagen = municipiosSeleccionados
            .Where(m => string.IsNullOrWhiteSpace(m.ImagenUrl) && !fotosWikipedia.ContainsKey(m.IdMunicipio))
            .ToList();

        var tareas = sinImagen.Select(async muni =>
        {
            // Intento 1: "Nombre (Boyacá)"
            var foto = await BuscarFotoWikipedia($"{muni.Nombre} (Boyacá)");

            // Intento 2: solo el nombre
            if (foto == null)
                foto = await BuscarFotoWikipedia(muni.Nombre);

            if (foto != null)
            {
                // Mejorar resolución a 800px
                var fotoHd = foto
                    .Replace("/320px-", "/800px-")
                    .Replace("/240px-", "/800px-")
                    .Replace("/150px-", "/800px-");

                fotosWikipedia[muni.IdMunicipio] = fotoHd;
                await InvokeAsync(StateHasChanged);
            }
        });

        await Task.WhenAll(tareas);
    }

    private async Task<string?> BuscarFotoWikipedia(string nombre)
    {
        try
        {
            var slug = Uri.EscapeDataString(nombre);
            var resumen = await Http.GetFromJsonAsync<WikiSummary>(
                $"https://es.wikipedia.org/api/rest_v1/page/summary/{slug}",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            return resumen?.Thumbnail?.Source;
        }
        catch
        {
            return null;
        }
    }

    // ──────────────────────────────────────────────────────────────
    // PAISAJES DE ESPERA
    // ──────────────────────────────────────────────────────────────

    private record PaisajeBoyaca(string Lugar, string Frase, string Url);
    private static readonly PaisajeBoyaca[] PaisajesBoyaca =
    {
        new("Páramo de Ocetá",    "Caminos ancestrales entre frailejones gigantes.",          "https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1600&auto=format&fit=crop"),
        new("Laguna de Tota",     "La magia del mar interior de los Andes boyacenses.",       "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=1600&auto=format&fit=crop"),
        new("Pueblos Patrimonio", "Arquitectura colonial y balcones florecidos de historia.", "https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?q=80&w=1600&auto=format&fit=crop"),
    };
    private PaisajeBoyaca paisajeEspera = PaisajesBoyaca[Random.Shared.Next(PaisajesBoyaca.Length)];

    // ──────────────────────────────────────────────────────────────
    // CICLO DE VIDA
    // ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        cargandoInicial = true;
        modelo.FechaInicio = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        modelo.FechaFin    = DateOnly.FromDateTime(DateTime.Today.AddDays(3));

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioAutenticado = authState.User.Identity?.IsAuthenticated ?? false;

        if (usuarioAutenticado)
        {
            // Si falla, el buscador funciona igual, solo sin la marca de "ocultado"
            var ocultados = await RecoService.ListarDescartadosAsync();
            idsOcultados = ocultados?.Select(d => d.IdMunicipio).ToHashSet() ?? new();
        }

        if (!string.IsNullOrEmpty(Municipios))
        {
            var ids = Municipios
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => int.TryParse(s, out var v) ? v : 0)
                .Where(v => v > 0)
                .Distinct()
                .ToList();

            foreach (var id in ids)
            {
                var info = await MuniApi.ObtenerFichaAsync(id);
                if (info != null) municipiosSeleccionados.Add(info);
            }

            SincronizarParadas();
        }

        cargandoInicial = false;

        // Viene de "Sorpréndeme con una ruta" en Inicio
        if (Sorpresa is not null && !municipiosSeleccionados.Any())
            await GenerarSorpresaAsync(0);

        // Wikipedia solo para municipios sin imagen en la API — no bloquea la UI
        _ = CargarFotosWikipedia();
    }

    // ──────────────────────────────────────────────────────────────
    // SORPRÉNDEME
    // ──────────────────────────────────────────────────────────────

    /// <summary>Si ya hay paradas que no vienen de una sorpresa, primero se confirma el reemplazo.</summary>
    private async Task PedirSorpresaAsync(int variante)
    {
        if (municipiosSeleccionados.Any() && !RutaEsLaPropuesta)
        {
            variantePendiente = variante;
            confirmandoSorpresa = true;
            return;
        }

        await GenerarSorpresaAsync(variante);
    }

    private async Task GenerarSorpresaAsync(int variante)
    {
        confirmandoSorpresa = false;
        generandoSorpresa = true;
        errorSorpresa = null;
        StateHasChanged();

        try
        {
            // Sin sesión, los gustos que marcó en el Inicio (en este navegador)
            var gustos = usuarioAutenticado ? null : await LeerGustosLocalesAsync();
            var resultado = await RecoService.SorprendemeAsync(DiasDelViaje, variante, gustos);

            if (resultado is null)
            {
                errorSorpresa = "No pudimos armar la ruta. Inténtalo de nuevo.";
                return;
            }

            if (resultado.Paradas.Count == 0)
            {
                errorSorpresa = resultado.Aviso ?? "Aún no hay destinos para armar una ruta.";
                return;
            }

            // Las fichas completas (clima, foto, historia) para las tarjetas de parada, todas a la vez
            var fichas = await Task.WhenAll(resultado.Paradas.Select(p => MuniApi.ObtenerFichaAsync(p.IdMunicipio)));
            var encontradas = fichas.Where(f => f is not null).Select(f => f!).ToList();

            // Si alguna ficha no cargó, la propuesta se recorta para que el resumen siga siendo cierto
            resultado.Paradas = resultado.Paradas.Where(p => encontradas.Any(f => f.IdMunicipio == p.IdMunicipio)).ToList();

            municipiosSeleccionados = resultado.Paradas
                .Select(p => encontradas.First(f => f.IdMunicipio == p.IdMunicipio))
                .ToList();
            razonesSorpresa = resultado.Paradas.ToDictionary(p => p.IdMunicipio, p => p.Razon);
            municipioModal = null;

            // El nombre se propone solo si está vacío o si era el de la sorpresa anterior
            if (string.IsNullOrWhiteSpace(modelo.Nombre) || modelo.Nombre == nombreSorpresa)
            {
                modelo.Nombre = resultado.Nombre;
                nombreSorpresa = resultado.Nombre;
            }

            propuesta = resultado;
            varianteSorpresa = variante;
            SincronizarParadas();
            _ = CargarFotosWikipedia();
        }
        finally
        {
            generandoSorpresa = false;
        }
    }

    private async Task<List<int>> LeerGustosLocalesAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ClaveGustosLocales);
            return string.IsNullOrWhiteSpace(json)
                ? new()
                : System.Text.Json.JsonSerializer.Deserialize<List<int>>(json) ?? new();
        }
        catch
        {
            return new();   // modo privado o dato dañado: sorpresa con los mejor calificados
        }
    }

    private static string Duracion(int minutos) =>
        minutos < 60 ? $"{minutos} min" : $"{minutos / 60} h {minutos % 60:00} min";

    // ──────────────────────────────────────────────────────────────
    // MODALES
    // ──────────────────────────────────────────────────────────────

    private void AbrirModal(MunicipioFichaDto muni) => municipioModal = muni;
    private void CerrarModal() => municipioModal = null;

    private void AbrirModalAgregar()
    {
        textoBusquedaAgregar = "";
        resultadosBusqueda = new();
        modalAgregarAbierto = true;
    }

    private void CerrarModalAgregar()
    {
        modalAgregarAbierto = false;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = null;
    }

    private async Task BuscarMunicipiosParaAgregar()
    {
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = null;

        if (string.IsNullOrWhiteSpace(textoBusquedaAgregar))
        {
            resultadosBusqueda = new();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _debounce = new System.Timers.Timer(320) { AutoReset = false };
        _debounce.Elapsed += async (_, _) =>
        {
            cargandoBusqueda = true;
            await InvokeAsync(StateHasChanged);

            var resultado = await MuniApi.BuscarAsync(textoBusquedaAgregar);
            resultadosBusqueda = resultado ?? new();
            cargandoBusqueda = false;
            await InvokeAsync(StateHasChanged);
        };
        _debounce.Start();
    }

    private async Task AgregarMunicipioDesdeModal(int id)
    {
        if (municipiosSeleccionados.Any(s => s.IdMunicipio == id)) return;

        cargandoBusqueda = true;
        await InvokeAsync(StateHasChanged);

        var info = await MuniApi.ObtenerFichaAsync(id);
        if (info != null)
        {
            municipiosSeleccionados.Add(info);
            SincronizarParadas();
            _ = CargarFotosWikipedia();
        }

        cargandoBusqueda = false;

        if (!string.IsNullOrWhiteSpace(textoBusquedaAgregar))
            await BuscarMunicipiosParaAgregar();
        else
            await InvokeAsync(StateHasChanged);
    }

    /// <summary>Deshace el "No me interesa": el municipio vuelve a salir en recomendaciones y en "Queda cerca".</summary>
    private async Task ReincorporarAsync(int idMunicipio)
    {
        idReincorporando = idMunicipio;

        if (await RecoService.RestaurarAsync(idMunicipio))
        {
            idsOcultados.Remove(idMunicipio);
            versionOcultados++;
        }

        idReincorporando = null;
    }

    // ──────────────────────────────────────────────────────────────
    // LÓGICA DE PARADAS
    // ──────────────────────────────────────────────────────────────

    private void SincronizarParadas()
    {
        modelo.Paradas.Clear();
        for (int i = 0; i < municipiosSeleccionados.Count; i++)
        {
            modelo.Paradas.Add(new ParadaCreateRequest
            {
                IdMunicipio = municipiosSeleccionados[i].IdMunicipio,
                DiaNumero   = i + 1,
                Orden       = i + 1
            });
        }
    }

    private void MoverParada(int index, int dir)
    {
        int ni = index + dir;
        if (ni < 0 || ni >= municipiosSeleccionados.Count) return;
        (municipiosSeleccionados[index], municipiosSeleccionados[ni]) =
            (municipiosSeleccionados[ni], municipiosSeleccionados[index]);
        SincronizarParadas();
    }

    private void QuitarMunicipio(int index)
    {
        if (index < 0 || index >= municipiosSeleccionados.Count) return;
        var id = municipiosSeleccionados[index].IdMunicipio;
        municipiosSeleccionados.RemoveAt(index);
        if (municipioModal?.IdMunicipio == id) municipioModal = null;
        SincronizarParadas();
    }

    // ──────────────────────────────────────────────────────────────
    // GUARDAR
    // ──────────────────────────────────────────────────────────────

    private async Task GuardarItinerario()
    {
        if (!municipiosSeleccionados.Any())
        {
            mensajeError = "Añade al menos un municipio a tu ruta.";
            return;
        }

        if (modelo.FechaInicio.HasValue && modelo.FechaFin.HasValue &&
            modelo.FechaFin < modelo.FechaInicio)
        {
            mensajeError = "La fecha de regreso no puede ser anterior al inicio.";
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioAutenticado = authState.User.Identity?.IsAuthenticated ?? false;
        if (!usuarioAutenticado)
        {
            mensajeError = "Debes iniciar sesión para crear tu itinerario.";
            return;
        }

        SincronizarParadas();
        guardando = true;
        mensajeError = null;

        var (exito, error, resultado) = await ItiApi.CrearAsync(modelo);
        if (exito && resultado != null)
        {
            await Task.Delay(1200);
            Nav.NavigateTo($"/itinerarios/{resultado.IdItinerario}");
        }
        else
        {
            mensajeError = error ?? "No pudimos crear el itinerario. Intenta nuevamente.";
            guardando = false;
        }
    }

    private async Task Volver()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole(Roles.AdminGeneral))
            Nav.NavigateTo("/admin/dashboard");
        else if (authState.User.IsInRole(Roles.AdminMunicipio))
            Nav.NavigateTo("/municipio/dashboard");
        else if (authState.User.IsInRole(Roles.AdminEstablecimiento))
            Nav.NavigateTo("/comercio/dashboard");
        else
            Nav.NavigateTo("/itinerarios");
    }
}
