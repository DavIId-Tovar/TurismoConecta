@page "/itinerarios/{Id:int}"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Services
@inject ItinerarioApiService ApiService
@inject MunicipioApiService MuniApi
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div class="detalle-page">

    
    @if (cargando)
    {
        <div class="pantalla-espera-inmersiva">
            <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?q=80&w=1600&auto=format&fit=crop"
                 alt="Boyacá" class="espera-bg-img" />
            <div class="espera-scrim">
                <div class="espera-contenido">
                    <span class="espera-eyebrow">Tu Itinerario</span>
                    <h2 class="espera-lugar">Cargando tu ruta...</h2>
                    <p class="espera-cita">"Viajar es encontrarse a uno mismo en lugares desconocidos."</p>
                    <div class="espera-indicador">
                        <div class="spinner-anillo-selva"></div>
                        <span class="espera-texto-progreso">Preparando los detalles de tu aventura...</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* MODAL DE DETALLE DEL MUNICIPIO *@
    @if (municipioModal != null)
    {
        <div class="modal-backdrop" @onclick="CerrarModal">
            <div class="modal-card-municipio" @onclick:stopPropagation="true">
                <div class="modal-banner-wrap">
                    <img src="@ObtenerFotoMunicipio(municipioModal)"
                         alt="@municipioModal.Nombre"
                         class="modal-banner-foto"
                         onerror="this.onerror=null; this.src='@FotoFallback';" />
                    <div class="modal-banner-scrim">
                        <span class="modal-banner-tag">Destino Boyacense</span>
                        <h2 class="modal-banner-nombre">@municipioModal.Nombre</h2>
                        @if (!string.IsNullOrWhiteSpace(municipioModal.Clima))
                        {
                            <p class="modal-banner-clima">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;">
                                    <circle cx="12" cy="12" r="5"/>
                                    <line x1="12" y1="1" x2="12" y2="3"/>
                                    <line x1="12" y1="21" x2="12" y2="23"/>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                                    <line x1="1" y1="12" x2="3" y2="12"/>
                                    <line x1="21" y1="12" x2="23" y2="12"/>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                                </svg>
                                @municipioModal.Clima
                            </p>
                        }
                    </div>
                    <button type="button" class="modal-btn-cerrar" @onclick="CerrarModal" title="Cerrar">✕</button>
                </div>

                <div class="modal-cuerpo">
                    @if (municipioModal.Etiquetas != null && municipioModal.Etiquetas.Any())
                    {
                        <div class="modal-etiquetas-pills">
                            @foreach (var tag in municipioModal.Etiquetas)
                            {
                                <span class="pill-experiencia">✦ @tag</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(municipioModal.Descripcion))
                    {
                        <div class="modal-seccion">
                            <span class="modal-seccion-label">Sobre este pueblo</span>
                            <p class="modal-seccion-texto">@municipioModal.Descripcion</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(municipioModal.Historia))
                    {
                        <div class="modal-seccion">
                            <span class="modal-seccion-label">Historia y Tradición</span>
                            <p class="modal-seccion-texto modal-historia">@municipioModal.Historia</p>
                        </div>
                    }

                    @if (municipioModal.FechasRelevantes != null && municipioModal.FechasRelevantes.Any())
                    {
                        <div class="modal-seccion">
                            <span class="modal-seccion-label">Festividades Destacadas</span>
                            <div class="modal-festividades-grid">
                                @foreach (var fest in municipioModal.FechasRelevantes)
                                {
                                    <div class="modal-fest-card">
                                        <strong>@fest.NombreFestividad</strong>
                                        <span>@(string.IsNullOrWhiteSpace(fest.TipoFestividad) ? "Cultural" : fest.TipoFestividad)</span>
                                        @if (fest.FechaInicio != default)
                                        {
                                            <span class="fest-fecha">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;">
                                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                                    <line x1="16" y1="2" x2="16" y2="6"/>
                                                    <line x1="8" y1="2" x2="8" y2="6"/>
                                                    <line x1="3" y1="10" x2="21" y2="10"/>
                                                </svg>
                                                @fest.FechaInicio.ToString("MMMM yyyy")
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="modal-footer-acciones">
                        <a href="/municipios/@municipioModal.IdMunicipio" target="_blank" class="enlace-ficha-completa">
                            Ver ficha turística completa ↗
                        </a>
                        <button type="button" class="btn-guardar-iti" @onclick="CerrarModal">
                            ← Volver al itinerario
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ERROR *@
    else if (itinerario == null)
    {
        <div class="detalle-container">
            <div class="estado-error-box">
                <span>😞</span>
                <h3>No encontramos este itinerario</h3>
                <p>Puede que haya sido eliminado o que el enlace sea incorrecto.</p>
                <button class="btn-volver" @onclick="Volver">
                    ← Volver a mis itinerarios
                </button>
            </div>
        </div>
    }

    @* CONTENIDO COMPLETO *@
    else
    {
        @* HERO *@
        <div class="detalle-hero">
            <div class="detalle-hero-logo-wrap" style="position:absolute; top:1.2rem; right:1.5rem; z-index:5;">
                <a href="/" class="logo-marco-dorado" title="TurismoConecta">
                    <img src="images/turismo-conecta-logo.png" alt="TurismoConecta" class="topbar-logo-img" />
                </a>
            </div>
            <div class="detalle-hero-contenido">
                <button class="btn-volver-hero" @onclick="Volver">
                    ← Mis itinerarios
                </button>
                <span class="detalle-eyebrow">Ruta Boyacense</span>
                <h1 class="detalle-nombre">@itinerario.Nombre</h1>

                <div class="detalle-hero-meta">
                    @if (itinerario.FechaInicio.HasValue)
                    {
                        <span class="hero-meta-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 5px;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            @itinerario.FechaInicio.Value.ToString("dd 'de' MMMM")
                            @if (itinerario.FechaFin.HasValue)
                            {
                                <text> → @itinerario.FechaFin.Value.ToString("dd 'de' MMMM, yyyy")</text>
                            }
                        </span>
                    }
                    <span class="hero-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 5px;">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        @itinerario.Paradas.Count parada@(itinerario.Paradas.Count != 1 ? "s" : "")
                    </span>
                    @if (itinerario.Compartido)
                    {
                        <span class="badge-publico-hero">✦ Público</span>
                    }
                </div>
            </div>
        </div>

        <div class="detalle-container">
            @* AVISOS EN LA RUTA (alertas municipales): no pinta nada si no hay *@
            <AvisosRuta Paradas="paradasMapa" FechaInicio="itinerario.FechaInicio" AlCambiarAvisos="AlCambiarAvisos" />

            @* MAPA DE LA RUTA *@
            @if (itinerario.Paradas.Any())
            {
                <div class="seccion-card seccion-mapa">
                    <div class="seccion-titulo-wrap">
                        <span class="seccion-num"><i class="ph-fill ph-map-trifold" aria-hidden="true"></i></span>
                        <div class="seccion-titulo-textos">
                            <h2 class="seccion-titulo">Mapa de tu Ruta</h2>
                            <span class="seccion-subtitulo">Distancias aproximadas por carretera · toca un pin para ver la parada</span>
                        </div>
                    </div>
                    <MapaViaje Paradas="paradasMapa" Avisos="avisosRuta" />
                </div>
            }

            <div class="detalle-body-grid">

                @* COLUMNA IZQUIERDA: PARADAS *@
                <div class="detalle-col-paradas">
                    <div class="seccion-card">
                        <div class="seccion-titulo-wrap">
                            <span class="seccion-num">01</span>
                            <div class="seccion-titulo-textos">
                                <h2 class="seccion-titulo">Ruta de Viaje</h2>
                                <span class="seccion-subtitulo">Haz clic en cualquier pueblo para ver su información</span>
                            </div>
                        </div>

                        @if (!itinerario.Paradas.Any())
                        {
                            <p class="texto-vacio">No hay paradas en este itinerario.</p>
                        }
                        else
                        {
                            var porDia = itinerario.Paradas.GroupBy(p => p.DiaNumero).OrderBy(g => g.Key);

                            @foreach (var dia in porDia)
                            {
                                <div class="dia-bloque">
                                    <div class="dia-label">
                                        <span class="dia-num">Día @dia.Key</span>
                                        <span class="dia-linea"></span>
                                    </div>
                                    @foreach (var parada in dia.OrderBy(p => p.Orden))
                                    {
                                        <div class="parada-contenedor-card">
                                            <div class="parada-linea-item" @onclick="() => VerMunicipio(parada.IdMunicipio)">
                                                <div class="parada-dot"></div>
                                                <div class="parada-info-texto">
                                                    <span class="parada-orden-num">@parada.Orden</span>
                                                    <span class="parada-municipio-nombre">@parada.NombreMunicipio</span>
                                                    @if (avisosRuta.TryGetValue(parada.IdMunicipio, out var aviso))
                                                    {
                                                        <span class="badge-aviso-parada" title="@aviso">
                                                            <i class="ph-fill ph-warning" aria-hidden="true"></i> Aviso
                                                        </span>
                                                    }
                                                    <span class="badge-ver-parada">Ver guía del pueblo ↗</span>
                                                </div>
                                            </div>

                                            <!-- SECCIÓN DE HOTELES Y HOSPEDAJE RECOMENDADOS PARA ESTA PARADA -->
                                            @if (hotelesPorMunicipio.TryGetValue(parada.IdMunicipio, out var listaHoteles) && listaHoteles.Any())
                                            {
                                                <div class="hoteles-estancia-bloque">
                                                    <span class="estancia-titulo">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                                                            <path d="M2 4v16"/>
                                                            <path d="M2 8h18a2 2 0 0 1 2 2v10"/>
                                                            <path d="M2 17h20"/>
                                                            <path d="M6 8v9"/>
                                                        </svg>
                                                        Hospedaje sugerido en @parada.NombreMunicipio:
                                                    </span>
                                                    <div class="hoteles-grid-mini">
                                                        @foreach (var hotel in listaHoteles.Take(3))
                                                        {
                                                            <div class="hotel-mini-item">
                                                                <img src="@(hotel.Galeria.FirstOrDefault() ?? "https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=400")" 
                                                                     alt="@hotel.Nombre" class="hotel-mini-img" />
                                                                <div class="hotel-mini-info">
                                                                    <span class="hotel-mini-nombre">@hotel.Nombre</span>
                                                                    <span class="hotel-mini-dir">
                                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;">
                                                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                                                            <circle cx="12" cy="10" r="3"/>
                                                                        </svg>
                                                                        @(string.IsNullOrWhiteSpace(hotel.Direccion) ? "Centro de " + parada.NombreMunicipio : hotel.Direccion)
                                                                    </span>
                                                                    @if (!string.IsNullOrWhiteSpace(hotel.Telefono))
                                                                    {
                                                                        <a href="@ObtenerUrlWhatsApp(hotel.Telefono, hotel.Nombre, parada.NombreMunicipio)" 
                                                                           target="_blank" class="btn-reserva-hotel-wa">
                                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;">
                                                                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                                                                            </svg>
                                                                            Reservar por WhatsApp
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                @* COLUMNA DERECHA: INFO + COMPARTIR *@
                <div class="detalle-col-info">

                    @* OBSERVACIONES *@
                    @if (!string.IsNullOrWhiteSpace(itinerario.Observaciones))
                    {
                        <div class="seccion-card">
                            <div class="seccion-titulo-wrap">
                                <span class="seccion-num">02</span>
                                <h2 class="seccion-titulo">Notas del Viaje</h2>
                            </div>
                            <blockquote class="cita-observaciones">
                                "@itinerario.Observaciones"
                            </blockquote>
                        </div>
                    }

                    @* COMPARTIR *@
                    <div class="seccion-card">
                        <div class="seccion-titulo-wrap">
                            <span class="seccion-num">@(!string.IsNullOrWhiteSpace(itinerario.Observaciones) ? "03" : "02")</span>
                            <h2 class="seccion-titulo">Visibilidad del Itinerario</h2>
                        </div>

                        @if (itinerario.Compartido)
                        {
                            var urlCompartir = Nav.BaseUri.TrimEnd('/') + $"/itinerarios/compartido/{itinerario.CodigoCompartir}";
                            var textoWhatsapp = Uri.EscapeDataString($"¡Hola! Mira mi itinerario '{itinerario.Nombre}' por Boyacá en TurismoConecta:\n{urlCompartir}");
                            var whatsappLink = $"https://api.whatsapp.com/send?text={textoWhatsapp}";

                            <div class="compartir-estado publico">
                                <div class="compartir-icono">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="2" y1="12" x2="22" y2="12"/>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                    </svg>
                                </div>
                                <div class="compartir-texto">
                                    <strong>Este itinerario es público</strong>
                                    <p>Copia el enlace o envíalo directamente por WhatsApp a tus compañeros de viaje.</p>
                                </div>
                            </div>

                            <!-- ENLACE PARA COPIAR -->
                            <div class="compartir-box-link">
                                <label class="compartir-label-link">Enlace de tu itinerario:</label>
                                <div class="compartir-input-group">
                                    <input type="text" readonly value="@urlCompartir" class="compartir-input-url" />
                                    <button type="button" class="btn-copiar-link @(enlaceCopiado ? "copiado" : "")"
                                            @onclick="() => CopiarEnlace(urlCompartir)">
                                        @(enlaceCopiado ? "✓ ¡Copiado!" : "Copiar")
                                    </button>
                                </div>
                            </div>

                            <!-- BOTONES DE COMPARTIR -->
                            <div class="compartir-botones-fila">
                                <a href="@whatsappLink" target="_blank" class="btn-share-whatsapp" title="Compartir en WhatsApp">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                                    </svg>
                                    Compartir por WhatsApp
                                </a>
                                <a href="@urlCompartir" target="_blank" class="enlace-compartido-preview">
                                    Ver vista pública ↗
                                </a>
                            </div>

                            <button class="btn-toggle-compartir privado"
                                    @onclick="ToggleCompartir"
                                    disabled="@cambiandoCompartir">
                                @(cambiandoCompartir ? "Procesando..." : "Hacer privado")
                            </button>
                        }
                        else
                        {
                            <div class="compartir-estado privado">
                                <div class="compartir-icono">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                </div>
                                <div class="compartir-texto">
                                    <strong>Este itinerario es privado</strong>
                                    <p>Solo tú puedes verlo. Compártelo para inspirar a otros viajeros.</p>
                                </div>
                            </div>
                            <button class="btn-toggle-compartir publico"
                                    @onclick="ToggleCompartir"
                                    disabled="@cambiandoCompartir">
                                @(cambiandoCompartir ? "Procesando..." : "Compartir itinerario públicamente")
                            </button>
                        }
                    </div>

                    @* ACCIONES *@
                    <div class="detalle-acciones">
                        <button class="btn-accion-secundaria"
                                @onclick='() => Nav.NavigateTo("/municipios")'>
                            ＋ Planear nueva ruta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ItinerarioDetalleDto? itinerario;
    private bool cargando = true;
    private bool cambiandoCompartir = false;
    private Dictionary<int, List<NegocioResumenDto>> hotelesPorMunicipio = new();
    private List<ParadaMapa> paradasMapa = new();   // mapa de la ruta
    private Dictionary<int, string> avisosRuta = new();   // IdMunicipio → aviso vigente (lo llena AvisosRuta)

    private void AlCambiarAvisos(Dictionary<int, string> avisos) => avisosRuta = avisos;

    // Modal de información del municipio
    private MunicipioFichaDto? municipioModal;
    private const string FotoFallback =
        "https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=900&auto=format&fit=crop";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        itinerario = await ApiService.ObtenerDetalleAsync(Id);
        if (itinerario is not null) paradasMapa = ParadaMapa.DeItinerario(itinerario);

        if (itinerario?.Paradas != null && itinerario.Paradas.Any())
        {
            var idsMunicipios = itinerario.Paradas.Select(p => p.IdMunicipio).Distinct().ToList();
            foreach (var idMun in idsMunicipios)
            {
                var negocios = await MuniApi.ObtenerNegociosPorMunicipioAsync(idMun);
                if (negocios != null && negocios.Any())
                {
                    // Filtramos por hospedaje o los primeros recomendados
                    var hoteles = negocios.Where(n => n.IdCategoria == 1).ToList();
                    hotelesPorMunicipio[idMun] = hoteles.Any() ? hoteles : negocios.Take(2).ToList();
                }
            }
        }

        cargando = false;
    }

    private string ObtenerUrlWhatsApp(string telefono, string nombreHotel, string nombreMunicipio)
    {
        var telLimpio = telefono.Replace(" ", "").Replace("+", "").Replace("-", "");
        var texto = Uri.EscapeDataString($"Hola {nombreHotel} en {nombreMunicipio}, estoy planificando mi viaje en TurismoConecta y me gustaría consultar disponibilidad de hospedaje.");
        return $"https://wa.me/{telLimpio}?text={texto}";
    }

    private async Task VerMunicipio(int idMunicipio)
    {
        municipioModal = await MuniApi.ObtenerFichaAsync(idMunicipio);
    }

    private void CerrarModal() => municipioModal = null;

    private string ObtenerFotoMunicipio(MunicipioFichaDto muni)
    {
        if (!string.IsNullOrWhiteSpace(muni.ImagenUrl) && muni.ImagenUrl.StartsWith("http"))
            return muni.ImagenUrl;

        return FotoFallback;
    }

    private async Task ToggleCompartir()
    {
        if (itinerario == null) return;
        cambiandoCompartir = true;
        var resultado = await ApiService.ToggleCompartirAsync(Id);
        if (resultado != null)
        {
            itinerario.Compartido = resultado.Compartido;
            itinerario.CodigoCompartir = resultado.CodigoCompartir;
        }
        else await JS.InvokeVoidAsync("alert", "Error al cambiar el estado de visibilidad.");
        cambiandoCompartir = false;
    }

    private bool enlaceCopiado = false;

    private async Task CopiarEnlace(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            enlaceCopiado = true;
            StateHasChanged();
            await Task.Delay(2500);
            enlaceCopiado = false;
            StateHasChanged();
        }
        catch
        {
            await JS.InvokeVoidAsync("prompt", "Copia el siguiente enlace para compartir:", url);
        }
    }

    private async Task Volver()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole(Roles.AdminGeneral))
            Nav.NavigateTo("/admin/dashboard");
        else if (authState.User.IsInRole(Roles.AdminMunicipio))
            Nav.NavigateTo("/municipio/dashboard");
        else if (authState.User.IsInRole(Roles.AdminEstablecimiento))
            Nav.NavigateTo("/comercio/dashboard");
        else
            Nav.NavigateTo("/itinerarios");
    }
}
