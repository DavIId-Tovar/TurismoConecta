@page "/login"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using TurismoConecta.web.Client.Models
@using TurismoConecta.web.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="page-background">
    <div class="premium-card">
        
        <!-- Mitad Izquierda: Formulario -->
        <div class="form-section">
            <div class="form-wrapper">
                
                <a href="/" class="volver-inicio">
                    <i class="ph ph-arrow-left"></i> Volver al inicio
                </a>

                <a href="/" class="brand" title="Ir al inicio">
                    <i class="ph-fill ph-compass"></i>
                    <span>TurismoConecta</span>
                </a>

                <div class="header-text">
                    <h1>¡Bienvenido de Nuevo!</h1>
                    <p>Por favor, ingresa tus datos para continuar.</p>
                </div>

                <EditForm Model="@modelo" OnValidSubmit="HacerLogin">
                    <div class="input-group">
                        <label>Correo Electrónico</label>
                        <div class="input-container">
                            <InputText class="premium-input" @bind-Value="modelo.Email" placeholder="ejemplo@correo.com" />
                        </div>
                    </div>

                    
                      <div class="input-group">
                        <label>Contraseña</label>
                        <div class="password-wrapper">
                            <InputText type="@tipoInputClave"
                                       class="premium-input"
                                       @bind-Value="modelo.Password"
                                       placeholder="••••••••" />
                            <button type="button"
                                    class="toggle-password"
                                    @onclick="AlternarVisibilidadClave"
                                    aria-label="Mostrar/Ocultar contraseña">
                                @if (mostrarClave)
                                {
                                    <!-- Ojo tachado (contraseña visible) -->
                                    <svg viewBox="0 0 24 24" class="eye-icon" fill="currentColor">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                        <line x1="1" y1="1" x2="23" y2="23" stroke="currentColor" stroke-width="2"/>
                                    </svg>
                                }
                                else
                                {
                                    <!-- Ojo abierto (contraseña oculta) -->
                                    <svg viewBox="0 0 24 24" class="eye-icon" fill="currentColor">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>




                    <div class="forgot-password">
                        <a href="/recuperar-password">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="submit-btn" disabled="@cargando">
                        @if (cargando)
                        {
                            <div class="spinner"></div>
                            <span>Verificando...</span>
                        }
                        else
                        {
                            <span>Iniciar Sesión</span>
                            <i class="ph-bold ph-arrow-right"></i>
                        }
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert error-alert">
                        <i class="ph-fill ph-warning-circle"></i>
                        <span>@mensajeError</span>
                    </div>
                }

                @if (respuesta is not null)
                {
                    <div class="alert success-alert">
                        <i class="ph-fill ph-check-circle"></i>
                        <span>¡Bienvenido, @respuesta.NombreCompleto! (Rol: @respuesta.Rol)</span>
                    </div>
                }

                <div class="register-link">
                    ¿No tienes cuenta? <a href="/register">Regístrate ahora</a>
                </div>
            </div>
        </div>

        <!-- Mitad Derecha: Imagen inmersiva -->
        <div class="image-section">
            <img src="images/LagunaNegraLogin.jpg" alt="Laguna Negra, Boyacá" />
            <div class="image-overlay"></div>
            <div class="image-content">
                <div class="glass-card">
                    <h2>Descubre los tesoros de Boyacá</h2>
                    <p>Tu próximo viaje comienza aquí. Conecta con la naturaleza, la cultura y la magia de nuestra tierra.</p>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    // Página a la que volver tras iniciar sesión (la manda BotonFavorito)
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    private LoginRequest modelo = new();
    private AuthResponse? respuesta;
    private string mensajeError = string.Empty;
    private bool cargando = false;


    // Si ya hay una sesión válida, no mostramos el formulario:
    // lo mandamos directo a su panel según el rol.
    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        var usuario = estado.User;

        if (usuario.Identity?.IsAuthenticated != true) return;   // sin sesión → se muestra el login normal

        var destino = usuario.IsInRole(Roles.AdminGeneral) ? "/admin/dashboard"
                    : usuario.IsInRole(Roles.AdminMunicipio) ? "/municipio/dashboard"
                    : usuario.IsInRole(Roles.AdminEstablecimiento) ? "/comercio/dashboard"
                    : "/";                                       // turista → inicio

        // replace: el /login no queda en el historial
        NavManager.NavigateTo(destino, replace: true);
    }



    private async Task HacerLogin()
    {
        mensajeError = string.Empty;
        respuesta = null;
        cargando = true;

        try
        {
            var resultadoHttp = await Http.PostAsJsonAsync("api/auth/login", modelo);

            if (resultadoHttp.IsSuccessStatusCode)
            {
                respuesta = await resultadoHttp.Content.ReadFromJsonAsync<AuthResponse>();

                if (respuesta is null) return; // si por alguna razón llega null, salimos

                await JS.InvokeVoidAsync("guardarToken", respuesta.Token);

                if (AuthStateProvider is JwtAuthStateProvider jwtProvider)
                {
                    jwtProvider.NotificarCambioAutenticacion();
                }

                // Pausa breve para que el usuario vea el mensaje de bienvenida
                await Task.Delay(800);

                // Redirigir al dashboard según el rol del usuario
                // Si venía de una página (p. ej. el botón ♥), vuelve ahí; si no, al dashboard según el rol
                var destino = EsRutaLocal(ReturnUrl)
                    ? ReturnUrl!
                    : respuesta.Rol switch
                    {
                        Roles.AdminGeneral => "/admin/dashboard",
                        Roles.AdminMunicipio => "/municipio/dashboard",
                        Roles.AdminEstablecimiento => "/comercio/dashboard",
                        _ => "/"   // Turista → portal principal
                    };
                NavManager.NavigateTo(destino, forceLoad: true, replace: true);


            }
            else
            {
                mensajeError = "Correo o contraseña incorrectos.";
            }
        }
        catch (Exception)
        {
            mensajeError = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    

    // Solo acepta rutas de nuestra web ("/algo"); rechaza "https://otro-sitio.com" y "//otro-sitio.com"
    private static bool EsRutaLocal(string? url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.StartsWith('/')
        && !url.StartsWith("//")
        && !url.StartsWith("/\\");


    private bool mostrarClave = false;
    private string tipoInputClave = "password";

    private void AlternarVisibilidadClave()
    {
        mostrarClave = !mostrarClave;
        tipoInputClave = mostrarClave ? "text" : "password";
    }



}

