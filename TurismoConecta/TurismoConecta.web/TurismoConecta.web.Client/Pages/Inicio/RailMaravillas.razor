@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="rail-escena" id="donde-ir" @ref="escena">
    <div class="rail-sticky">
        @* Fondo inmersivo: la foto de la carta activa, desenfocada *@
        <div class="rail-fondo" style="background-image: url('@(Actual is null ? "" : Imagen(Actual.ImagenUrl))')"></div>
        <div class="rail-velo"></div>

        <header class="rail-cabecera">
            <span class="rail-eyebrow">Maravillas de Boyacá</span>
            <h2>Tesoros naturales, lagos y monumentos</h2>
            @Filtros
        </header>

        <div class="rail-escenario" aria-label="Maravillas de Boyacá">
            @if (Items.Count == 0)
            {
                <p class="rail-vacio">Aún no hay sitios turísticos publicados en esta categoría.</p>
            }

            @for (var i = 0; i < Items.Count; i++)
            {
                var distancia = Distancia(i);
                if (Math.Abs(distancia) > VisiblesEfectivos + 1) continue;   // solo se dibujan las cercanas

                var indice = i;
                var item = Items[i];

                <button type="button" @key="item.IdSitioTuristico"
                        class="rail-card @(distancia == 0 ? "activa" : "")"
                        style="@EstiloCarta(distancia)"
                        tabindex="@(distancia == 0 ? 0 : -1)"
                        aria-label="@(distancia == 0 ? $"Ver detalles de {item.Nombre}" : $"Ir a {item.Nombre}")"
                        @onclick="() => AlHacerClic(indice, item)">
                    <img src="@Imagen(item.ImagenUrl)" alt="" loading="lazy" draggable="false" />
                    @if (!string.IsNullOrWhiteSpace(item.NombreCategoria))
                    {
                        <span class="rail-card-badge">
                            <i class="@(item.IconoCategoria ?? "ph ph-tag")" aria-hidden="true"></i>
                            @item.NombreCategoria
                        </span>
                    }
                </button>
            }
        </div>

        @if (Actual is not null)
        {
            <footer class="rail-pie">
                <div class="rail-leyenda" aria-live="polite">
                    <h3>@Actual.Nombre</h3>
                    <p>
                        <span><i class="ph-fill ph-map-pin" aria-hidden="true"></i> @Actual.NombreMunicipio</span>
                        @if (!string.IsNullOrWhiteSpace(Actual.Clima))
                        {
                            <span class="rail-clima" title="@Actual.Clima"><i class="ph ph-thermometer-simple" aria-hidden="true"></i> @Actual.Clima</span>
                        }
                        @if (Actual.Calificacion.HasValue)
                        {
                            <span><i class="ph-fill ph-star" aria-hidden="true"></i> @Actual.Calificacion.Value.ToString("0.0")</span>
                        }
                    </p>
                </div>

                <div class="rail-acciones">
                    <button type="button" class="rail-btn" @onclick="() => OnVerDetalle.InvokeAsync(Actual)">
                        Ver detalles
                    </button>
                    <a class="rail-btn rail-btn-borde" href="/municipios/@Actual.IdMunicipio?desde=inicio">
                        Visitar @Actual.NombreMunicipio <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="rail-controles">
                    <button type="button" class="rail-flecha" aria-label="Anterior" @onclick="() => Mover(-1)">
                        <i class="ph ph-caret-left" aria-hidden="true"></i>
                    </button>

                    <div class="rail-progreso" role="progressbar"
                         aria-valuemin="1" aria-valuemax="@Items.Count" aria-valuenow="@(activo + 1)">
                        <span style="width: @Porcentaje"></span>
                    </div>

                    <button type="button" class="rail-flecha"
                            aria-label="@(pausadoUsuario ? "Reanudar rotación" : "Pausar rotación")"
                            @onclick="AlternarPausa">
                        <i class="ph-fill @(pausadoUsuario ? "ph-play" : "ph-pause")" aria-hidden="true"></i>
                    </button>

                    <button type="button" class="rail-flecha" aria-label="Siguiente" @onclick="() => Mover(1)">
                        <i class="ph ph-caret-right" aria-hidden="true"></i>
                    </button>
                </div>

                <span class="rail-pista">
                    @((activo + 1).ToString("00")) / @Items.Count.ToString("00") · Desliza o sigue bajando
                </span>
            </footer>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public List<SitioTuristicoDto> Items { get; set; } = new();
    [Parameter, EditorRequired] public Func<string?, string> Imagen { get; set; } = url => url ?? "";
    [Parameter] public EventCallback<SitioTuristicoDto> OnVerDetalle { get; set; }
    [Parameter] public RenderFragment? Filtros { get; set; }

    // Pausa impuesta por la página (p. ej. mientras el modal de detalle está abierto)
    [Parameter] public bool Pausado { get; set; }

    // Milisegundos entre cada paso automático
    [Parameter] public int IntervaloMs { get; set; } = 4500;

    private ElementReference escena;
    private DotNetObjectReference<RailMaravillas>? referencia;
    private int activo;
    private int totalAnterior = -1;
    private bool pausadoUsuario;

    private SitioTuristicoDto? Actual => Items.Count > 0 ? Items[Math.Clamp(activo, 0, Items.Count - 1)] : null;

    // Con pocas cartas se muestran menos a los lados, para que ninguna "cruce" por delante al dar la vuelta
    private int VisiblesEfectivos => Math.Clamp((Items.Count - 1) / 2, 1, 3);

    private string Porcentaje => Items.Count == 0
        ? "0%"
        : FormattableString.Invariant($"{(activo + 1) * 100.0 / Items.Count:0.##}%");

    protected override void OnParametersSet()
    {
        // El filtro cambió la lista: vuelve a la primera carta
        if (Items.Count != totalAnterior)
        {
            totalAnterior = Items.Count;
            activo = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        referencia = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("RailMaravillas.iniciar", escena, referencia, IntervaloMs);
    }

    // ── Llamadas desde el JS ──
    [JSInvokable]
    public void AlTemporizador()
    {
        if (Pausado || pausadoUsuario) return;
        Avanzar(1);
    }

    [JSInvokable]
    public void AlScroll(int direccion) => Avanzar(direccion);

    // ── Movimiento ──
    // Da la vuelta: después de la última viene la primera, y al revés
    private void Avanzar(int direccion)
    {
        if (Items.Count == 0) return;
        activo = ((activo + direccion) % Items.Count + Items.Count) % Items.Count;
        StateHasChanged();
    }

    private async Task Mover(int direccion)
    {
        Avanzar(direccion);
        await ReiniciarTemporizador();
    }

    private async Task IrA(int indice)
    {
        activo = indice;
        await ReiniciarTemporizador();
    }

    // Carta del centro → detalle; carta lateral → la trae al centro
    private async Task AlHacerClic(int indice, SitioTuristicoDto item)
    {
        if (indice == activo) await OnVerDetalle.InvokeAsync(item);
        else await IrA(indice);
    }

    private void AlternarPausa() => pausadoUsuario = !pausadoUsuario;

    private async Task ReiniciarTemporizador()
    {
        try { await JS.InvokeVoidAsync("RailMaravillas.reiniciar", escena); }
        catch (JSException) { }
    }

    // Distancia más corta de una carta a la del centro, contando la vuelta (… -2, -1, 0, 1, 2 …)
    private int Distancia(int indice)
    {
        var total = Items.Count;
        var haciaLaDerecha = ((indice - activo) % total + total) % total;
        return haciaLaDerecha > total / 2 ? haciaLaDerecha - total : haciaLaDerecha;
    }

    // Posición 3D de cada carta según su distancia a la del centro
    private string EstiloCarta(int distancia)
    {
        var lejania = Math.Abs(distancia);
        var lado = Math.Sign(distancia);   // -1 izquierda, 0 centro, 1 derecha

        // Las que están fuera se esconden sin animación (así no cruzan la pantalla al dar la vuelta)
        if (lejania > VisiblesEfectivos)
            return FormattableString.Invariant(
                $"transform: translateX({lado * 260}%) scale(.5); opacity: 0; pointer-events: none; transition: none;");

        var desplazamiento = lejania == 0 ? 0 : 58 + (lejania - 1) * 24;   // % del ancho de la carta
        var escala = 1 - lejania * 0.12;
        var opacidad = 1 - lejania * 0.2;

        var transformacion = FormattableString.Invariant(
            $"translateX({lado * desplazamiento}%) translateZ({-lejania * 90}px) rotateY({-lado * 22}deg) rotateZ({lado * 6}deg) scale({escala:0.00})");

        return FormattableString.Invariant(
            $"transform: {transformacion}; z-index: {100 - lejania}; opacity: {opacidad:0.00};");
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("RailMaravillas.destruir", escena); }
        catch (JSDisconnectedException) { }
        referencia?.Dispose();
    }
}
