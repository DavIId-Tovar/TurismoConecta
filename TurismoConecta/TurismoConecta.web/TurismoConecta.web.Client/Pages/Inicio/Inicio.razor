    @* ═══════════════ MODAL: DETALLE DEL SITIO ═══════════════ *@
    @if (sitioSeleccionado is not null)
    {
        <div class="sitio-modal-fondo" @onclick="CerrarDetalleSitio">
            <div class="sitio-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="sitio-modal-titulo"
                 @onclick:stopPropagation
                 @onkeydown="TeclaEnModal">

                @* *@
                <button type="button"
                        class="sitio-modal-cerrar"
                        aria-label="Cerrar"
                        @ref="botonCerrarModal"
                        @onclick="CerrarDetalleSitio">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>

                <div class="sitio-modal-imagen">
                    <img src="@ImagenSitio(sitioSeleccionado.ImagenUrl)" alt="@sitioSeleccionado.Nombre" />
                    @if (!string.IsNullOrWhiteSpace(sitioSeleccionado.NombreCategoria))
                    {
                        <span class="destino-badge-categoria">
                            @if (!string.IsNullOrWhiteSpace(sitioSeleccionado.IconoCategoria))
                            {
                                <i class="@sitioSeleccionado.IconoCategoria" aria-hidden="true"></i>
                            }
                            @sitioSeleccionado.NombreCategoria
                        </span>
                    }
                </div>

                <div class="sitio-modal-cuerpo">
                    <h2 id="sitio-modal-titulo">@sitioSeleccionado.Nombre</h2>

                    @*  *@
                    <p class="sitio-modal-ubicacion">
                        <i class="ph-fill ph-map-pin" aria-hidden="true"></i> @sitioSeleccionado.NombreMunicipio, Boyacá
                    </p>

                    <ul class="sitio-modal-datos">
                        @if (sitioSeleccionado.Altitud.HasValue)
                        {
                            <li><i class="ph ph-mountains" aria-hidden="true"></i> @sitioSeleccionado.Altitud.Value.ToString("N0") msnm</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(sitioSeleccionado.Clima))
                        {
                            <li><i class="ph ph-thermometer-simple" aria-hidden="true"></i> @sitioSeleccionado.Clima</li>
                        }
                        @if (sitioSeleccionado.Calificacion.HasValue)
                        {
                            <li><i class="ph-fill ph-star" aria-hidden="true"></i> @sitioSeleccionado.Calificacion.Value.ToString("0.0")</li>
                        }
                    </ul>

                    @if (!string.IsNullOrWhiteSpace(sitioSeleccionado.Descripcion))
                    {
                        <p class="sitio-modal-descripcion">@sitioSeleccionado.Descripcion</p>
                    }

                    <div class="sitio-modal-acciones">
                        <a href="@UrlMunicipio(sitioSeleccionado.IdMunicipio)" class="sitio-btn-primario">
                            Conocer @sitioSeleccionado.NombreMunicipio →
                        </a>
                        @* *@
                        <button type="button" class="sitio-btn-secundario" @onclick="VerSitioEnMapa">
                            <i class="ph ph-map-trifold" aria-hidden="true"></i> Ver en el mapa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <CondorChat />
</div>

@code {
    // ════════════════════════════════════════════════
    // 1. ESTADO GENERAL
    // ════════════════════════════════════════════════
    private bool mostrarBuscador;
    private string zonaMapa = "Colombia";
    private bool mapaInicializado;
    private DotNetObjectReference<Inicio>? referenciaDotNet;

    private bool cargandoMunicipios = true;
    private bool cargandoSitios = true;

    private int? totalMunicipios;
    private List<MunicipioListadoDto> todosMunicipios = new();
    private List<EtiquetaDto> etiquetas = new();

    // ════════════════════════════════════════════════
    // 2. MARAVILLAS DE BOYACÁ
    // ════════════════════════════════════════════════
    private List<SitioTuristicoDto> sitiosTuristicos = new();
    private List<CategoriaDto> categoriasSitio = new();
    private int? categoriaSeleccionada;
    

    private SitioTuristicoDto? sitioSeleccionado;
    private ElementReference botonCerrarModal;
    private bool enfocarBotonCerrar;

    private List<SitioTuristicoDto> sitiosFiltrados =>
        categoriaSeleccionada is null
            ? sitiosTuristicos
            : sitiosTuristicos.Where(s => s.IdCategoria == categoriaSeleccionada).ToList();

    // Todas las cartas del rail, destacados primero (el rail solo dibuja las cercanas)
    private List<SitioTuristicoDto> sitiosRail =>
        sitiosFiltrados.OrderByDescending(s => s.Destacado).ToList();

          

    private void SeleccionarCategoria(int? idCategoria) => categoriaSeleccionada = idCategoria;

    // ════════════════════════════════════════════════
    // 3. BUSCADOR
    // ════════════════════════════════════════════════
    private const int MaxSugerencias = 6;

    private string textoBusqueda = "";
    private string? mensajeBusqueda;
    private List<ResultadoBusqueda> sugerencias = new();
    private bool mostrarSugerencias;
    private int sugerenciaActiva = -1;
    private MunicipioListadoDto? municipioEncontrado;

    /// <summary>Un resultado del buscador: un municipio o un sitio (con su municipio).</summary>
    private sealed record ResultadoBusqueda(
        string Titulo,
        string Subtitulo,
        string Icono,
        MunicipioListadoDto Municipio,
        SitioTuristicoDto? Sitio);

    // ════════════════════════════════════════════════
    // 4. AYUDANTES DE PRESENTACIÓN
    // ════════════════════════════════════════════════
    private string ImagenSitio(string? imagenUrl) =>
        string.IsNullOrWhiteSpace(imagenUrl)
            ? ApiConfig.ImagenPorDefecto
            : Api.Url(imagenUrl);

   

    // ◆ CAMBIO 15a: sin 📍 (el ícono ahora va en el HTML, CAMBIO 7)
    private static string TextoUbicacion(SitioTuristicoDto sitio) =>
        sitio.Altitud.HasValue
            ? $"{sitio.NombreMunicipio} • {sitio.Altitud.Value:N0} msnm"
            : sitio.NombreMunicipio;

    private static string UrlMunicipio(int idMunicipio) => $"/municipios/{idMunicipio}?desde=inicio";


    /// <summary>"Ráquira " → "raquira": minúsculas, sin tildes y sin espacios en los extremos.</summary>
    private static string Normalizar(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "";

        var descompuesto = texto.Trim().ToLowerInvariant().Normalize(NormalizationForm.FormD);
        var resultado = new StringBuilder(descompuesto.Length);

        foreach (var caracter in descompuesto)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(caracter) != UnicodeCategory.NonSpacingMark)
                resultado.Append(caracter);
        }

        return resultado.ToString();
    }

    // ════════════════════════════════════════════════
    // 5. CICLO DE VIDA
    // ════════════════════════════════════════════════
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            CargarMunicipios(),
            CargarEtiquetas(),
            CargarSitiosTuristicos());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!cargandoMunicipios)
                await InicializarMapaAsync();

            await IrAAnclaSiHay();
        }

        if (enfocarBotonCerrar)
        {
            enfocarBotonCerrar = false;
            try { await botonCerrarModal.FocusAsync(); }
            catch (Exception ex) { Console.WriteLine($"[Inicio] No se pudo enfocar el modal: {ex.Message}"); }
        }
    }

    private async Task CargarMunicipios()
    {
        cargandoMunicipios = true;
        try
        {
            todosMunicipios = await ApiService.ListarParaMapaAsync();
            totalMunicipios = todosMunicipios.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Inicio] Error cargando municipios: {ex.Message}");
            todosMunicipios = new();
            totalMunicipios = 0;
        }
        finally
        {
            cargandoMunicipios = false;
            StateHasChanged();
            _ = InicializarMapaAsync();
        }
    }

    // Solo para el contador de categorías: los gustos ahora los maneja el componente <ParaTi />
