    private async Task VerSitioEnMapa()
    {
        if (sitioSeleccionado is null) return;

        var sitio = sitioSeleccionado;
        var municipio = todosMunicipios.FirstOrDefault(m => m.IdMunicipio == sitio.IdMunicipio);
        CerrarDetalleSitio();

        if (municipio is null)
        {
            Nav.NavigateTo(UrlMunicipio(sitio.IdMunicipio));
            return;
        }

        var resultado = new ResultadoBusqueda(
            sitio.Nombre,
            sitio.NombreMunicipio,
            sitio.IconoCategoria ?? "ph ph-star",
            municipio,
            sitio);

        await SeleccionarResultado(resultado, desplazar: true);
    }

