    private async Task IrAlDashboard()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var rol = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
               ?? user.FindFirst("role")?.Value;

        var destino = rol switch
        {
            Roles.AdminGeneral => "/admin/dashboard",
            Roles.AdminMunicipio => "/municipio/dashboard",
            Roles.AdminEstablecimiento => "/comercio/dashboard",
            _ => "/perfil"
        };

        Nav.NavigateTo(destino);
    }

    private async Task CerrarSesion()
    {
        if (AuthStateProvider is JwtAuthStateProvider jwt)
            await jwt.CerrarSesionAsync();

        // replace: la página privada desaparece del historial → "Atrás" ya no vuelve a ella
        Nav.NavigateTo("/login", forceLoad: true, replace: true);
    }

