    private void MostrarBuscador() => mostrarBuscador = !mostrarBuscador;

    /// <summary>Se ejecuta en cada tecla (gracias a @bind:after).</summary>
    private void ActualizarSugerencias()
    {
        sugerenciaActiva = -1;
        var consulta = Normalizar(textoBusqueda);

        if (consulta.Length < 2)
        {
            sugerencias = new();
            mostrarSugerencias = false;
            return;
        }

        sugerencias = BuscarResultados(consulta).Take(MaxSugerencias).ToList();
        mostrarSugerencias = sugerencias.Count > 0;
    }

    /// <summary>Municipios primero (los que EMPIEZAN con el texto, arriba), luego sitios.</summary>
    private IEnumerable<ResultadoBusqueda> BuscarResultados(string consulta)
    {
        var municipios = todosMunicipios
            .Select(m => (Municipio: m, Clave: Normalizar(m.Nombre)))
            .Where(x => x.Clave.Contains(consulta))
            .OrderBy(x => x.Clave.StartsWith(consulta) ? 0 : 1)
            .ThenBy(x => x.Municipio.Nombre)
            .Select(x => new ResultadoBusqueda(
                x.Municipio.Nombre,
                "Municipio de Boyacá",
                "ph ph-map-pin",
                x.Municipio,
                null));

        var sitios = sitiosTuristicos
            .Where(s => Normalizar(s.Nombre).Contains(consulta))
            .Select(s => (Sitio: s, Municipio: todosMunicipios.FirstOrDefault(m => m.IdMunicipio == s.IdMunicipio)))
            .Where(x => x.Municipio is not null)
            .Select(x => new ResultadoBusqueda(
                x.Sitio.Nombre,
                $"{x.Sitio.NombreCategoria ?? "Sitio turístico"} · {x.Sitio.NombreMunicipio}",
                x.Sitio.IconoCategoria ?? "ph ph-star",
                x.Municipio!,
                x.Sitio));

        return municipios.Concat(sitios);
    }

    private void TeclaEnBuscador(KeyboardEventArgs e)
    {
        if (!mostrarSugerencias || sugerencias.Count == 0) return;

        switch (e.Key)
        {
            case "ArrowDown":
                sugerenciaActiva = (sugerenciaActiva + 1) % sugerencias.Count;
                break;
            case "ArrowUp":
                sugerenciaActiva = sugerenciaActiva <= 0 ? sugerencias.Count - 1 : sugerenciaActiva - 1;
                break;
            case "Escape":
                mostrarSugerencias = false;
                sugerenciaActiva = -1;
                break;
        }
    }

    private async Task DetectarEnterBusqueda(KeyboardEventArgs evento)
    {
        if (evento.Key == "Enter") await BuscarAsync(desplazar: true);
    }

    /// <summary>Enter o botón "Buscar": toma la sugerencia marcada o la primera.</summary>
    private async Task BuscarAsync(bool desplazar)
    {
        var consulta = Normalizar(textoBusqueda);

        if (consulta.Length == 0)
        {
            await LimpiarBusqueda();
            return;
        }

        var resultados = BuscarResultados(consulta).ToList();

        if (resultados.Count == 0)
        {
            mostrarSugerencias = false;
            municipioEncontrado = null;
            mensajeBusqueda = $"No encontramos nada para \"{textoBusqueda.Trim()}\". Prueba con un pueblo o un sitio, como \"Ráquira\" o \"Catedral\".";
            await ActualizarMapaConFiltro(new());
            return;
        }

        var elegido = sugerenciaActiva >= 0 && sugerenciaActiva < sugerencias.Count
            ? sugerencias[sugerenciaActiva]
            : resultados[0];

        await SeleccionarResultado(elegido, desplazar);
    }

    /// <summary>Deja en el mapa solo ese municipio, vuela hasta él y abre el popup.</summary>
    private async Task SeleccionarResultado(ResultadoBusqueda resultado, bool desplazar)
    {
        textoBusqueda = resultado.Titulo;
        sugerencias = new();
        mostrarSugerencias = false;
        sugerenciaActiva = -1;
        mostrarBuscador = false;
        municipioEncontrado = resultado.Municipio;

        mensajeBusqueda = resultado.Sitio is null
            ? $"{resultado.Municipio.Nombre} está marcado en el mapa."
            : $"{resultado.Sitio.Nombre} está en {resultado.Municipio.Nombre}.";

        await ActualizarMapaConFiltro(new List<MunicipioListadoDto> { resultado.Municipio });
        await EnfocarEnMapa(resultado.Municipio, resultado.Sitio?.Nombre, desplazar);
    }

    private async Task LimpiarBusqueda()
    {
        textoBusqueda = "";
        sugerencias = new();
        mostrarSugerencias = false;
        sugerenciaActiva = -1;
        mensajeBusqueda = null;
        municipioEncontrado = null;

        await ActualizarMapaConFiltro(todosMunicipios);

        try { await JS.InvokeVoidAsync("TurismoConectaMapa.restablecerVista"); }
        catch (Exception ex) { Console.WriteLine($"[Inicio] Error restableciendo el mapa: {ex.Message}"); }
    }

