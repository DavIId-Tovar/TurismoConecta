@page "/"
@implements IAsyncDisposable

@using System.Globalization
@using System.Text

@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@inject SitioTuristicoApiService SitioService
@inject MunicipioApiService ApiService
@inject EtiquetaApiService EtiquetaService
@inject ApiConfig Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Turismo Conecta | Descubre Colombia</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</HeadContent>

<div class="inicio-page">

    <header class="inicio-navbar">
        <a href="/" class="inicio-logo">
            <img src="images/turismo-conecta-logo.png"
                 alt="Turismo Conecta" />
        </a>

        <nav class="inicio-navigation" aria-label="Navegación principal">
            <a href="#quienes-somos">Quiénes somos</a>
            <a href="#donde-ir">Dónde ir</a>
            <a href="#gustos">Para ti</a>
            <a href="#consejos">Consejos de viaje</a>
        </nav>

        @* ◆ CAMBIO 1 (ya lo tenías aplicado): íconos de la barra superior *@
        <div class="inicio-actions">
            <button type="button"
                    class="nav-button"
                    aria-label="Buscar"
                    title="Buscar"
                    @onclick="MostrarBuscador">
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            </button>

            <AuthorizeView>
                <Authorized>
                    <button type="button" class="nav-button" aria-label="Mi panel" title="Ir a mi panel" @onclick="IrAlDashboard">
                        <i class="ph ph-squares-four" aria-hidden="true"></i>
                    </button>
                    <a href="/perfil" class="nav-button" aria-label="Mi cuenta" title="Mi cuenta">
                        <i class="ph ph-user-circle" aria-hidden="true"></i>
                    </a>
                    <button type="button" class="nav-button" aria-label="Cerrar sesión" title="Cerrar sesión" @onclick="CerrarSesion">
                        <i class="ph ph-sign-out" aria-hidden="true"></i>
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="nav-button" aria-label="Iniciar sesión" title="Iniciar sesión">
                        <i class="ph ph-user" aria-hidden="true"></i>
                    </a>
                    <a href="/register" class="nav-button" aria-label="Registrarse" title="Registrarse">
                        <i class="ph ph-user-plus" aria-hidden="true"></i>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    @if (mostrarBuscador)
    {
        <div class="buscador-navegacion">
            <input @bind="textoBusqueda"
                   @bind:event="oninput"
                   @bind:after="ActualizarSugerencias"
                   @onkeyup="DetectarEnterBusqueda"
                   placeholder="Busca un municipio o un sitio turístico..."
                   autocomplete="off"
                   autofocus />

            <button type="button" @onclick="() => BuscarAsync(desplazar: true)">
                Explorar
            </button>
        </div>
    }

    <main>

        <section class="hero-inicio">
            <div class="hero-overlay"></div>
            <div class="hero-decoracion hero-decoracion-superior"></div>
            <div class="hero-decoracion hero-decoracion-inferior"></div>

            <div class="hero-contenido">
                <span class="hero-etiqueta">
                    Turismo Conecta · Colombia
                </span>

                <h1>
                    Donde cada camino
                    <em>cuenta una historia.</em>
                </h1>

                <p>
                    Conecta con pueblos llenos de color, páramos que respiran,
                    sabores tradicionales y experiencias auténticas.
                </p>

                @* ── Buscador con sugerencias tipo "Maps" ── *@
                <div class="hero-buscador-zona">
                    <form class="hero-buscador"
                          @onsubmit="() => BuscarAsync(desplazar: false)"
                          @onsubmit:preventDefault>

                        @* ◆ CAMBIO 2: lupa del buscador (antes ⌕) *@
                        <span class="hero-buscador-icono">
                            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        </span>

                        <input @bind="textoBusqueda"
                               @bind:event="oninput"
                               @bind:after="ActualizarSugerencias"
                               @onkeydown="TeclaEnBuscador"
                               @onfocus="() => mostrarSugerencias = sugerencias.Count > 0"
                               @onblur="() => mostrarSugerencias = false"
                               placeholder="Busca un pueblo o un sitio: Ráquira, catedral…"
                               aria-label="Buscar municipio o sitio turístico"
                               autocomplete="off" />

                        @if (!string.IsNullOrEmpty(textoBusqueda))
                        {
                            @*  *@
                            <button type="button"
                                    class="hero-buscador-limpiar"
                                    aria-label="Limpiar búsqueda"
                                    @onclick="LimpiarBusqueda">
                                <i class="ph ph-x" aria-hidden="true"></i>
                            </button>
                        }

                        <button type="submit">
                            Buscar
                        </button>
                    </form>

                    @if (mostrarSugerencias && sugerencias.Count > 0)
                    {
                        <ul class="sugerencias-lista" role="listbox" aria-label="Sugerencias">
                            @for (var i = 0; i < sugerencias.Count; i++)
                            {
                                var sugerencia = sugerencias[i];
                                var indice = i;

                                <li role="option"
                                    aria-selected="@(indice == sugerenciaActiva)"
                                    class="sugerencia-item @(indice == sugerenciaActiva ? "activa" : "")"
                                    @onmousedown="() => SeleccionarResultado(sugerencia, desplazar: false)"
                                    @onmousedown:preventDefault>
                                    <span class="sugerencia-icono">
                                        <i class="@sugerencia.Icono" aria-hidden="true"></i>
                                    </span>
                                    <span class="sugerencia-textos">
                                        <strong>@sugerencia.Titulo</strong>
                                        <small>@sugerencia.Subtitulo</small>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>

                @if (!string.IsNullOrEmpty(mensajeBusqueda))
                {
                    <p class="mensaje-busqueda" role="status">
                        <i class="ph-fill ph-map-pin" aria-hidden="true"></i>
                        <span>@mensajeBusqueda</span>

                        @if (municipioEncontrado is not null)
                        {
                            <a href="@UrlMunicipio(municipioEncontrado.IdMunicipio)" class="mensaje-busqueda-ir">
                                Ir a @municipioEncontrado.Nombre
                                <i class="ph ph-arrow-right" aria-hidden="true"></i>
                            </a>
                        }
                    </p>
                }

                <div class="hero-enlaces">
                    <a href="#donde-ir">Explorar destinos</a>
                    <a href="#gustos">Ver experiencias</a>
                </div>
            </div>

            <div class="hero-mapa-resumen">
                <div class="hero-mapa-titulo">
                    <span>Comenzamos en</span>
                    <strong>@zonaMapa</strong>
                </div>

                <div class="hero-mapa-contenedor">
                    <div id="mapa-colombia"
                         class="mapa-colombia">
                    </div>

                    <div class="hero-mapa-indicador">
                        <span></span>
                        Desliza para acercarte a Boyacá
                    </div>
                </div>
            </div>
        </section>

        <section class="historia-section" id="quienes-somos">
            <div class="historia-grid">
                <div>
                    <span class="section-eyebrow">
                        Nuestra esencia
                    </span>

                    <h2>
                        Colombia se descubre
                        <em>pueblo a pueblo.</em>
                    </h2>
                </div>

                <div class="historia-texto">
                    <p>
                        Turismo Conecta es un espacio para encontrar municipios,
                        paisajes, tradiciones, negocios y experiencias locales.
                    </p>

                    <p>
                        Nuestro recorrido comienza en Boyacá, una región de
                        páramos, arquitectura colonial, gastronomía y cultura.
                    </p>

                    <a href="/quienes-somos" class="enlace-destacado">
                        Conoce nuestra historia →
                    </a>
                </div>
            </div>
        </section>

        <section class="estadisticas-section">
            <article>
                <strong>@(totalMunicipios?.ToString() ?? "0")</strong>
                <span>Municipios registrados</span>
            </article>

            <article>
                <strong>@etiquetas.Count</strong>
                <span>Formas de viajar</span>
            </article>

            <article>
                <strong>Boyacá</strong>
                <span>Primer territorio conectado</span>
            </article>
        </section>

       

            @* ═══════════════ MARAVILLAS DE BOYACÁ: rail inmersivo ═══════════════ *@
            @if (cargandoSitios)
            {
                <section class="destinos-page" id="donde-ir">
                    <div class="destinos-skeleton-fila" aria-busy="true">
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="destino-skeleton"></div>
                        }
                    </div>
                </section>
            }
            else
            {
                <RailMaravillas Items="sitiosRail" Imagen="ImagenSitio" OnVerDetalle="AbrirDetalleSitio"
                            Pausado="sitioSeleccionado is not null">
                    <Filtros>
                        @if (categoriasSitio.Count > 0)
                        {
                            <div class="destinos-filtros-bar rail-filtros" role="group" aria-label="Filtrar por categoría">
                                <button type="button"
                                        class="filtro-maravilla-btn @(categoriaSeleccionada is null ? "activo" : "")"
                                        @onclick="() => SeleccionarCategoria(null)">
                                    Todos
                                </button>
                                @foreach (var cat in categoriasSitio)
                                {
                                    <button type="button"
                                            class="filtro-maravilla-btn @(categoriaSeleccionada == cat.IdCategoria ? "activo" : "")"
                                            @onclick="() => SeleccionarCategoria(cat.IdCategoria)">
                                        @if (!string.IsNullOrWhiteSpace(cat.Icono))
                                        {
                                            <i class="@cat.Icono" aria-hidden="true"></i>
                                        }
                                        @cat.Nombre
                                    </button>
                                }
                            </div>
                        }
                    </Filtros>
                </RailMaravillas>
            }

        <div class="centrar-boton">
            <a href="/municipios" class="boton-principal">
                Ver todos los municipios y atractivos
            </a>
        </div>

        @* Recomendaciones personalizadas: gustos + "Elegidos para ti" *@
        <ParaTi />


        <section class="recomendaciones-section"
                 id="consejos">

            <div class="recomendaciones-intro">
                <span class="section-eyebrow">
                    Antes de viajar
                </span>

                <h2>
                    Consejos
                    <em>de viaje.</em>
                </h2>

                <p>
                    Prepárate para disfrutar cada destino con respeto,
                    curiosidad y tranquilidad.
                </p>
            </div>

            <div class="recomendaciones-grid">
                <article>
                    <span>01</span>
                    <h3>Lleva tu ruana</h3>
                    <p>
                        El clima de montaña puede cambiar rápidamente.
                        Lleva prendas cómodas y abrigadas.
                    </p>
                </article>

                <article>
                    <span>02</span>
                    <h3>Prueba lo local</h3>
                    <p>
                        Apoya la gastronomía, los artesanos y los negocios
                        de cada municipio.
                    </p>
                </article>

                <article>
                    <span>03</span>
                    <h3>Cuida el territorio</h3>
                    <p>
                        Respeta los páramos, los senderos, las comunidades
                        y el patrimonio.
                    </p>
                </article>

                <article>
                    <span>04</span>
                    <h3>Planea tu recorrido</h3>
                    <p>
                        Consulta las rutas, los horarios y las condiciones
                        antes de viajar.
                    </p>
                </article>
            </div>
        </section>

        <section class="itinerario-section">
            <div>
                <span class="section-eyebrow">
                    Planea tu aventura
                </span>

                <h2>
                    Arma tu itinerario
                    <em>por Colombia.</em>
                </h2>

                <p>
                    Guarda municipios, organiza tus paradas y construye
                    un recorrido pensado para ti.
                </p>
            </div>

            <button type="button"
                    class="boton-oscuro"
                    @onclick='() => Nav.NavigateTo("/itinerarios/crear")'>
                Crear itinerario
            </button>
        </section>
    </main>

    @* *@
    <section class="valores-section">
