    private async Task CargarSitiosTuristicos()
    {
        cargandoSitios = true;
        try
        {
            var sitiosTask = SitioService.ListarAsync(soloDestacados: true);
            var categoriasTask = SitioService.ListarCategoriasAsync();
            await Task.WhenAll(sitiosTask, categoriasTask);

            sitiosTuristicos = sitiosTask.Result;

            var idsConSitios = sitiosTuristicos
                .Where(s => s.IdCategoria.HasValue)
                .Select(s => s.IdCategoria!.Value)
                .ToHashSet();

            categoriasSitio = categoriasTask.Result
                .Where(c => idsConSitios.Contains(c.IdCategoria))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Inicio] Error cargando sitios turísticos: {ex.Message}");
            sitiosTuristicos = new();
            categoriasSitio = new();
        }
        finally
        {
            cargandoSitios = false;
        }
    }

