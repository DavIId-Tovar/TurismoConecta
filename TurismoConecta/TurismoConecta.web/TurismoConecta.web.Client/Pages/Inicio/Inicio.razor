    // 8. MAPA (interop con mapa-colombia.js)
    // ════════════════════════════════════════════════
    private async Task InicializarMapaAsync()
    {
        if (mapaInicializado) return;

        try
        {
            referenciaDotNet ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("TurismoConectaMapa.inicializar", ConvertirParaMapa(todosMunicipios), referenciaDotNet);
            await JS.InvokeVoidAsync("TurismoConectaMapa.activarScroll");
            mapaInicializado = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Inicio] Error al inicializar mapa: {ex.Message}");
        }
    }

    private async Task ActualizarMapaConFiltro(List<MunicipioListadoDto> lista)
    {
        try
        {
            await JS.InvokeVoidAsync("TurismoConectaMapa.actualizarMarcadores", ConvertirParaMapa(lista));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Inicio] Error actualizando marcadores: {ex.Message}");
        }
    }

    private async Task EnfocarEnMapa(MunicipioListadoDto municipio, string? subtitulo, bool desplazar)
    {
        if (!municipio.Latitud.HasValue || !municipio.Longitud.HasValue)
        {
            mensajeBusqueda = $"{municipio.Nombre} todavía no tiene ubicación registrada en el mapa.";
            return;
        }

        var datos = new
        {
            id = municipio.IdMunicipio,
            nombre = municipio.Nombre,
            latitud = municipio.Latitud.Value,
            longitud = municipio.Longitud.Value,
            subtitulo
        };

        try
        {
            await JS.InvokeVoidAsync("TurismoConectaMapa.enfocarMunicipio", datos, desplazar);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Inicio] Error enfocando el mapa: {ex.Message}");
        }
    }

    private static List<object> ConvertirParaMapa(IEnumerable<MunicipioListadoDto> lista) =>
        lista
            .Where(m => m.Latitud.HasValue && m.Longitud.HasValue)
            .Select(m => (object)new
            {
                id = m.IdMunicipio,
                nombre = m.Nombre,
                latitud = m.Latitud!.Value,
                longitud = m.Longitud!.Value
            })
            .ToList();

