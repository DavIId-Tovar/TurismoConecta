@page "/mis-establecimientos"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NegocioApiService NegocioService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="Pages/Establecimientos/MisEstablecimientos.razor.css" />
</HeadContent>

<AuthorizeView Roles="@Roles.GeneralOEstablecimiento">
    <Authorized Context="authContext">
        <div class="panel-comercio-wrap">
            <header class="panel-topbar">
                <div class="topbar-container">
                    <button class="btn-volver-inicio" @onclick="Volver">
                        ← Volver al Panel
                    </button>
                    <div class="topbar-brand-center">
                        <a href="/admin/dashboard" class="logo-marco-dorado" title="TurismoConecta">
                            <img src="images/turismo-conecta-logo.png" alt="TurismoConecta" class="topbar-logo-img" />
                        </a>
                    </div>
                    <div class="badge-admin-info">
                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(authContext.User.Identity?.Name ?? "Comerciante")&background=213b31&color=fff&size=80" alt="Foto" class="admin-avatar-topbar"
                             onerror="this.onerror=null;this.style.display='none';" />
                        <span class="admin-label-prefijo">Administrador:</span>
                        <span class="admin-nombre-valor">@(authContext.User.Identity?.Name ?? "Comerciante")</span>
                        <span class="admin-rol-tag">@(authContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? authContext.User.FindFirst("role")?.Value ?? "Admin")</span>
                    </div>
                </div>
            </header>

            <main class="panel-cuerpo">
                <div class="panel-header-editorial">
                    <div class="header-titles">
                        <span class="eyebrow">Gestión Comercial</span>
                        <h1 class="titulo-editorial">Mis Establecimientos</h1>
                        <p class="bajada">Administra tus hospedajes, restaurantes y experiencias registradas en los pueblos de Boyacá.</p>
                    </div>
                    <div class="header-actions">
                        <button class="btn-crear-nuevo" @onclick='() => Nav.NavigateTo("/establecimientos/crear")'>
                            + Registrar Nuevo Establecimiento
                        </button>
                    </div>
                </div>

                @if (cargando)
                {
                    <div class="estado-cargando">
                        <div class="spinner-editorial"></div>
                        <p>Cargando tus establecimientos...</p>
                    </div>
                }
                else if (!misNegocios.Any())
                {
                    <div class="caja-vacia-editorial">
                        <div class="icono-vacio">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: #2d6a4f; margin-bottom: 12px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        </div>
                        <h3>Aún no tienes establecimientos registrados</h3>
                        <p>Da a conocer tu negocio a miles de turistas registrando tu primer establecimiento en minutos.</p>
                        <button class="btn-crear-nuevo" @onclick='() => Nav.NavigateTo("/establecimientos/crear")'>
                            Crear mi primer negocio
                        </button>
                    </div>
                }
                else
                {
                    <!-- Resumen rápido de estados -->
                    <div class="stats-strip">
                        <div class="stat-card">
                            <span class="stat-num">@misNegocios.Count</span>
                            <span class="stat-lbl">Total Registrados</span>
                        </div>
                        <div class="stat-card verde">
                            <span class="stat-num">@misNegocios.Count(n => n.Estado == EstadosNegocio.Aprobado)</span>
                            <span class="stat-lbl">Activos y Visibles</span>
                        </div>
                        <div class="stat-card ambar">
                            <span class="stat-num">@misNegocios.Count(n => n.Estado == EstadosNegocio.Pendiente)</span>
                            <span class="stat-lbl">En Revisión</span>
                        </div>
                        <div class="stat-card rojo">
                            <span class="stat-num">@misNegocios.Count(n => n.Estado == EstadosNegocio.Rechazado)</span>
                            <span class="stat-lbl">Rechazados</span>
                        </div>
                    </div>

                    <!-- Cuadrícula de negocios -->
                    <div class="grid-negocios">
                        @foreach (var n in misNegocios)
                        {
                            <article class="card-negocio-item">
                                <div class="card-foto-wrap">
                                    <img src="@n.Portada" alt="@n.Nombre" class="card-foto" />
                                    <span class="badge-estado @n.Estado.ToLower()">@n.Estado</span>
                                    <span class="badge-cat">@n.NombreCategoria</span>
                                </div>

                                <div class="card-info">
                                    <h3 class="card-nombre">@n.Nombre</h3>
                                    <p class="card-dir">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                        @(string.IsNullOrWhiteSpace(n.Direccion) ? "Dirección no especificada" : n.Direccion)
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(n.Horario))
                                    {
                                        <p class="card-meta">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                            @n.Horario
                                        </p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(n.Telefono))
                                    {
                                        <p class="card-meta">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                            @n.Telefono
                                        </p>
                                    }

                                    @if (n.Estado == EstadosNegocio.Pendiente)
                                    {
                                        <div class="alerta-estado-info">
                                            Tu solicitud está en proceso de verificación por la alcaldía municipal.
                                        </div>
                                    }
                                </div>

                                <div class="card-acciones">
                                    <button class="btn-accion-secundario" @onclick='() => Nav.NavigateTo($"/establecimientos/editar/{n.IdNegocio}")'>
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: -1px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        Editar Datos
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <AccesoRestringido>
            Debes iniciar sesión con una cuenta de <strong>Comerciante</strong> para acceder a este panel.
        </AccesoRestringido>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool cargando = true;
    private List<NegocioItemDto> misNegocios = new();

    protected override async Task OnInitializedAsync()
    {
        misNegocios = await NegocioService.ListarMisNegociosAsync();
        cargando = false;
    }

    private async Task Volver()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.IsInRole(Roles.AdminGeneral))
            Nav.NavigateTo("/admin/dashboard");
        else
            Nav.NavigateTo("/comercio/dashboard");
    }
}
