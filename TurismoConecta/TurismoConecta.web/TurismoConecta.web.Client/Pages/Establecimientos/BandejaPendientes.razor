@page "/establecimientos/pendientes"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject NegocioApiService NegocioService
@inject NotificacionTiempoRealService Notif
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<AuthorizeView Roles="@Roles.GeneralOMunicipio">
    <Authorized Context="authContext">
        <div class="panel-comercio-wrap">
            <header class="panel-topbar">
                <div class="topbar-container">
                    @* ◆ CAMBIO: flecha de texto → ícono Phosphor *@
                    <button class="btn-volver-inicio" @onclick="VolverDashboard">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i> Volver al Dashboard
                    </button>
                    <div class="topbar-brand-center">
                        <a href="/admin/dashboard" class="logo-marco-dorado" title="TurismoConecta">
                            <img src="images/turismo-conecta-logo.png" alt="TurismoConecta" class="topbar-logo-img" />
                        </a>
                    </div>
                    <div class="topbar-derecha">
                        <CampanaNotificaciones />
                        <div class="badge-admin-info">
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(authContext.User.Identity?.Name ?? "Gestor")&background=213b31&color=fff&size=80" alt="Foto" class="admin-avatar-topbar"
                                 onerror="this.onerror=null;this.style.display='none';" />
                            <span class="admin-label-prefijo">Administrador:</span>
                            <span class="admin-nombre-valor">@(authContext.User.Identity?.Name ?? "Gestor")</span>
                            <span class="admin-rol-tag">@(authContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? authContext.User.FindFirst("role")?.Value ?? "Admin")</span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="panel-cuerpo">
                <div class="panel-header-editorial">
                    <div>
                        <span class="eyebrow">Validación de Establecimientos</span>
                        <h1 class="titulo-editorial">Bandeja de Pendientes</h1>
                        <p class="bajada">Revisa y autoriza la publicación de negocios locales en tu municipio.</p>
                    </div>
                </div>

                @if (cargando)
                {
                    <p>Cargando solicitudes...</p>
                }
                else if (!pendientes.Any())
                {
                    <div class="caja-vacia-editorial">
                        <div class="icono-vacio">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #2d6a4f; margin-bottom: 12px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                        </div>
                        <h3>Al día. No hay solicitudes pendientes</h3>
                        <p>Todos los negocios registrados en tu municipio han sido revisados.</p>
                    </div>
                }
                else
                {
                    <!-- Aviso general -->
                    <div class="resumen-pendientes">
                        @* ◆ CAMBIO: ⚠ → ícono Phosphor *@
                        <i class="ph-fill ph-warning" aria-hidden="true"></i>
                        <strong>@pendientes.Count</strong> establecimiento@(pendientes.Count == 1 ? "" : "s") por aprobar
                        en <strong>@grupos.Count</strong> municipio@(grupos.Count == 1 ? "" : "s")
                    </div>

                    <!-- Una tarjeta por municipio -->
                    <div class="grid-municipios">
                        @foreach (var grupo in grupos)
                        {
                            var estaAbierto = municipioAbierto == grupo.Key;
                            <button type="button"
                                    class="tarjeta-municipio @(estaAbierto ? "abierta" : "")"
                                    @onclick="() => AlternarMunicipio(grupo.Key)">
                                @* ◆ CAMBIO: 📍 y ▲/▼ → íconos Phosphor *@
                                <span class="tarjeta-nombre"><i class="ph-fill ph-map-pin" aria-hidden="true"></i> @grupo.Key</span>
                                <span class="tarjeta-contador">@grupo.Count() por aprobar</span>
                                <span class="tarjeta-flecha"><i class="ph @(estaAbierto ? "ph-caret-up" : "ph-caret-down")" aria-hidden="true"></i></span>
                            </button>
                        }
                    </div>

                    <!-- Lista del municipio seleccionado -->
                    @if (municipioAbierto is not null)
                    {
                        var listaMunicipio = grupos.First(g => g.Key == municipioAbierto).ToList();

                        <h2 class="titulo-grupo">Pendientes en @municipioAbierto</h2>

                        <div style="background:#fff; border-radius:12px; border:1px solid #e0ebe3; overflow:hidden;">
                            <table style="width:100%; border-collapse:collapse; text-align:left;">
                                <thead style="background:#f4f7f5; border-bottom:1px solid #d8e5dc;">
                                    <tr>
                                        <th style="padding:1rem;">Establecimiento</th>
                                        <th style="padding:1rem;">Categoría</th>
                                        <th style="padding:1rem;">Propietario</th>
                                        <th style="padding:1rem;">Fecha Envío</th>
                                        <th style="padding:1rem; text-align:right;">Decisión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in listaMunicipio)
                                    {
                                        <tr style="border-bottom:1px solid #edf3ef;">
                                            <td style="padding:1rem; font-weight:600;">@p.Nombre</td>
                                            <td style="padding:1rem;"><span class="badge-cat" style="position:static; background:#e8f5e9; color:#1b4332;">@p.NombreCategoria</span></td>
                                            <td style="padding:1rem; color:#555;">@p.NombrePropietario</td>
                                            <td style="padding:1rem; color:#777; font-size:0.85rem;">@(p.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                            <td style="padding:1rem; text-align:right;">
                                                @* ◆ CAMBIO: ✓ y ✕ → íconos Phosphor (la lógica es la misma) *@
                                                <button style="background:#2d6a4f; color:#fff; border:none; padding:0.45rem 0.9rem; border-radius:6px; cursor:pointer; font-weight:600; margin-right:0.5rem;"
                                                        @onclick='() => ResolverEstado(p.IdNegocio, "Aprobado")'>
                                                    <i class="ph ph-check" aria-hidden="true"></i> Aprobar
                                                </button>
                                                <button style="background:#dc2626; color:#fff; border:none; padding:0.45rem 0.9rem; border-radius:6px; cursor:pointer; font-weight:600;"
                                                        @onclick='() => ResolverEstado(p.IdNegocio, "Rechazado")'>
                                                    <i class="ph ph-x" aria-hidden="true"></i> Rechazar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="ayuda-grupo">Selecciona un municipio para revisar sus solicitudes.</p>
                    }
                }
            </main>
        </div>
    </Authorized>
</AuthorizeView>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="floating-toast-clean @(esError ? "toast-error" : "toast-success")">
        <div class="toast-indicator"></div>
        <div class="toast-content">
            <div class="toast-header-flex">
                @* ◆ CAMBIO: si viene un título, se usa también en los errores *@
                <span class="toast-title">@(tituloAlerta ?? (esError ? "Aviso del Sistema" : "Operación Exitosa"))</span>
                @* ◆ CAMBIO: ✕ de texto → ícono Phosphor + aria-label *@
                <button type="button" class="btn-cerrar-toast" aria-label="Cerrar aviso" @onclick="CerrarAlerta">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>
            <p class="toast-desc">@mensajeAlerta</p>
        </div>
    </div>
}

@code {
    private List<NegocioPendienteAprobacionDto> pendientes = new();
    // Pendientes agrupados: cada grupo = un municipio con sus negocios
    private List<IGrouping<string, NegocioPendienteAprobacionDto>> grupos = new();

    // Nombre del municipio cuya tarjeta está desplegada (null = ninguna)
    private string? municipioAbierto;
    private bool cargando = true;
    private string? mensajeAlerta;
    private string? tituloAlerta;
    private bool esError = false;
    private CancellationTokenSource? _toastCts;

    protected override async Task OnInitializedAsync()
    {
        // ◆ CAMBIO: escuchar las notificaciones en tiempo real (SignalR)
        Notif.NotificacionRecibida += AlRecibirNotificacion;

        await CargarPendientes();
    }

    // ◆ NUEVO: se ejecuta cada vez que el hub envía "NuevaNotificacion" a este usuario
    private void AlRecibirNotificacion(NotificacionDto notificacion)
    {
        // Solo reaccionamos a "llegó un negocio nuevo por revisar"
        if (notificacion.Codigo != CodigosNotificacion.NegocioPendiente) return;

        // SignalR llama desde fuera del ciclo de Blazor → InvokeAsync para volver a él
        _ = InvokeAsync(async () =>
        {
            await CargarPendientes();
            MostrarToast(notificacion.Mensaje, error: false, titulo: "Nueva solicitud");
        });
    }

    private async Task CargarPendientes()
    {
        cargando = true;
        pendientes = await NegocioService.ListarPendientesAsync();

        // Agrupar por municipio; primero el que tiene más pendientes
        grupos = pendientes
            .GroupBy(p => p.NombreMunicipio)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .ToList();

        // Si el municipio abierto ya no tiene pendientes (se aprobó el último), se cierra
        if (municipioAbierto is not null && grupos.All(g => g.Key != municipioAbierto))
            municipioAbierto = null;

        // Si solo hay un municipio (caso AdminMunicipio), se abre directamente
        if (grupos.Count == 1)
            municipioAbierto = grupos[0].Key;

        cargando = false;
    }

    private void AlternarMunicipio(string nombreMunicipio) =>
        municipioAbierto = municipioAbierto == nombreMunicipio ? null : nombreMunicipio;

    private async Task ResolverEstado(int idNegocio, string nuevoEstado)
    {
        var (exito, error) = await NegocioService.CambiarEstadoAsync(idNegocio, nuevoEstado);
        if (exito)
        {
            var accion = nuevoEstado == "Aprobado" ? "aprobado para publicación" : "rechazado";
            MostrarToast($"El establecimiento ha sido {accion} exitosamente.", error: false, titulo: nuevoEstado == "Aprobado" ? "Establecimiento Aprobado" : "Solicitud Rechazada");
            await CargarPendientes();
        }
        else
        {
            MostrarToast(error ?? "No se pudo procesar la solicitud.", error: true, titulo: "Error al Procesar");
        }
    }

    private void MostrarToast(string mensaje, bool error = false, string? titulo = null)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();

        mensajeAlerta = mensaje;
        esError = error;
        tituloAlerta = titulo;
        StateHasChanged();

        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        mensajeAlerta = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private void CerrarAlerta()
    {
        _toastCts?.Cancel();
        mensajeAlerta = null;
    }

    private async Task VolverDashboard()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.IsInRole(Roles.AdminGeneral))
            Nav.NavigateTo("/admin/dashboard");
        else
            Nav.NavigateTo("/municipio/dashboard");
    }

    // ◆ NUEVO: obligatorio por @implements IDisposable.
    // Blazor lo llama al salir de la página: si no te desuscribes, el servicio (Scoped, vive toda la sesión)
    // seguiría llamando a esta página "muerta" y recargaría pendientes en segundo plano.
    public void Dispose()
    {
        Notif.NotificacionRecibida -= AlRecibirNotificacion;
        _toastCts?.Cancel();
    }
}
